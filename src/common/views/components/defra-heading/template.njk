{# The same banner the case working frontend heads its pages with, so an
   officer crossing between the two services meets one masthead. #}
<header class="defra-header">
  <div class="defra-header__inner">
    <a href="/" class="defra-header__logo-link" title="Go to the homepage" data-testid="defra-heading-logo">
      <img src="{{ params.logoSrc }}" alt="" >
      <span class="defra-header__service-name" data-testid="defra-heading-service-name">{{ params.serviceName }}</span>
    </a>
  </div>
</header>
