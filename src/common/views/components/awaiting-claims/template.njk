<h2 class="govuk-heading-l" data-testid="awaiting-claims-heading">Awaiting a claim</h2>

{% if params.awaitingClaims | length %}
  <p class="govuk-body" data-testid="awaiting-claims-subtext">
    The applicant has not made a claim against these items yet.
  </p>

  <table class="govuk-table" data-testid="awaiting-claims">
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th scope="col" class="govuk-table__header">Claimable item</th>
        <th scope="col" class="govuk-table__header">Amount</th>
      </tr>
    </thead>
    <tbody class="govuk-table__body">
      {% for claim in params.awaitingClaims %}
        <tr class="govuk-table__row" data-testid="awaiting-claim">
          <td class="govuk-table__cell">
            <span data-testid="awaiting-claim-description">{{ claim.description }}</span><br>
            <span class="govuk-hint govuk-!-margin-bottom-0" data-testid="awaiting-claim-code">{{ claim.claimCode }}</span>
          </td>
          <td class="govuk-table__cell" data-testid="awaiting-claim-amount">{{ claim.amount }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <p class="govuk-body" data-testid="no-awaiting-claims">Nothing currently claimable</p>
{% endif %}
