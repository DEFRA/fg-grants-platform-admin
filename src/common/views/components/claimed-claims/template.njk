<h2 class="govuk-heading-l" data-testid="claimed-claims-heading">Claimed</h2>

{% if params.claimed | length %}
  <table class="govuk-table" data-testid="claimed-claims">
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th scope="col" class="govuk-table__header">Claim type</th>
        <th scope="col" class="govuk-table__header">Quantity</th>
        <th scope="col" class="govuk-table__header">Claim value</th>
        <th scope="col" class="govuk-table__header">Requires approval</th>
        <th scope="col" class="govuk-table__header">Approval status</th>
        <th scope="col" class="govuk-table__header">Payment status</th>
      </tr>
    </thead>
    <tbody class="govuk-table__body">
      {% for claim in params.claimed %}
        <tr class="govuk-table__row" data-testid="claimed-claim">
          <td class="govuk-table__cell">
            <span data-testid="claimed-claim-name">{{ claim.name }}</span><br>
            <span class="govuk-hint govuk-!-margin-bottom-0" data-testid="claimed-claim-reference">{{ claim.clientClaimRef }}</span>
          </td>
          <td class="govuk-table__cell" data-testid="claimed-claim-quantity">{{ claim.quantity }}</td>
          <td class="govuk-table__cell" data-testid="claimed-claim-value">{{ claim.value }}</td>
          <td class="govuk-table__cell" data-testid="claimed-claim-requires-approval">{{ claim.requiresApproval }}</td>
          <td class="govuk-table__cell" data-testid="claimed-claim-approval-status">{{ claim.approvalStatus }}</td>
          <td class="govuk-table__cell" data-testid="claimed-claim-payment-status">{{ claim.paymentStatus }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% else %}
  <p class="govuk-body" data-testid="no-claimed-claims">No items claimed</p>
{% endif %}
