{% extends 'layouts/page.njk' %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: code + " / " + clientRef
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h2 class="govuk-heading-m">{{ claimableTemplate.name }}</h2>

      {% if claimableTemplate.description %}
        <p class="govuk-body" data-testid="claimable-template-description">
          {{ claimableTemplate.description }}
        </p>
      {% endif %}

      <form method="post" novalidate>
        {% for key, field in claimableTemplate.fields %}
          {% if field.input %}
            {% set unitType = field.unitType | lower %}
            {% if unitType === "decimal" %}
              {% set inputmode = "decimal" %}
            {% elif unitType === "integer" %}
              {% set inputmode = "numeric" %}
            {% else %}
              {% set inputmode = none %}
            {% endif %}

            {{ govukInput({
              id: key,
              name: key,
              label: { text: field.label },
              classes: "govuk-input--width-10",
              inputmode: inputmode,
              spellcheck: false if inputmode else none,
              suffix: { text: field.unit | lower } if field.unit else none,
              attributes: { "data-testid": "claimable-field-" + key }
            }) }}
          {% endif %}
        {% endfor %}

        {{ govukButton({
          text: "Continue",
          attributes: { "data-testid": "claimable-submit" }
        }) }}
      </form>

    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      <h2 class="govuk-heading-m">Available entitlements</h2>

      {% if availableEntitlements | length %}
        {% for entitlement in availableEntitlements %}
          <h3 class="govuk-heading-s" data-testid="available-entitlement-claim-code">{{ entitlement.claimCode }}</h3>
          <pre class="govuk-body app-json" data-testid="available-entitlement"><code>{{ entitlement | dump(2) }}</code></pre>
        {% endfor %}
      {% else %}
        <p class="govuk-body" data-testid="no-available-entitlements">
          No entitlements are available for this application.
        </p>
      {% endif %}

      <h2 class="govuk-heading-m">Claimable entitlements</h2>
      <pre class="govuk-body app-json" data-testid="claimable-entitlements"><code>{{ claimableEntitlements | dump(2) }}</code></pre>

      <h2 class="govuk-heading-m">Claims</h2>
      <pre class="govuk-body app-json" data-testid="claims"><code>{{ claims | dump(2) }}</code></pre>

    </div>
  </div>
{% endblock %}
