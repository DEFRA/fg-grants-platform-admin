{% from "theme-toggle/macro.njk" import themeToggle %}

<!DOCTYPE html>
{# `htmlAttributes`, for a page that sticks its top: the events list pads
   the document's focus scrolling past what it pins. #}
<html lang="en"{% if devOpsTheme %} data-theme="{{ devOpsTheme }}"{% endif %}{% block htmlAttributes %}{% endblock %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block pageTitle %}{{ pageTitle }} | {{ serviceName }}{% endblock %}</title>
    {# The service favicon, shared with the GDS side: one service, one tab
       icon, whichever app the page belongs to. #}
    <link rel="icon" sizes="48x48" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/favicon.ico") }}">
    <link rel="icon" sizes="any" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/favicon.svg") }}" type="image/svg+xml">
    <link href="{{ getAssetPath('src/dev-ops/client/dev-ops.css') }}" rel="stylesheet">
  </head>
  {# One column: the bar, then everything else. Every page scrolls the
     document; one whose table should stay readable under its filters pins
     its own top instead (see sticky-top), and the bar with it. #}
  <body class="flex min-h-dvh flex-col bg-base-200">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 btn btn-primary">Skip to main content</a>
    {% block header %}
      {# The product, then the app: `serviceName` is the deployable's kebab-case
         repo name, which names nothing an operator recognises. It still titles
         the tab, where the repo name is the useful one.

         daisyUI's own bar: `navbar-start` holds who and where, `navbar-end`
         holds the theme switch. Drawn at md, the size of every control under
         it: tall enough to seat a md control, and a brand that still sits a
         step under each page's own `h1`. #}
      {# `navbarClass`, for a page that sticks its top: the bar sticks too,
         above it. #}
      <header class="navbar min-h-14 border-b border-base-300 bg-base-100 px-4{% block navbarClass %}{% endblock %}">
        <div class="navbar-start gap-2">
          <a class="text-lg font-bold" href="/dev-ops" data-testid="do-brand">Grants Platform</a>
          <span class="text-base text-base-content/70" data-testid="do-brand-suffix">· Dev Ops</span>
          {# Which deployment this is, said once, beside the name of the app.
             Every dev-ops page looks identical in every environment, and the
             one action on them now writes to a queue: an operator with four
             tabs open has to be able to tell from the tab itself which service
             they are about to redrive an event in.

             Amber only where it is an incident to be wrong — production reads
             as a warning, everywhere else is a neutral label rather than a
             colour that would train the eye to ignore it. #}
          {% if environmentLabel %}
            {% if environmentIsProduction %}
              <span class="badge badge-warning badge-outline" title="This is the {{ environmentLabel }} environment" data-testid="do-environment">{{ environmentLabel }}</span>
            {% else %}
              <span class="badge badge-ghost" title="This is the {{ environmentLabel }} environment" data-testid="do-environment">{{ environmentLabel }}</span>
            {% endif %}
          {% endif %}
        </div>
        <div class="navbar-end gap-1">
          {{ themeToggle({ theme: devOpsTheme }) }}
        </div>
      </header>
    {% endblock %}
    {# Wide enough for the events table's own minimum, which is the widest
       thing this app draws. `flex-1 flex-col` so a page can hand the height
       left under its content to its last box — the events card with nothing
       in it still reaches the bottom of the window. #}
    <main id="main-content" class="mx-auto flex w-full max-w-[90rem] min-h-0 flex-1 flex-col px-6 py-5">
      {% block content %}{% endblock %}
    </main>
    <script type="module" src="{{ getAssetPath('src/dev-ops/views/components/index.ts') }}"></script>
  </body>
</html>
