{% import "design-system/macros.njk" as au %}
{#- Every Dev Ops page: the app shell, with the sidebar and account menu where there is someone to show. -#}
<!DOCTYPE html>
<html lang="en"{% if devOpsTheme %} data-theme="{{ devOpsTheme }}"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block pageTitle %}{{ pageTitle }} – {{ productName }}{% endblock %}</title>
    <link rel="icon" sizes="48x48" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/favicon.ico") }}">
    <link rel="icon" sizes="any" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/favicon.svg") }}" type="image/svg+xml">
    <link rel="preload" href="{{ getAssetPath('src/dev-ops/views/components/fonts/InterVariable.woff2') }}" as="font" type="font/woff2" crossorigin>
    {#- A page not yet rebuilt on the design system keeps its old stylesheet and elements; a rebuilt one empties this block.
        The old stylesheet comes first, so its cascade layers are declared before the design system's `au` and never win over it. -#}
    {% block oldPage %}
    <link href="{{ getAssetPath('src/dev-ops/client/dev-ops.css') }}" rel="stylesheet">
    <script type="module" src="{{ getAssetPath('src/dev-ops/views/legacy/index.ts') }}"></script>
    {% endblock %}
    <link href="{{ getAssetPath('src/dev-ops/views/components/design-system.css') }}" rel="stylesheet">
    <script type="module" src="{{ getAssetPath('src/dev-ops/views/components/index.ts') }}"></script>
  </head>
  <body>
    {%- set offersTimes = shellNav != 'none' and not emptySidebar -%}
    {%- call au.AppShell({
      nav: shellNav,
      product: productName,
      productHref: homeHref,
      productTestId: 'shell-brand',
      env: environmentLabel,
      envTitle: 'This is the ' ~ environmentLabel ~ ' environment',
      envTestId: 'shell-environment',
      sections: [] if emptySidebar else sidebarSections(navSections, navActive),
      navLabel: 'Dev Ops',
      navTestId: 'shell-nav',
      footTestId: 'shell-sidebar-foot',
      sidebarTestId: 'shell-sidebar',
      userName: signedInUser.name if signedInUser,
      userEmail: signedInUser.email if signedInUser and signedInUser.email != signedInUser.name,
      accountItems: [{ text: 'Times', href: timesDialog.href, icon: 'clock', meta: times.label, testId: 'times-item', attributes: { 'data-au-open': 'times-dialog' } }] if offersTimes else [],
      signOutHref: signOutHref,
      theme: devOpsTheme,
      themeCookie: themeCookieName
    }) -%}
      {% block content %}{% endblock %}
    {%- endcall -%}
    {% if offersTimes %}{% include "times-dialog.njk" %}{% endif %}
  </body>
</html>
