{% from "code-text/macro.njk" import codeText %}
{% from "inline-badge/macro.njk" import inlineBadge %}
{% from "muted/macro.njk" import muted %}

{%- set testId = params.testId -%}
{%- set actions = params.actions -%}
<section class="card card-border mt-4 bg-base-100 first:mt-0" aria-label="Actions" data-testid="{{ testId }}">
  {% if actions.rows | length %}
    <div class="card-body gap-3 p-5">
      <div class="w-full overflow-x-auto">
        <table class="table w-full min-w-[40rem]" data-testid="{{ testId }}-table">
          <colgroup><col class="w-[28%]"><col class="w-px"><col></colgroup>
          <thead>
            <tr><th scope="col">Name</th><th scope="col">Method</th><th scope="col">URL</th></tr>
          </thead>
          <tbody>
            {% for action in actions.rows %}
              <tr class="hover:bg-base-200" data-testid="grant-action">
                <td class="align-top"><span class="text-sm" data-testid="{{ testId }}-name">{{ codeText(action.name) }}</span></td>
                <td class="align-top">{{ inlineBadge({ text: action.method, testId: testId ~ "-method" }) }}</td>
                <td class="align-top"><span class="text-sm" data-testid="{{ testId }}-url">{{ codeText(action.url) }}</span></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% if actions.usesEnvironment %}
        <p class="text-sm {{ muted }}" data-testid="{{ testId }}-environment">When GAS calls an action, it replaces {{ codeText("%ENVIRONMENT%") }} with its environment name.</p>
      {% endif %}
    </div>
  {% else %}
    <p class="px-4 py-10 text-center text-sm {{ muted }}" data-testid="{{ testId }}-empty">No actions in this version.</p>
  {% endif %}
</section>
