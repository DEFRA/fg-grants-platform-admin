{% from "muted/macro.njk" import muted %}

{%- set testId = params.testId -%}
{%- set draw = caller -%}
<div data-testid="{{ testId }}">
  <ul class="divide-y divide-base-300 sm:hidden" data-testid="{{ testId }}-blocks">
    {% for row in params.rows %}
      <li class="py-2 text-sm" data-testid="{{ testId }}-block">
        <div class="font-medium">{{ draw(row, 0) }}</div>
        {% for column in params.columns %}
          {% if not loop.first %}
            <div class="mt-1"><span class="{{ muted }}">{{ column.label }}</span> <span class="{{ muted }}" aria-hidden="true">·</span> {{ draw(row, loop.index0) }}</div>
          {% endif %}
        {% endfor %}
      </li>
    {% endfor %}
  </ul>
  <div class="hidden w-full overflow-x-auto sm:block">
    <table class="table w-full table-fixed{% if params.tableClass %} {{ params.tableClass }}{% endif %}" data-testid="{{ testId }}-table">
      <colgroup>{% for column in params.columns %}<col{% if column.width %} class="{{ column.width }}"{% endif %}>{% endfor %}</colgroup>
      <thead>
        <tr>{% for column in params.columns %}<th scope="col">{{ column.label }}</th>{% endfor %}</tr>
      </thead>
      <tbody>
        {% for row in params.rows %}
          <tr class="hover:bg-base-200 align-top" data-testid="{{ testId }}-row">{% for column in params.columns %}<td>{{ draw(row, loop.index0) }}</td>{% endfor %}</tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
