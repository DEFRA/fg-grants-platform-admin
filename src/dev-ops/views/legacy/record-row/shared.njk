
{# Tailwind only sees class names written literally in this file. #}
{% set rowLink = "block w-fit break-all font-mono text-sm font-semibold no-underline after:absolute after:inset-0 focus-visible:outline-none" %}
{% set itemClass = "list-row relative hover:bg-base-200 has-[:focus-visible]:bg-base-200" %}

{# The whole row is the ref's link; the page's own record is no link, so its row takes no hover either. #}
{% macro ref(row, prefix, code) %}
  {%- if row.href -%}
    <a href="{{ row.href }}" class="{{ rowLink }}" data-testid="{{ prefix }}-link">{{ row.ref }}<span class="sr-only">{% if code %}, {{ row.code }}{% endif %}{% if row.replaced %}, replaced{% endif %}</span></a>
  {%- else -%}
    <span class="block w-fit break-all font-mono text-sm font-semibold" aria-current="page" data-testid="{{ prefix }}-current">{{ row.ref }}{% if row.replaced %}<span class="sr-only">, replaced</span>{% endif %}</span>
  {%- endif -%}
{% endmacro %}

{% macro replaced(row, testId) %}
  {%- if row.replaced %}<span class="badge badge-ghost badge-sm" aria-hidden="true"{% if testId %} data-testid="{{ testId }}"{% endif %}>replaced</span>{% endif -%}
{% endmacro %}
