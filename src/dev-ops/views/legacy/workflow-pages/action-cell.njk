{% from "code-text/macro.njk" import codeText %}
{% from "service-address/macro.njk" import serviceAddress %}
{% from "status-badge/macro.njk" import statusBadge %}

{# One external action by name, linked to its Integrations card, with what CW calls for it. #}
{% macro actionCell(call, testId, environment) %}
<div class="mb-1.5" data-testid="{{ testId }}">
  {%- if call.kind == "not-defined" -%}
    {{ codeText(call.code, "text-sm") }} {{ statusBadge({ status: "Not defined", role: "warning" }) }}
  {%- else -%}
    <a class="link" href="{{ call.href }}">{{ call.action.name }}</a>
    <div class="mt-0.5">
      {%- if call.kind == "no-endpoint" -%}
        {{ statusBadge({ status: "No endpoint", role: "warning" }) }}
      {%- else -%}
        {{ serviceAddress({ method: call.endpoint.method, path: call.endpoint.path, url: call.address.url, service: call.address.service, source: "CW", unset: false, environment: environment, testId: testId ~ "-address" }) }}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
{% endmacro %}
