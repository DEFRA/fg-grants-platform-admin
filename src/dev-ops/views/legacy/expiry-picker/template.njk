{# Tailwind only sees class names written literally in this file. #}
{%- set picker = params.picker -%}
{%- set id = picker.id -%}
<do-expiry-picker class="group block" data-current="{{ picker.current }}" data-testid="{{ id }}">
  <fieldset class="flex flex-col gap-2" aria-describedby="{{ id }}-summary{% if picker.error %} {{ id }}-error{% endif %}">
    <legend class="{{ 'sr-only' if params.legendHidden else 'mb-2 text-sm font-semibold' }}">{{ params.legend | default("Expires") }}</legend>
    <div class="flex flex-wrap gap-2">
      {% for choice in picker.choices %}
        <label class="inline-flex h-9 cursor-pointer items-center rounded-lg border border-base-content/12 bg-base-100 px-3 text-[13px] text-base-content/85 hover:bg-base-200 has-checked:border-neutral has-checked:bg-neutral has-checked:text-neutral-content has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-[#2563eb]" data-testid="{{ id }}-{{ choice.value }}-label">
          <input class="sr-only" type="radio" name="expiry" value="{{ choice.value }}"{% if choice.checked %} checked{% endif %}{% if choice.value == picker.resetTo %} data-reset-checked{% endif %} data-testid="{{ id }}-{{ choice.value }}">{{ choice.label }}
        </label>
      {% endfor %}
    </div>
    <div class="hidden flex-col gap-1.5 group-has-[[value=custom]:checked]:flex" data-testid="{{ id }}-custom-date">
      <label class="text-[13px] text-base-content/75" for="{{ id }}-date">Expiry date (end of day)</label>
      <input class="h-[38px] w-full max-w-[220px] rounded-lg border border-base-content/20 bg-base-100 px-3 text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2563eb]" type="date" id="{{ id }}-date" name="date" value="{{ picker.date }}" data-reset-value="{{ picker.resetDate }}" min="{{ picker.min }}" autocomplete="off" data-1p-ignore data-lpignore="true" data-bwignore{% if picker.error %} aria-invalid="true" aria-describedby="{{ id }}-error"{% endif %} data-testid="{{ id }}-date">
    </div>
    {% if picker.error %}<p class="text-[13px] text-[#b91c1c] [[data-theme=dark]_&]:text-[#f87171] [@media(prefers-color-scheme:dark)]:[:root:not([data-theme])_&]:text-[#f87171]" id="{{ id }}-error" data-reset-remove data-expiry-error data-testid="{{ id }}-error">{{ picker.error }}</p>{% endif %}
    <p class="text-[13px] text-base-content/75" id="{{ id }}-summary" aria-live="polite" data-expiry-summary data-testid="{{ id }}-summary">{{ picker.summary }}</p>
  </fieldset>
</do-expiry-picker>
