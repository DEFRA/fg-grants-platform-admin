{% from "code-text/macro.njk" import codeText %}
{% from "muted/macro.njk" import muted %}
{% from "no-value/macro.njk" import noValue %}

{# Tailwind only sees class names written literally in this file. #}
{# Label beside value at every width; a long label wraps in its column. #}
{% set factList = "grid grid-cols-[minmax(6rem,8rem)_minmax(0,1fr)] content-start gap-x-4 gap-y-3 sm:gap-x-6" %}

{# One label and value of a fact list; the caller draws the value. #}
{% macro fact(label, id) %}
  <div class="contents" data-testid="{{ id }}">
    <dt class="text-sm font-medium {{ muted }}">{{ label }}</dt>
    <dd class="min-w-0">{{ caller() }}</dd>
  </div>
{% endmacro %}

{# Codes in mono, comma-separated; each a string, or `{ code, title }` with what it reads as. #}
{% macro codes(list) %}
  {%- for item in list -%}
    {%- if not loop.first %}<span class="text-base-content/40">, </span>{% endif -%}
    <span class="text-sm"{% if item.title %} title="{{ item.title }}"{% endif %}>{{ codeText(item.code if item.code else item) }}</span>
  {%- else -%}
    {{ noValue({}) }}
  {%- endfor -%}
{% endmacro %}

{# The facts as a card. A fact of a kind the card doesn't draw goes to the caller: `caller(fact)`. #}
{% macro factsCard(params) %}
    {%- include "./template.njk" -%}
{% endmacro %}
