{% from "code-text/macro.njk" import codeText %}
{% from "muted/macro.njk" import muted %}
{% from "no-value/macro.njk" import noValue %}

{#- Tailwind only sees class names written literally in this file. -#}
{#- A null `url` is no usable URL: unset or unparseable. Only `unset: true` (the service is in GAS's `missingServiceUrls`) says which; `unset: false` stays neutral; absent says nothing beyond the path. -#}
{%- set testId = params.testId -%}
{%- set where = params.source ~ (" on " ~ params.environment if params.environment else "") -%}
<span class="flex min-w-0 flex-col items-baseline gap-0.5" data-testid="{{ testId }}">
  <span class="text-sm">{% if params.method %}<span class="font-mono" data-testid="{{ testId }}-method">{{ params.method }}</span> {% endif %}<span data-testid="{{ testId }}-{{ 'url' if params.url else 'path' }}">{{ codeText(params.url or params.path) }}</span></span>
  <span class="text-xs"><span class="{{ muted }}" data-testid="{{ testId }}-service">{% if params.service %}{{ codeText(params.service) }}{% else %}{{ noValue({}) }}{% endif %}</span>
    {%- if not params.url and params.unset === true %} <span class="{{ muted }}" aria-hidden="true">·</span> <span data-testid="{{ testId }}-not-configured">not configured in {{ where }} ({{ codeText(params.service ~ "_URL") }} unset)</span>
    {%- elif not params.url and params.unset === false %} <span class="{{ muted }}" aria-hidden="true">·</span> <span data-testid="{{ testId }}-no-url">no usable URL in {{ where }}{% if params.service %} ({{ codeText(params.service ~ "_URL") }} unset or invalid){% endif %}</span>
    {%- endif -%}
  </span>
</span>
