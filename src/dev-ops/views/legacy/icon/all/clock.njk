{# lucide (ISC), `clock`, copied verbatim from https://lucide.dev — the root
   element is ours, carrying the caller's classes. The glyph on the time-range
   button: it says the button is about a window before the label is read. #}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"{% if params.class %} class="{{ params.class }}"{% endif %} data-testid="do-icon-clock">
  <path d="M12 6v6l4 2"/>
  <circle cx="12" cy="12" r="10"/>
</svg>
