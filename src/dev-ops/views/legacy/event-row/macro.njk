{# Tailwind only sees class names written literally in this file. A whole
   row is one link, so it takes the focus ring; any list of such rows uses these. #}
{% set rowClass = "relative cursor-pointer hover:bg-base-200 has-[:focus-visible]:bg-base-200 has-[:focus-visible]:outline-2 has-[:focus-visible]:-outline-offset-2 has-[:focus-visible]:outline-base-content" %}
{% set rowClassDeadLetter = "relative cursor-pointer bg-error/5 hover:bg-error/10 dark:bg-error/10 dark:hover:bg-error/15 has-[:focus-visible]:bg-error/10 has-[:focus-visible]:outline-2 has-[:focus-visible]:-outline-offset-2 has-[:focus-visible]:outline-base-content" %}

{# A dead letter's first cell carries a rule, so the row is marked by more than its tint. #}
{% set firstCellDeadLetter = "border-l-2 border-l-error" %}

{% macro eventRow(params) %}
    {%- include "./template.njk" -%}
{% endmacro %}

{# The events table's columns and head, for every table of event rows: Event, Status and the time. #}
{% macro eventsHead(params) %}
    {%- include "./head.njk" -%}
{% endmacro %}

{# A Created cell as the events list draws it, for any list with a created time. #}
{% macro createdCell(params) %}
    {%- include "./created.njk" -%}
{% endmacro %}

{# A created time alone, for a row with no table cell to hold it. #}
{% macro createdAt(params) %}
    {%- include "./created-at.njk" -%}
{% endmacro %}
