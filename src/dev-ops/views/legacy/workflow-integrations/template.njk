{% from "code-text/macro.njk" import codeText %}
{% from "muted/macro.njk" import muted %}
{% from "name-code/macro.njk" import nameCode %}
{% from "no-value/macro.njk" import noValue %}
{% from "icon/macro.njk" import icon %}
{% from "service-address/macro.njk" import serviceAddress %}

{# Tailwind only sees class names written literally in this file. #}
{% set card = "card card-border mt-4 bg-base-100 first:mt-0" %}
{% set small = "mt-1 text-xs " ~ muted %}
{% set step = "min-w-0 rounded-box border border-base-300 p-3" %}
{% set stepLabel = "mb-1 text-xs font-medium uppercase tracking-wide " ~ muted %}

{% macro andList(words) %}
  {%- for word in words -%}
    {%- if not loop.first %}{{ " and " if loop.last else ", " }}{% endif %}{{ word }}
  {%- endfor -%}
{% endmacro %}

{% macro linkAddress(link) %}
  {%- if link.address -%}{{ codeText(link.address) }}{%- else -%}an address worked out from the case{%- endif -%}
{% endmacro %}

{% macro trigger(item) %}
  {%- if item.kind == "button" -%}
    Caseworker presses <a class="link font-semibold" href="{{ item.href }}">{{ item.label }}</a> in the case banner
  {%- elif item.customLink -%}
    Every time a caseworker opens the <a class="link font-semibold" href="{{ item.href }}">{{ item.label }}</a> tab. Its link in the case view goes to {{ linkAddress(item.customLink) }}.
  {%- else -%}
    Every time a caseworker opens the <a class="link font-semibold" href="{{ item.href }}">{{ item.label }}</a> tab
  {%- endif -%}
{% endmacro %}

{% macro send(item, testId) %}
  <div class="text-sm" data-testid="{{ testId }}-send">
    <span class="font-mono text-xs {{ muted }}">{{ item.kind }}</span> {{ codeText(item.name) }} <span class="{{ muted }}" aria-hidden="true">←</span>
    {% if item.source == "computed" -%}
      <span class="{{ muted }}">computed</span>
      <details class="mt-0.5" data-testid="{{ testId }}-expression">
        <summary class="cursor-pointer text-xs {{ muted }}">Show expression</summary>
        <pre class="mt-1 font-mono text-xs whitespace-pre-wrap [overflow-wrap:anywhere]">{{ item.text }}</pre>
      </details>
    {%- else -%}
      {{ codeText(item.text) }} <span class="{{ muted }}">{{ "fixed" if item.source == "fixed" else "from case" }}</span>
    {%- endif %}
  </div>
{% endmacro %}

{# A write's words; `inline` starts it lower case, after a trigger. #}
{% macro write(item, inline) %}
  {%- set whenRun = (' <span class="' ~ muted ~ '">when run</span>') | safe if item.whenRun else "" -%}
  {%- if item.kind == "timeline" -%}
    {{ "adds" if inline else "Adds" }} a timeline entry
  {%- elif item.kind == "actionData" and inline -%}
    nothing stored; shown as {{ codeText(item.path) }}
  {%- elif item.kind == "actionData" -%}
    Nothing stored. The result is shown on the {{ andList(item.tabs) }} tab{{ "s" if item.tabs | length > 1 }} as {{ codeText(item.path) }}.
  {%- elif item.shape == "list" -%}
    {{ "appends" if inline else "Appends" }} to {{ codeText(item.path) }} (list){{ whenRun }}
  {%- elif item.shape == "list-keyed" -%}
    {{ "writes" if inline else "Writes" }} to {{ codeText(item.path) }}{{ whenRun }}: list, replaces the item with the same {{ codeText(item.key) }}, else appends
  {%- elif item.shape == "object-keyed" -%}
    {{ "writes" if inline else "Writes" }} to {{ codeText(item.path) }}{{ whenRun }}: object, keyed by {{ codeText(item.key) }}
  {%- else -%}
    {{ "writes" if inline else "Writes" }} to {{ codeText(item.path) }}{{ whenRun }}: object with no key, which CW refuses to write
  {%- endif -%}
{% endmacro %}

{% set triggerWords = { pressed: "When pressed:", tab: "When a tab opens:" } %}

{%- set integrations = params.integrations -%}
{%- set testId = params.testId -%}
{%- set environment = params.environment -%}
<div>
  {% for action in integrations.cards %}
    <section {% if action.anchor %}id="{{ action.anchor }}" {% endif %}class="scroll-mt-4 {{ card }}" aria-labelledby="{{ testId }}-{{ loop.index }}-title" data-testid="{{ testId }}">
      <div class="card-body gap-3 p-5">
        <h2 class="card-title flex-wrap text-base" id="{{ testId }}-{{ loop.index }}-title" data-testid="{{ testId }}-title">{{ nameCode({ name: action.name, code: action.code }) }}</h2>
        {% if action.description %}
          <p class="text-sm {{ muted }}">{{ action.description }}</p>
        {% endif %}
        {% if action.problems | length %}
          <div role="alert" class="alert alert-warning alert-soft text-sm" data-testid="{{ testId }}-problems">
            {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
            <span>{{ action.problems | join(" · ") }}</span>
          </div>
        {% endif %}
        <div class="grid grid-cols-1 items-start gap-2 lg:grid-cols-[1fr_1.4fr_2fr_1.4fr]" data-testid="{{ testId }}-steps">
          <div class="{{ step }}" data-testid="{{ testId }}-trigger">
            <div class="{{ stepLabel }}">Trigger</div>
            {% for item in action.triggers -%}
              <div class="text-sm">{{ trigger(item) }}</div>
            {%- else -%}
              {%- if action.apiOnly -%}
                <div class="text-sm" data-testid="{{ testId }}-api-only">No button or tab runs this in the case view. CW's page-action API can still run it.</div>
              {%- else -%}
                {{ noValue({}) }}
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="{{ step }}" data-testid="{{ testId }}-call">
            <div class="{{ stepLabel }}">Calls</div>
            {% if action.call -%}
              {{ serviceAddress({ method: action.call.method, path: action.call.path, url: action.call.address.url, service: action.call.address.service, source: "CW", unset: false, environment: environment, testId: testId ~ "-call" }) }}
              <div class="{{ small }}" data-testid="{{ testId }}-endpoint">{{ codeText(action.call.endpointCode) }}</div>
            {%- else -%}
              {{ noValue({}) }}
            {%- endif -%}
          </div>
          <div class="{{ step }}" data-testid="{{ testId }}-sends">
            <div class="{{ stepLabel }}">Sends</div>
            {% if action.sends | length -%}
              <div class="flex flex-col gap-1">
                {%- for item in action.sends -%}
                  {{ send(item, testId) }}
                {%- endfor -%}
              </div>
              {%- if action.headersService %}<div class="{{ small }}" data-testid="{{ testId }}-headers-note">Headers set in CW's {{ codeText(action.headersService ~ "_HEADERS") }} replace same-named ones.</div>{% endif -%}
            {%- else -%}
              {{ noValue({}) }}
            {%- endif -%}
          </div>
          <div class="{{ step }}" data-testid="{{ testId }}-writes">
            <div class="{{ stepLabel }}">Writes</div>
            {% for group in action.writes -%}
              {%- if group.trigger -%}
                <div class="text-sm{% if not loop.first %} mt-1{% endif %}" data-testid="{{ testId }}-write"><span class="font-medium">{{ triggerWords[group.trigger] }}</span> {% for item in group.writes %}{{ write(item, true) }}{% if not loop.last %} <span class="{{ muted }}" aria-hidden="true">·</span> {% endif %}{% endfor %}</div>
              {%- else -%}
                {%- for item in group.writes -%}
                  <div class="text-sm{% if not loop.first %} mt-1{% endif %}" data-testid="{{ testId }}-write">{{ write(item, false) }}</div>
                {%- endfor -%}
              {%- endif -%}
            {%- else -%}
              {{ noValue({}) }}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </section>
  {% else %}
    <div class="{{ card }}" data-testid="{{ testId }}-empty">
      <p class="px-4 py-10 text-center text-sm {{ muted }}">No integrations (external actions) in this version.</p>
    </div>
  {% endfor %}
  {% if integrations.unusedEndpoints | length %}
    <section class="{{ card }}" aria-labelledby="{{ testId }}-unused-title" data-testid="{{ testId }}-unused">
      <div class="card-body gap-3 p-5">
        <h2 class="card-title text-base" id="{{ testId }}-unused-title">Endpoints used by nothing</h2>
        <div class="w-full overflow-x-auto">
          <table class="table w-full min-w-[32rem] table-fixed">
            <colgroup><col class="w-[30%]"><col class="w-[70%]"></colgroup>
            <thead>
              <tr><th scope="col">Code</th><th scope="col">Calls</th></tr>
            </thead>
            <tbody>
              {% for endpoint in integrations.unusedEndpoints %}
                <tr class="hover:bg-base-200 [&>td]:align-top"><td>{{ codeText(endpoint.endpointCode, "text-sm") }}</td><td>{{ serviceAddress({ method: endpoint.method, path: endpoint.path, url: endpoint.address.url, service: endpoint.address.service, source: "CW", unset: false, environment: environment, testId: testId ~ "-unused" }) }}</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  {% endif %}
</div>
