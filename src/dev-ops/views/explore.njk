{% extends 'layouts/page.njk' %}
{% import "components/macros.njk" as gpa %}


{#- A value on one line, cut at its cell's width; past the most a cell holds, its start and size. -#}
{% macro cellHtml(cell) -%}
  {%- if cell.kind == 'time' -%}
    {{ gpa.Time(cell.time) }}
  {%- elif cell.kind == 'text' -%}
    {{ gpa.CutText({ text: cell.text, mono: cell.mono, size: cell.size, href: cell.href }) }}
  {%- else -%}
    {{ gpa.NoValue() }}
  {%- endif -%}
{%- endmacro %}

{#- A row's link holds its first value as CutText drawn as the link's text: past the most a cell holds, its start and size. -#}
{% macro linkHtml(cell) -%}
  {%- if cell.kind == 'time' -%}
    {{ gpa.Time(cell.time) }}
  {%- elif cell.kind == 'text' -%}
    {{ gpa.CutText({ text: cell.text, mono: cell.mono, size: cell.size, inRowLink: true }) }}
  {%- else -%}
    {{ gpa.NoValue() }}
  {%- endif -%}
{%- endmacro %}

{#- Records too large to search, every one by its _id, with a link to it where it has a page. -#}
{% macro skippedHtml(note) -%}
  {{ note.text }}{% for record in note.records %} <span data-testid="explore-skipped">{{ record.id }}{% if record.open %} {{ gpa.Link({ text: record.open.text, href: record.open.href, size: 'sm', attributes: { 'aria-label': record.open.label } }) }}{% endif %}</span>{% if not loop.last %};{% endif %}{% endfor %}
{%- endmacro %}

{#- Explore: a query, the Queries menu to start one from, and what the run held in the session found. Every way in is a form post; no query is ever in an address. -#}
{% block content %}
  {%- set queriesTrigger %}{{ gpa.Icon({ name: 'book-open', size: 'sm' }) }}<span>Queries</span>{{ gpa.Icon({ name: 'chevron-down', size: 'sm', classes: 'gpa-chevron' }) }}{% endset -%}
  {%- set queriesMenu -%}
    {%- call gpa.Dropdown({ trigger: queriesTrigger, triggerClasses: 'gpa-btn gpa-btn-default gpa-btn-sm', triggerTestId: 'explore-queries', align: 'end', menuLabel: 'Queries', panelTestId: 'explore-queries-menu' }) -%}
      {%- if queries.recent | length -%}
        {%- call gpa.MenuGroup({ heading: 'Your recent queries' }) -%}
          {%- for item in queries.recent -%}
            {{ gpa.MenuItem({ text: item.text, mono: true, type: 'submit', name: 'pick', value: item.value, form: 'explore-form', testId: 'explore-recent' }) }}
          {%- endfor -%}
        {%- endcall -%}
        {{ gpa.MenuDivider() }}
      {%- endif -%}
      {%- call gpa.MenuGroup({ heading: 'Examples' }) -%}
        {%- for item in queries.examples -%}
          {{ gpa.MenuItem({ text: item.text, type: 'submit', name: 'pick', value: item.value, form: 'explore-form', testId: 'explore-example' }) }}
        {%- endfor -%}
      {%- endcall -%}
    {%- endcall -%}
  {%- endset -%}

  {%- call gpa.Page() -%}
    {{ gpa.PageHeader({ title: pageTitle, meta: meta, actions: queriesMenu, titleTestId: 'explore-title' }) }}
    {%- if alert -%}
      {%- set alertActions -%}
        {%- if alert.retryHref %}{{ gpa.Button({ text: 'Try again', size: 'sm', iconStart: 'refresh-cw', href: alert.retryHref, testId: 'explore-retry' }) }}{% endif -%}
        {%- if alert.startHref %}{{ gpa.Button({ text: 'Start again', size: 'sm', href: alert.startHref, testId: 'explore-start-again' }) }}{% endif -%}
      {%- endset -%}
      {{ gpa.Alert({ tone: alert.tone, title: alert.title, text: alert.text, actions: alertActions, focusOnArrival: true, testId: 'explore-alert' }) }}
    {%- endif -%}

    {%- call gpa.Card({ padded: true, testId: 'explore-editor' }) -%}
      {%- call gpa.Form({ id: 'explore-form', action: action, label: 'Query', wide: true, testId: 'explore-form' }) -%}
        {%- call gpa.Stack({ gap: 'md' }) -%}
          {{ gpa.QueryEditor({ id: 'q', name: 'q', label: 'Query', value: editor.value, vocabulary: editor.vocabulary, error: editor.error, clear: true, runHint: true, testId: 'explore-editor-field' }) }}
          {%- call gpa.Inline({ gap: 'sm', align: 'center' }) -%}
            {{ gpa.Button({ text: 'Run', variant: 'primary', iconStart: 'play', type: 'submit', loadingOnSubmit: true, testId: 'explore-run' }) }}
          {%- endcall -%}
        {%- endcall -%}
      {%- endcall -%}
    {%- endcall -%}

    {%- if results -%}
      {%- call gpa.Stack({ gap: 'sm', testId: 'explore-results' }) -%}
        {#- The unseen paths stay over the frame: the toolbar holds only what sticks with the header. -#}
        {%- if results.unseen %}{{ gpa.Text({ text: results.unseen, tone: 'muted', variant: 'body-sm', testId: 'explore-unseen' }) }}{% endif -%}
        {%- set toolbar -%}
          {%- call gpa.Inline({ gap: 'sm', align: 'center', justify: 'between' if results.count else 'end', testId: 'explore-bar' }) -%}
            {%- if results.count %}{{ gpa.Text({ text: results.count, tone: 'muted', variant: 'body-sm', focusOnArrival: results.arrived, attributes: { id: 'explore-count', role: 'status', 'data-load-more-count': true }, testId: 'explore-count' }) }}{% endif -%}
            {%- call gpa.ButtonSlot({ width: 'lg', testId: 'explore-csv-slot' }) -%}
              {{ gpa.Button({ text: 'Download CSV', variant: 'tertiary', size: 'sm', iconStart: 'download', type: 'submit', form: 'explore-csv-form', testId: 'explore-csv' }) }}
            {%- endcall -%}
          {%- endcall -%}
        {%- endset -%}
        {#- With no row shown, the empty state is drawn here, so Keep looking from it is a plain post and the page after says what it found. -#}
        {%- set footer -%}
          {%- if results.empty -%}
            {%- set keepLooking %}{{ gpa.Button({ text: 'Keep looking', size: 'sm', type: 'submit', form: 'explore-keep-looking-form', testId: 'explore-keep-looking' }) }}{% endset -%}
            {%- set emptyHtml %}{{ results.empty.text }}{% if results.empty.note %} {{ skippedHtml(results.empty.note) }}{% endif %}{% endset -%}
            {{ gpa.EmptyState({ compact: true, icon: results.empty.icon, title: results.empty.title, html: emptyHtml, actions: keepLooking if results.empty.keepLooking else null, testId: 'explore-empty' }) }}
          {%- endif -%}
          {%- if results.footer -%}
            {%- set skippedNote = skippedHtml(results.footer.note) if results.footer.note else null -%}
            {%- set endHtml %}{{ results.footer.text }}{% if skippedNote %} {{ skippedNote }}{% endif %}{% endset -%}
            {{ gpa.ListFooter({ state: results.footer.state, text: results.footer.text, html: endHtml if results.footer.state == 'end' else null, searchedTo: results.footer.searchedTo, form: results.footer.form, note: skippedNote, retryHref: results.footer.retryHref, restoreHref: results.footer.restoreHref, noun: results.noun, testId: 'explore-footer', countId: 'explore-count' }) }}
          {%- endif -%}
        {%- endset -%}
        {%- call gpa.DataTable({ styleNonce: styleNonce, label: results.label, link: true, stickyFirstColumn: not results.idFirst, narrow: 'scroll', toolbar: toolbar, columns: results.columns, after: footer, bodyId: 'explore-rows', testId: 'explore-table' }) -%}
          {%- for row in results.rows -%}
            {%- call gpa.TableRow({ link: row.href != null, restoreHref: row.restoreHref, attributes: { id: row.id }, testId: 'explore-row' }) -%}
              {%- for cell in row.cells -%}
                {%- set column = results.columns[loop.index0] -%}
                {%- set cellClass = ['gpa-right' if column.align == 'right', 'gpa-cell-max-' ~ column.max if column.max] | select | join(' ') -%}
                <td role="cell"{% if cellClass %} class="{{ cellClass }}"{% endif %}>
                  {%- if loop.first and row.href -%}
                    {{ gpa.RowLink({ html: linkHtml(cell), href: row.href, plain: results.idFirst, mono: results.idFirst }) }}
                  {%- else -%}
                    {{ cellHtml(cell) }}
                  {%- endif -%}
                </td>
              {%- endfor -%}
              {%- if row.href %}{{ gpa.RowChevron() }}{% else %}<td role="cell"></td>{% endif -%}
            {%- endcall -%}
          {%- endfor -%}
        {%- endcall -%}
      {%- endcall -%}
    {%- endif -%}
  {%- endcall -%}

  {%- if results -%}
    {%- if results.empty and results.empty.keepLooking %}{{ gpa.Form({ id: 'explore-keep-looking-form', action: results.empty.keepLooking.action, method: 'post', label: 'Keep looking', hidden: [{ name: 'run', value: results.empty.keepLooking.fields.run }, { name: 'page', value: results.empty.keepLooking.fields.page }], attributes: { hidden: true } }) }}{% endif -%}
    {#- Download CSV sends this form: only the run, as the session knows how far it has been read. -#}
    {{ gpa.Form({ id: 'explore-csv-form', action: results.csv.action, method: 'post', label: 'Download CSV', hidden: [{ name: 'run', value: results.csv.run }], attributes: { hidden: true } }) }}
  {%- endif -%}
{% endblock %}
