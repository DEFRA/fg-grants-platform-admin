{% extends 'layouts/page.njk' %}
{% import "design-system/macros.njk" as au %}
{% import "partials/access-tokens/token.njk" as token %}
{% import "partials/access-tokens/new-token.njk" as newToken_ %}


{#- A service's access tokens: the list, each token's drawer and its dialogs, all drawn on the page so the script opens them in place; the address opens any of them without one. -#}
{% block content %}
  {%- set newButton = au.Button({ text: 'New token', variant: 'primary', iconStart: 'plus', href: newHref, attributes: { 'data-au-open': newToken.id }, testId: 'token-new-open' }) if newToken else '' -%}
  {%- set alertHtml -%}
    {%- call au.Stack({ gap: 'lg' }) -%}
      {%- for a in alerts -%}
        {%- set retry = au.Button({ text: 'Try again', size: 'sm', iconStart: 'refresh-cw', href: a.retryHref }) if a.retryHref else '' -%}
        {{ au.Alert({ tone: a.tone, title: a.title, text: a.text, actions: retry, focusOnArrival: a.focusOnArrival, testId: 'tokens-alert' }) }}
      {%- endfor -%}
    {%- endcall -%}
  {%- endset -%}

  {%- call au.ListPage({ title: 'Access tokens', meta: meta, actions: newButton, alert: alertHtml if alerts.length }) -%}
    {%- if tokens -%}
      {%- call au.DataTable({
        styleNonce: styleNonce,
        label: 'Access tokens',
        link: true,
        testId: 'tokens-table',
        empty: { title: 'No access tokens yet', icon: 'inbox' } if not tokens.length,
        columns: [
          { key: 'client', label: 'Client ID', width: 'auto', mono: true },
          { key: 'hint', label: 'Token', width: 'auto', mono: true },
          { key: 'status', label: 'Status', width: 'auto' },
          { key: 'expires', label: 'Expires', width: 'max-content', align: 'right' }
        ]
      }) -%}
        {%- for t in tokens -%}
          {%- call au.TableRow({ link: true, selected: t.open, testId: 'token-row' }) -%}
            <td role="cell" class="au-cell-mono">{{ au.RowLink({ html: (t.clientId | escape) if t.clientId else au.NoValue(), href: t.href, mono: true, attributes: { 'data-au-open': t.id } }) }}</td>
            <td role="cell" class="au-cell-mono">{{ token.hint(t) }}</td>
            <td role="cell">{{ au.StatusDot({ tone: t.status.tone, text: t.status.text }) }}</td>
            <td role="cell" class="au-right">
              {%- if t.expires %}{{ au.Time({ datetime: t.expires.datetime, text: t.expires.text, title: t.expires.title }) }}{% else %}{{ au.Text({ text: 'Never', tone: 'subtle' }) }}{% endif -%}
            </td>
            {{ au.RowChevron() }}
          {%- endcall -%}
        {%- endfor -%}
      {%- endcall -%}
    {%- endif -%}
  {%- endcall -%}

  {%- for t in tokens -%}
    {{ token.drawer(t) }}
  {%- endfor -%}
  {%- if newToken %}{{ newToken_.newTokenDialog(newToken, prod) }}{% endif -%}
  {%- for t in tokens -%}
    {%- if t.rotate %}{{ token.rotateDialog(t, prod) }}{% endif -%}
    {%- if t.expiry %}{{ token.expiryDialog(t, prod) }}{% endif -%}
    {%- if t.revoke and t.revoke.dialog %}{{ token.revokeDialog(t, prod, shortName) }}{% endif -%}
    {%- if t.delete %}{{ token.deleteDialog(t, prod) }}{% endif -%}
  {%- endfor -%}
  {%- if reveal %}{{ newToken_.issuedDialog(reveal) }}{% endif -%}
{% endblock %}
