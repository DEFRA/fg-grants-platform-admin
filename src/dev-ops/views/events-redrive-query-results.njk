{% extends 'layouts/page.njk' %}

{% from "icon/macro.njk" import icon %}

{% set sectionHeading = "text-[11px] font-semibold tracking-wide uppercase text-base-content/45" %}
{% set card = "overflow-hidden rounded-box border border-base-300 bg-base-100" %}
{% set figureLabel = "text-[11px] font-medium tracking-wide uppercase text-base-content/45" %}
{% set figureValue = "font-mono text-[19px] font-medium tabular-nums text-base-content" %}

{# Stage two: what the run actually came to.

   Five figures rather than one sentence, because "it worked" is not something
   that happens to five hundred events at once: some were redriven, some had
   moved on since the page was drawn, some could not be written at all, and —
   when more matched than one run may process — some were never reached. The
   last of those is the only number here an operator has to act on, so the page
   says it in words and offers the run again rather than leaving them to compare
   two figures. #}
{% block content %}
  <a class="text-[12px] text-base-content/55 hover:underline" href="{{ backHref }}" data-testid="events-redrive-query-back">← Events</a>

  {% if unavailable %}
    <div role="alert" class="alert alert-error mt-3 text-[13px]" data-testid="events-redrive-query-error">
      {{ icon({ name: 'exclamation-circle', class: 'h-4 w-4 shrink-0' }) }}
      <span>The redrive could not be run — fg-gas-backend could not be reached. Nothing has been redriven.</span>
    </div>
  {% else %}
    <header class="mt-3 mb-4">
      <h1 class="text-xl font-semibold" data-testid="events-redrive-query-results-title">Redrove {{ redrivenLabel }} of {{ matchedLabel }} matching events</h1>
      <p class="mt-0.5 text-[13px] text-base-content/60" data-testid="events-redrive-query-results-subtitle">A redriven event is Resubmitted now; the poller will retry it. Refresh the list to follow the attempts.</p>
    </header>

    {% if unavailableSources %}
      <div role="alert" class="alert alert-warning mb-4 text-[13px]" data-testid="events-redrive-query-partial">
        {{ icon({ name: 'exclamation-triangle', class: 'h-4 w-4 shrink-0' }) }}
        <span>Some event sources could not be written to: {{ unavailableSources }}. The rest were processed.</span>
      </div>
    {% endif %}

    {# The five figures, side by side and in one weight: each is a different
       outcome of the same write, and colouring one of them would say that a
       conflict is worse than a failure, which it is not. #}
    <section class="{{ card }} mb-4 px-4 py-3.5" data-testid="events-redrive-query-summary">
      <dl class="flex flex-wrap gap-x-10 gap-y-3">
        <div data-testid="events-redrive-query-matched">
          <dt class="{{ figureLabel }}">Matched</dt>
          <dd class="{{ figureValue }}">{{ matchedLabel }}</dd>
        </div>
        <div data-testid="events-redrive-query-processed">
          <dt class="{{ figureLabel }}">Processed</dt>
          <dd class="{{ figureValue }}">{{ processedLabel }}</dd>
        </div>
        <div data-testid="events-redrive-query-redriven">
          <dt class="{{ figureLabel }}">Redriven</dt>
          <dd class="{{ figureValue }}">{{ redrivenLabel }}</dd>
        </div>
        <div data-testid="events-redrive-query-conflicts">
          <dt class="{{ figureLabel }}">Conflicts</dt>
          <dd class="{{ figureValue }}">{{ conflictsLabel }}</dd>
        </div>
        <div data-testid="events-redrive-query-failures">
          <dt class="{{ figureLabel }}">Failures</dt>
          <dd class="{{ figureValue }}">{{ failuresLabel }}</dd>
        </div>
      </dl>
      {# A conflict is not a failure and the page says so once, here, rather
         than leaving an operator to work out why two of the five figures are
         not zero. #}
      <p class="mt-3 border-t border-base-300 pt-3 text-[12px] text-base-content/55" data-testid="events-redrive-query-legend">A conflict is an event that was no longer dead-lettered when the redrive reached it — nothing was lost. A failure is one the backend could not write.</p>
    </section>

    {% if perSource | length %}
      <section class="{{ card }} mb-4" data-testid="events-redrive-query-sources-card">
        <div class="border-b border-base-300 px-4 py-2">
          <h2 class="{{ sectionHeading }}" data-testid="events-redrive-query-sources-heading">By source</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-[12px]" data-testid="events-redrive-query-sources">
            <thead>
              <tr class="border-b border-base-300">
                <th class="{{ sectionHeading }} px-4 py-1.5 text-left">Queue</th>
                <th class="{{ sectionHeading }} px-4 py-1.5 text-right">Matched</th>
                <th class="{{ sectionHeading }} px-4 py-1.5 text-right">Processed</th>
                <th class="{{ sectionHeading }} px-4 py-1.5 text-right">Redriven</th>
                <th class="{{ sectionHeading }} px-4 py-1.5 text-right">Conflicts</th>
                <th class="{{ sectionHeading }} px-4 py-1.5 text-right">Failures</th>
              </tr>
            </thead>
            <tbody>
              {% for row in perSource %}
                <tr class="border-t border-base-300/55" data-testid="events-redrive-query-source-row">
                  <td class="px-4 py-1.5 whitespace-nowrap text-base-content/85" data-testid="events-redrive-query-source">{{ row.source }}</td>
                  <td class="px-4 py-1.5 text-right font-mono tabular-nums text-base-content/75">{{ row.matched }}</td>
                  <td class="px-4 py-1.5 text-right font-mono tabular-nums text-base-content/75">{{ row.processed }}</td>
                  <td class="px-4 py-1.5 text-right font-mono tabular-nums text-base-content/75">{{ row.redriven }}</td>
                  <td class="px-4 py-1.5 text-right font-mono tabular-nums text-base-content/75">{{ row.conflicts }}</td>
                  <td class="px-4 py-1.5 text-right font-mono tabular-nums text-base-content/75">{{ row.failures }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>
    {% endif %}
  {% endif %}

  <div class="flex items-center gap-2">
    {# More matched than one run could reach, so there is more to do — and the
       way to do it is the confirmation again, not a button that writes from
       here. Offered only where it is true: a `Run again` on a run that reached
       everything it matched would queue the same messages a second time. #}
    {% if runAgain %}
      <a class="btn btn-sm btn-error btn-outline font-normal" href="{{ runAgainHref }}" data-testid="events-redrive-query-run-again">Run again</a>
    {% endif %}
    <a class="btn btn-sm btn-ghost border border-base-300 font-normal" href="{{ backHref }}" data-testid="events-redrive-query-results-back">Back to events</a>
  </div>
{% endblock %}
