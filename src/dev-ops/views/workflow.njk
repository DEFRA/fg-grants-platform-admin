{% extends "record.njk" %}

{% from "muted/macro.njk" import muted %}
{% from "code-text/macro.njk" import codeText %}
{% from "icon/macro.njk" import icon %}
{% from "state-graph/macro.njk" import stateGraph %}
{% from "version-banner/macro.njk" import versionBanner %}
{% from "version-status/macro.njk" import versionStatus %}
{% from "workflow-integrations/macro.njk" import workflowIntegrations %}
{% from "workflow-pages/macro.njk" import workflowPages %}
{% from "workflow-tasks/macro.njk" import workflowTasks %}
{% from "workflow-status-panel/macro.njk" import workflowStatusPanel %}

{% block pageTitle %}{% if missingVersion %}Not found – {{ record.title }} {{ ref }} {{ missingVersion.version }}{% elif version %}{{ (tabs | selectattr("active") | first).label }} – {{ record.title }} {{ ref }} {{ version }}{% else %}{{ record.title }} {{ ref }}{% endif %} | {{ serviceName }}{% endblock %}

{% block recordHeader %}
  {% if versionHeader %}
    {{ versionStatus({ header: versionHeader, testId: record.itemId }) }}
  {% endif %}
{% endblock %}

{% block beforeTabs %}
  {{ versionBanner({ notices: notices, banner: versionHeader.banner, testId: record.itemId }) }}
{% endblock %}

{% block tabBody %}
  {% if sectionError %}
    {{ super() }}
  {% elif notStored %}
    <div class="card card-border bg-base-100" data-testid="{{ record.itemId }}-not-stored">
      <p class="px-4 py-10 text-center text-sm {{ muted }}">{{ notStored.text }}</p>
    </div>
  {% elif tab == "phases" and phases %}
    {% if phases.findings %}
      <div role="status" class="alert alert-warning alert-soft mb-3 text-sm" data-testid="workflow-phases-findings">
        {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
        <p class="min-w-0 break-words">{{ phases.findings.count }} finding{{ "s" if phases.findings.count != 1 }}:
          {%- for group in phases.findings.groups %}{% if not loop.first %} ·{% endif %} {{ group.kind }} {% for status in group.statuses %}<a class="link" href="{{ status.href }}" data-testid="workflow-phases-finding-link">{{ codeText(status.code) }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endfor %}
        </p>
      </div>
    {% endif %}
    {% call stateGraph({ graphs: phases.graphs, legend: phases.legend, testId: "workflow-phases" }) %}
      {% if phases.panel %}
        {{ workflowStatusPanel(phases.panel) }}
      {% else %}
        <p class="{{ muted }}" data-testid="workflow-phases-no-statuses">No statuses.</p>
      {% endif %}
    {% endcall %}
  {% elif tab == "tasks" and taskGroups %}
    {{ workflowTasks({ groups: taskGroups, testId: "workflow-tasks" }) }}
  {% elif tab == "pages" and pages %}
    {{ workflowPages({ tab: pages, environment: environmentLabel, testId: "workflow-pages" }) }}
  {% elif tab == "integrations" and integrations %}
    {{ workflowIntegrations({ integrations: integrations, environment: environmentLabel, testId: "workflow-integrations" }) }}
  {% else %}
    {{ super() }}
  {% endif %}
{% endblock %}
