{% extends 'layouts/page.njk' %}
{% import "design-system/macros.njk" as au %}
{% from "partials/record-tabs.njk" import recordAlert, recordTime, tabNotice, whereCard, counterpartCard, seriesSection, versionFact, eventsTab, rawTab with context %}

{% block oldPage %}{% endblock %}

{% block pageTitle %}{{ record.title }} {{ ref }} – {{ productName }}{% endblock %}

{#- One case: its header, then one tab, with Details beside Overview. -#}
{% block content %}
  {%- set shown = overview and overview.kind == 'shown' -%}
  {%- if shown -%}
    {%- set closed = overview.details.closed -%}
    {%- set closedHtml -%}
      {%- if closed.kind == 'at' %}{{ recordTime(closed.time) }}{% elif closed.kind == 'open' %}{{ au.Text({ text: 'Still open', tone: 'subtle' }) }}{% endif -%}
    {%- endset -%}
    {%- set aside = au.FactsCard({ title: 'Details', testId: 'case-details', facts: [
      { label: 'Grant', html: versionFact(overview.details.grantVersion) if overview.details.grantVersion },
      { label: 'Created', html: recordTime(overview.details.created) if overview.details.created },
      { label: 'Closed', html: closedHtml if closed.kind != 'unknown' }
    ] }) -%}
  {%- endif -%}

  {%- call au.RecordPage({
    title: ref,
    mono: true,
    titleTestId: 'record-title',
    back: { href: backHref, text: backLabel, testId: 'record-back' },
    meta: [au.StatusDot({ text: status, tone: 'neutral' })] if status else [],
    actions: au.CopyButton({ value: ref, text: 'Copy reference' }),
    alert: recordAlert(alert) if alert,
    tabs: { label: 'Case', items: tabs },
    aside: aside if shown
  }) -%}
    {%- if tab == 'overview' -%}
      {%- if shown -%}
        {{ whereCard('Where the case is', overview.where) }}
        {%- if overview.application %}{{ counterpartCard(overview.application) }}{% endif -%}
        {%- if overview.series %}{{ seriesSection(overview.series) }}{% endif -%}
      {%- else -%}
        {{ tabNotice(overview) }}
      {%- endif -%}
    {%- elif tab == 'events' -%}
      {{ eventsTab(events) }}
    {%- else -%}
      {{ rawTab(raw) }}
    {%- endif -%}
  {%- endcall -%}
{% endblock %}
