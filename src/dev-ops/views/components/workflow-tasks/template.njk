{% from "code-text/macro.njk" import codeText %}
{% from "inline-badge/macro.njk" import inlineBadge %}
{% from "muted/macro.njk" import muted %}
{% from "name-code/macro.njk" import nameCode %}
{% from "no-value/macro.njk" import noValue %}
{# Tailwind only sees class names written literally in this file. #}
{% set note = "mt-0.5 text-sm " ~ muted %}
{% set taskEdge = "border-t border-base-300" %}

{% macro yesNo(value) %}{% if value %}<span class="font-medium">Yes</span>{% else %}<span class="{{ muted }}">No</span>{% endif %}{% endmacro %}

{% macro description(value, testId) %}
  {%- if value.kind == "text" -%}
    <div class="{{ note }}" data-testid="{{ testId }}">{{ value.text }}</div>
  {%- elif value.kind == "parts" -%}
    <div class="{{ note }}" title="{{ value.text }}" data-testid="{{ testId }}">Shows a {{ value.count }}-part description to caseworkers</div>
  {%- endif -%}
{% endmacro %}

{% macro condition(task, testId) %}
  {%- if task.condition %}<div class="{{ note }}" data-testid="{{ testId }}-condition">Only on cases where {{ codeText(task.condition) }} was set and not null, false, 0 or "" when the case entered this stage (an empty list or object counts as set)</div>{% endif -%}
{% endmacro %}

{% macro comment(value) %}
  {%- if value -%}
    {{ inlineBadge({ text: "required" if value.required else "optional" }) }} “{{ value.label }}”
    {%- if value.source != "task" and value.apiRequires %} <span class="{{ muted }}">(CW's API requires one: the task's comment is mandatory)</span>
    {%- elif value.source == "default" %} <span class="{{ muted }}">(CW default, frontend check only)</span>
    {%- elif value.source == "option" %} <span class="{{ muted }}">(frontend check only)</span>{% endif -%}
  {%- else -%}
    {{ noValue({}) }}
  {%- endif -%}
{% endmacro %}

{% macro roles(task, testId) %}
  <span data-testid="{{ testId }}-roles">
    {%- for line in task.roles -%}
      <div><span class="{{ muted }}">{{ line.label }}:</span> {% for role in line.roles %}{{ codeText(role, "text-sm") }}{% if not loop.last %}<span class="{{ muted }}">, </span>{% endif %}{% endfor %}</div>
    {%- else -%}
      Any caseworker
    {%- endfor -%}
  </span>
{% endmacro %}

{% macro taskName(task, testId) %}
  <span data-testid="{{ testId }}-task">{{ task.name }}</span>
  {%- if task.description %}{{ description(task.description, testId ~ "-task-description") }}{% endif -%}
  {{- condition(task, testId) -}}
{% endmacro %}

{% macro answerName(answer, testId) %}
  {{ answer.name }}
  {%- if answer.shownAs %}<div class="{{ note }}" data-testid="{{ testId }}-shown-as">task list shows: {{ answer.shownAs }}</div>{% endif -%}
  {%- if answer.rules | length %}<div class="{{ note }}" data-testid="{{ testId }}-rules">{{ answer.rules | join(", ") }}</div>{% endif -%}
{% endmacro %}

{% macro countsAsDone(answer) %}
  {%- if answer.completes == null %}When filled in{% else %}{{ yesNo(answer.completes) }}{% endif -%}
{% endmacro %}

{% macro answerLine(answer) %}
  {{- answer.name }} <span class="{{ muted }}" aria-hidden="true">·</span>
  {% if answer.completes == null %}counts as done when filled in{% elif answer.completes %}counts as done{% else %}doesn't count as done{% endif %}
  {%- if answer.comment %} <span class="{{ muted }}" aria-hidden="true">·</span> comment {{ "required" if answer.comment.required else "optional" }}{% endif -%}
{% endmacro %}

{% macro rowspan(count) %}{% if count > 1 %} rowspan="{{ count }}"{% endif %}{% endmacro %}

{% macro gate(item) %}
  {%- if item.kind == "action" -%}
    {{ item.name }} ({{ codeText(item.code) }})
  {%- else -%}
    GAS move to <span title="{{ item.position }}">{{ item.statusName }}</span>
  {%- endif -%}
{% endmacro %}

{%- set testId = params.testId -%}
<div data-testid="{{ testId }}">
  {% if params.groups | length %}
    <p class="mb-4 text-sm" data-testid="{{ testId }}-intro">Before a move that needs tasks, every <strong>mandatory</strong> task in the stage must have an answer that <strong>completes</strong> it. Other answers record progress but keep the task open.</p>
  {% endif %}
  {% for group in params.groups %}
    <section{% if group.anchor %} id="{{ group.anchor }}"{% endif %} class="card card-border mt-4 scroll-mt-4 bg-base-100 first:mt-0" aria-labelledby="{{ testId }}-group-{{ loop.index }}-title" data-testid="{{ testId }}-group">
      <div class="card-body gap-3 p-5">
        <div>
          <h2 class="card-title text-base" id="{{ testId }}-group-{{ loop.index }}-title" data-testid="{{ testId }}-group-title">{{ nameCode({ name: group.name, code: group.code }) }}</h2>
          <div class="mt-0.5 text-sm" data-testid="{{ testId }}-group-stage">{{ nameCode({ name: group.stage.name, code: group.stage.code }) }}</div>
          {% if group.description %}{{ description(group.description, testId ~ "-group-description") }}{% endif %}
        </div>
        {% if group.gates | length %}
          <p class="text-sm" data-testid="{{ testId }}-gates"><strong>Must be complete before:</strong> {% for item in group.gates %}{{ gate(item) }}{% if not loop.last %} <span class="{{ muted }}" aria-hidden="true">·</span> {% endif %}{% endfor %}{% if group.conditional %} <span class="{{ muted }}" data-testid="{{ testId }}-gates-conditional">(when it applies)</span>{% endif %}</p>
        {% endif %}
        <ul class="divide-y divide-base-300 sm:hidden" data-testid="{{ testId }}-blocks">
          {% for task in group.tasks %}
            <li class="py-2 text-sm" data-testid="{{ testId }}-block">
              <div class="font-medium">{{ taskName(task, testId ~ "-block") }}</div>
              <div class="mt-1"><span class="{{ muted }}">Mandatory</span> <span class="{{ muted }}" aria-hidden="true">·</span> <span data-testid="{{ testId }}-block-mandatory">{{ yesNo(task.mandatory) }}</span></div>
              {% for answer in task.answers %}
                <div class="mt-1" data-testid="{{ testId }}-block-answer">{{ answerLine(answer) }}</div>
              {% endfor %}
              <div class="mt-1"><span class="{{ muted }}">Roles</span> <span class="{{ muted }}" aria-hidden="true">·</span> {{ roles(task, testId ~ "-block") }}</div>
            </li>
          {% endfor %}
        </ul>
        <div class="hidden w-full overflow-x-auto sm:block">
          <table class="table w-full min-w-[56rem] table-fixed" data-testid="{{ testId }}-table">
            <colgroup><col class="w-[17%]"><col class="w-[9%]"><col class="w-[27%]"><col class="w-[13%]"><col class="w-[20%]"><col class="w-[14%]"></colgroup>
            <thead>
              <tr><th scope="col">Task</th><th scope="col">Mandatory</th><th scope="col">Answer</th><th scope="col">Counts as done</th><th scope="col">Comment</th><th scope="col">Roles</th></tr>
            </thead>
            <tbody>
              {% for task in group.tasks %}
                {% set span = task.answers | length if task.answers | length else 1 %}
                {% for answer in task.answers %}
                  <tr class="border-b-0 [&>td]:py-2 [&>td]:align-top{% if loop.first %} {{ taskEdge }}{% endif %}" data-testid="{{ testId }}-answer">
                    {% if loop.first %}
                      <td{{ rowspan(span) }}>{{ taskName(task, testId) }}</td>
                      <td{{ rowspan(span) }} data-testid="{{ testId }}-mandatory">{{ yesNo(task.mandatory) }}</td>
                    {% endif %}
                    <td>{{ answerName(answer, testId) }}</td>
                    <td data-testid="{{ testId }}-completes">{{ countsAsDone(answer) }}</td>
                    {% if answer.commentRows %}<td{{ rowspan(answer.commentRows) }} data-testid="{{ testId }}-comment">{{ comment(answer.comment) }}</td>{% endif %}
                    {% if loop.first %}<td{{ rowspan(span) }}>{{ roles(task, testId) }}</td>{% endif %}
                  </tr>
                {% else %}
                  <tr class="border-b-0 [&>td]:py-2 [&>td]:align-top {{ taskEdge }}" data-testid="{{ testId }}-answer">
                    <td>{{ taskName(task, testId) }}</td>
                    <td data-testid="{{ testId }}-mandatory">{{ yesNo(task.mandatory) }}</td>
                    <td>{{ noValue({}) }}</td>
                    <td data-testid="{{ testId }}-completes">{{ noValue({}) }}</td>
                    <td data-testid="{{ testId }}-comment">{{ noValue({}) }}</td>
                    <td>{{ roles(task, testId) }}</td>
                  </tr>
                {% endfor %}
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  {% else %}
    <div class="card card-border bg-base-100" data-testid="{{ testId }}-empty">
      <p class="px-4 py-10 text-center text-sm {{ muted }}">No task groups.</p>
    </div>
  {% endfor %}
</div>
