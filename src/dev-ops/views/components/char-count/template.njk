{# `validator` colours the box from `aria-invalid`, set here by the server: "required only for Other" is not a constraint the platform can express. #}
<do-char-count class="contents" data-max="{{ params.max }}" data-testid="do-char-count">
  <textarea class="textarea validator w-full text-sm" id="{{ params.id }}" name="{{ params.name }}" rows="3" placeholder="{{ params.placeholder }}" aria-describedby="{{ params.describedBy }}"{% if params.message %} aria-invalid="true"{% endif %} data-testid="{{ params.testId }}">{{ params.value }}</textarea>
  {% if params.message %}
    <p class="validator-hint visible mt-1 text-sm text-error" id="{{ params.messageId }}" data-testid="{{ params.testId }}-message">{{ params.message }}</p>
  {% endif %}
  <p class="label flex w-full justify-between gap-3 text-sm" id="{{ params.helpId }}" data-testid="{{ params.testId }}-help">
    <span data-testid="{{ params.testId }}-hint">{{ params.hint }}</span>
    <span class="tabular-nums" aria-hidden="true" data-char-count-value data-testid="{{ params.testId }}-count">{{ params.count }}</span>
  </p>
  <span class="sr-only" role="status" data-char-count-status data-testid="{{ params.testId }}-status"></span>
</do-char-count>
