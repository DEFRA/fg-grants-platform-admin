{% from "code-text/macro.njk" import codeText %}
{% from "icon/macro.njk" import icon %}
{% from "inline-badge/macro.njk" import inlineBadge %}
{% from "muted/macro.njk" import muted %}
{% from "no-value/macro.njk" import noValue %}
{% from "state-graph/macro.njk" import statusPanelSection, stageFacts, statusRef, setTrigger %}

{# Tailwind only sees class names written literally in this file. #}
{% set monoLink = "link underline-offset-4 decoration-dotted" %}
{% set arrow = "inline-flex gap-1" %}

{# Said aloud only where the code is in more than one stage; the row's title says it everywhere. #}
{% macro bareCode(bare, testId) %}
  {%- if bare and bare.said %} <span class="block text-xs {{ muted }}" data-testid="{{ testId }}-bare-code">matched by status code only ({{ codeText(bare.code) }} in any stage of any phase)</span>{% endif -%}
{% endmacro %}

{% macro runs(processes) %}
  {%- if processes | length %}<span class="{{ muted }}"> · runs </span>{% for process in processes %}{{ codeText(process) }}{% if not loop.last %}<span class="{{ muted }}">, </span>{% endif %}{% endfor %}{% endif -%}
{% endmacro %}

{%- set panel = params.panel -%}
{%- set testId = params.testId -%}
{% if panel.badges | length %}
  <div class="flex flex-wrap items-center gap-2">
    {% for badge in panel.badges %}{{ inlineBadge({ text: badge.label, title: badge.title, srText: badge.title, testId: testId ~ "-badge" }) }}{% endfor %}
  </div>
{% endif %}
{{ stageFacts({ phase: panel.phase, stage: panel.stage, testId: testId ~ "-stage" }) }}
{% for target in panel.undefinedTargets %}
  <div role="alert" class="alert alert-warning alert-soft text-sm" data-testid="{{ testId }}-undefined-target">
    {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
    <span class="min-w-0 break-words">{% if target.onlyWhen %}When {{ target.onlyWhen }}, GAS{% else %}GAS{% endif %} moves the application to {{ codeText(target.position) }}, which this grant doesn't define.</span>
  </div>
{% endfor %}
{% call statusPanelSection({ title: 'Ways in', testId: testId ~ '-ways-in' }) %}
  {% for way in panel.waysIn %}
    <div{% if way.bareCode %} title="matched by status code only"{% endif %} data-testid="{{ testId }}-way-in">
      {%- if way.kind == "move" -%}
        {{ statusRef(way.from) }}
      {%- elif way.kind == "code" -%}
        {{ codeText(way.code) }}
      {%- else -%}
        <span>Any status: GAS accepts this move from every position (no <code>validFrom</code>)</span>
      {%- endif -%}
      {{ runs(way.processes) }}
      {{- bareCode(way.bareCode, testId) }}
    </div>
  {% else %}
    {{ noValue({}) }}
  {% endfor %}
{% endcall %}
{% call statusPanelSection({ title: 'Ways out', testId: testId ~ '-ways-out' }) %}
  {% for way in panel.waysOut %}
    <div class="{{ arrow }}"{% if way.bareCode %} title="matched by status code only"{% endif %} data-testid="{{ testId }}-way-out">
      <span class="shrink-0" aria-hidden="true">→</span>
      <div class="min-w-0">
        {{ statusRef(way.to) }}
        {%- for item in way.triggers %}<span class="{{ muted }}"> · </span>{{ setTrigger(item) }}{% endfor -%}
        {{ runs(way.processes) }}
        {%- if way.untriggered %} <span class="text-warning" data-testid="{{ testId }}-untriggered">· ⚠ nothing in this version triggers this move</span>{% endif -%}
        {{- bareCode(way.bareCode, testId) }}
      </div>
    </div>
  {% else %}
    {{ noValue({}) }}
  {% endfor %}
{% endcall %}
{% call statusPanelSection({ title: 'Triggered by', testId: testId ~ '-triggered-by' }) %}
  {% for item in panel.triggeredBy %}
    <div class="{{ arrow }} items-baseline{% if item.missingStage %} {{ muted }}{% endif %}" data-testid="{{ testId }}-trigger">
      {%- if item.kind == "external" -%}
        {{ inlineBadge({ text: item.source, class: "shrink-0" }) }}
        <span class="min-w-0">{% if item.href %}<a class="{{ monoLink }}" href="{{ item.href }}">{{ codeText(item.code) }}</a>{% else %}{{ codeText(item.code) }}{% endif %} — while the application is in {{ item.stageName }}{% if item.missingStage %}<span class="block" data-testid="{{ testId }}-missing-stage">⚠ applies only to applications still in {{ codeText(item.missingStage) }} from an earlier version: this version has no such stage.</span>{% endif %}</span>
      {%- elif item.kind == "claim" -%}
        {{ inlineBadge({ text: "Claim", class: "shrink-0" }) }}
        <span class="min-w-0"><a class="link" href="{{ item.href }}">Last claim submitted</a> — while the application is at <span title="{{ item.at.position }}">{{ item.at.name }}</span>{% if item.at.stageName %} <span class="{{ muted }}">· {{ item.at.stageName }}</span>{% endif %}</span>
      {%- else -%}
        {{ inlineBadge({ text: "GAS", class: "shrink-0" }) }}
        <span class="min-w-0">{{ codeText(item.process) }} — on entering {{ item.onEntering }}{% if item.onlyWhen %}, when {{ item.onlyWhen }}{% endif %}</span>
      {%- endif -%}
    </div>
  {% else %}
    {% if panel.noTrigger == "initial" %}
      <span data-testid="{{ testId }}-no-trigger">Set on submission (initial status)</span>
    {% elif panel.noTrigger == "nothing" %}
      <span class="text-warning" data-testid="{{ testId }}-no-trigger">Nothing in this version sets this status.</span>
    {% else %}
      {{ noValue({}) }}
    {% endif %}
  {% endfor %}
{% endcall %}
