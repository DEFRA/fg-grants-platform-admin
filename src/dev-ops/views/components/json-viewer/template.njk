{% from "icon/macro.njk" import icon %}

{# Tailwind only sees class names written literally in this file. #}
{% set lines = "[&_[data-line]]:w-9 [&_[data-line]]:shrink-0 [&_[data-line]]:text-right [&_[data-line]]:tabular-nums [&_[data-line]]:text-base-content/30 [&_[data-line]]:before:content-[attr(data-line)] [&_[data-json-line]]:pl-3" %}

{%- set testId = params.testId -%}
<do-json-viewer class="flex flex-col gap-2" data-testid="{{ testId }}-viewer">
  <div class="flex justify-end" hidden data-json-viewer-tools>
    <button class="btn btn-xs" type="button" data-json-viewer-copy data-testid="{{ testId }}-copy"><span data-json-viewer-copy-label>Copy</span><span class="sr-only"> {{ params.label | lower }}</span></button>
  </div>
  <div class="max-h-[30rem] w-full overflow-auto rounded-box border border-base-300 bg-base-200 py-2 font-mono text-sm {{ lines }} focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content" tabindex="0" role="region" aria-label="{{ params.label }}" data-testid="{{ testId }}">
    {%- for row in params.view.rows -%}
      {%- if row.kind == "open" -%}
        <details{% if row.open %} open{% endif %}>
          {#- Not `group-open`: an open ancestor `<details>` would turn it on too. -#}
          <summary class="relative flex min-h-6 cursor-pointer list-none items-center px-3 hover:bg-base-300 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-base-content [&::-webkit-details-marker]:hidden" data-testid="{{ testId }}-fold"><span class="flex" data-testid="{{ testId }}-line"><span data-line="{{ row.number }}" aria-hidden="true"></span><code class="whitespace-pre" data-json-line>{{ row.text }}</code></span><span class="absolute inset-y-0 left-12 flex w-3 items-center justify-end" aria-hidden="true">{{ icon({ name: 'chevron-down', class: 'size-3 -rotate-90 opacity-60 [details[open]>summary_&]:rotate-0' }) }}</span><span class="whitespace-pre [details[open]>summary_&]:hidden" data-testid="{{ testId }}-folded"> <span class="text-base-content/60">{{ row.size }}</span> {{ row.closing }}</span></summary>
      {%- elif row.kind == "end" -%}
        </details>
      {%- else -%}
        <pre class="flex px-3" data-testid="{{ testId }}-line"><span data-line="{{ row.number }}" aria-hidden="true"></span><code data-json-line>{{ row.text }}</code></pre>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <p class="sr-only" aria-live="polite" data-json-viewer-status data-testid="{{ testId }}-copy-status"></p>
</do-json-viewer>
