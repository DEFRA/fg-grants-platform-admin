{# Tailwind only sees class names written literally in this file. #}
{# The neutral dot is drawn in the text colour: daisyUI leaves an uncoloured
   `status` at base-content/20, which is barely there on the light theme, and
   `status-neutral` is near-black in both themes, so it goes the same way on
   the dark one. #}
{% set dots = {
  neutral: "status bg-base-content/80",
  info: "status status-info",
  warning: "status status-warning",
  success: "status status-success",
  error: "status status-error"
} %}
{% set labels = {
  success: "text-base-content/70",
  error: "font-medium"
} %}
{# `badge-soft` is forbidden: it draws the status as text and measured 2.64:1. #}
{% set solids = {
  neutral: "badge badge-neutral",
  info: "badge badge-info",
  warning: "badge badge-warning",
  success: "badge badge-success",
  error: "badge badge-error"
} %}
{%- set text = params.label | default(params.status, true) -%}
{%- if params.variant == "solid" -%}
<span class="{{ solids[params.role] | default("badge badge-neutral", true) }}" title="{{ params.status }}" data-testid="do-status-badge"><span data-testid="do-status-label">{{ text }}{% if params.retrying %} ↻{% endif %}</span></span>
{%- else -%}
<span class="inline-flex items-center gap-1.5 whitespace-nowrap" title="{{ params.status }}" data-testid="do-status-badge"><span class="{{ dots[params.role] | default("status", true) }}" aria-hidden="true" data-testid="do-status-dot"></span><span class="{{ labels[params.role] | default("text-base-content/80", true) }}" data-testid="do-status-label">{{ text }}{% if params.retrying %} ↻{% endif %}</span></span>
{%- endif -%}
