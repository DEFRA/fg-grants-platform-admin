{% from "icon/macro.njk" import icon %}

{# Tailwind only sees class names written literally in this file. #}
{# The menu is the trigger's next sibling, so `:has(+:popover-open)` turns the chevron with no script. #}
{% set chevron = "size-4 shrink-0 opacity-60 transition-transform [:has(+:popover-open)>&]:rotate-180" %}

{# At the foot of the sidebar, so it opens upwards; a popover sits in the top layer, clear of the sidebar's own scrolling. #}
{%- set user = params.user -%}
<div data-testid="do-user">
  <button class="btn btn-ghost btn-sm max-w-44 gap-2 px-2 font-normal" type="button" popovertarget="do-user-panel" aria-label="Account: {{ user.name }}" data-testid="do-user-button">
    <span class="avatar avatar-placeholder" aria-hidden="true"><span class="w-7 rounded-full bg-neutral text-neutral-content"><span class="text-xs">{{ user.initials }}</span></span></span>
    <span class="truncate text-sm">{{ user.name }}</span>
    {{ icon({ name: 'chevron-down', class: chevron }) }}
  </button>
  <ul class="dropdown dropdown-top menu menu-md mb-2 w-56 rounded-box border border-base-300 bg-base-100 p-2 shadow-md" popover id="do-user-panel" aria-label="Account" data-testid="do-user-panel">
    <li class="menu-title">
      <span class="break-words text-base-content" data-testid="do-user-name">{{ user.name }}</span>
      {% if user.email and user.email != user.name %}<span class="break-all font-normal text-base-content/70" data-testid="do-user-email">{{ user.email }}</span>{% endif %}
    </li>
    <li><a class="flex items-center gap-2" href="{{ params.signOutHref }}" data-testid="do-sign-out">{{ icon({ name: 'log-out', class: 'size-4' }) }}Sign out</a></li>
  </ul>
</div>
