{% from "icon/macro.njk" import icon %}
{# Tailwind only sees class names written literally in this file. #}
{%- set toast = params.toast -%}
<do-token-toast class="fixed bottom-6 left-1/2 z-60 flex max-w-[calc(100%-32px)] -translate-x-1/2 items-center gap-3 rounded-[10px] bg-[#18181b] px-4 py-2.5 text-sm text-[#fafafa] shadow-[0_8px_24px_rgba(0,0,0,.2)]"{% if toast.role == "success" %} data-dismiss-after="10000"{% endif %} role="{{ 'status' if toast.role == 'success' else 'alert' }}" data-role="{{ toast.role }}" data-testid="token-toast">
  <p data-toast-message data-testid="token-toast-message">
    {%- for part in toast.parts -%}
      {%- if part.hint -%}<span aria-hidden="true">••••</span><span class="sr-only">ending </span>{{ part.hint }}{%- else -%}{{ part.text }}{%- endif -%}
    {%- endfor -%}
  </p>
  {# A success goes by itself; anything else stays until it is dismissed. #}
  {% if toast.role != "success" %}<button class="-my-1 -mr-2 inline-flex size-7 shrink-0 cursor-pointer items-center justify-center rounded-md hover:bg-white/10" type="button" aria-label="Dismiss" data-toast-dismiss data-testid="token-toast-dismiss">{{ icon({ name: 'x', class: 'size-4' }) }}</button>{% endif %}
</do-token-toast>
