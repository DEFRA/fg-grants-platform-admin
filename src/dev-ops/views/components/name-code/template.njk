{%- from "code-text/macro.njk" import codeText -%}
{%- from "muted/macro.njk" import muted -%}
{#- Tailwind only sees class names written literally in this file. -#}
{%- set codeClass = "text-xs " ~ muted -%}
{%- if not params.name -%}
<span{% if params.testId %} data-testid="{{ params.testId }}"{% endif %}>{{ codeText(params.code) }}</span>
{%- elif params.layout == "stacked" -%}
<span class="flex min-w-0 flex-col"{% if params.testId %} data-testid="{{ params.testId }}"{% endif %}><span data-name>{% if params.href %}<a class="link" href="{{ params.href }}"{% if params.title %} title="{{ params.title }}"{% endif %}>{{ params.name }}</a>{% else %}{{ params.name }}{% endif %}{% if params.note %} <span class="{{ muted }}">· {{ params.note }}</span>{% endif %}</span> <span class="block" data-code>{{ codeText(params.code, codeClass) }}</span></span>
{%- else -%}
<span{% if params.testId %} data-testid="{{ params.testId }}"{% endif %}><span data-name>{{ params.name }}</span> <span data-code>{{ codeText(params.code, codeClass) }}</span></span>
{%- endif -%}
