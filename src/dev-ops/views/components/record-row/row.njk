{% from "event-row/macro.njk" import createdCell, rowClass %}
{% from "status-text/macro.njk" import statusText %}
{% from "./shared.njk" import ref, replaced %}

{% macro time(cell, testId) %}
  {%- if cell -%}
    {{ createdCell({ text: cell.text, instant: cell.instant, precise: cell.precise, clock: cell.clock, testId: testId }) }}
  {%- else -%}
    <td class="text-right"><span class="ml-auto block w-fit font-mono text-sm text-base-content/70" data-testid="{{ testId }}-none">—</span></td>
  {%- endif -%}
{% endmacro %}

{%- set row = params.row -%}
{%- set prefix = params.prefix -%}
<tr{% if row.href %} class="{{ rowClass }}"{% endif %} data-testid="{{ prefix }}-row">
  <td>
    <div class="flex flex-wrap items-center gap-2">
      {{ ref(row, prefix, params.codeKey) }}
      {{ replaced(row, prefix ~ "-replaced") }}
    </div>
  </td>
  {% if params.codeKey %}
    <td><div class="truncate font-mono text-sm" data-testid="{{ prefix }}-{{ params.codeKey }}">{{ row.code }}</div></td>
  {% endif %}
  {% if params.detailed !== false %}
    <td class="overflow-hidden" data-testid="{{ prefix }}-status">{{ statusText({ statusLabel: row.statusLabel, positionLabel: row.positionLabel, testId: prefix ~ "-status-label" }) }}</td>
    {% if params.showClosed %}{{ time(row.closed, prefix ~ "-closed") }}{% endif %}
    {{ time(row.created, prefix ~ "-created") }}
  {% endif %}
</tr>
