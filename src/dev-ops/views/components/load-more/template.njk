{# Fallback for no script AND for an element that cannot run: the element hides this link only once it is watching. #}
{%- set id = params.id -%}
{%- set rows = params.rows | default(id ~ "-rows", true) -%}
<do-load-more class="flex flex-col items-center"{% if params.nextHref %} data-next-page="{{ params.nextHref }}"{% endif %} data-rows="{{ rows }}" data-row-link="{{ params.rowLink }}" data-page-empty="[data-testid=&quot;{{ id }}-empty&quot;]"{% if params.outage %} data-page-outage="{{ params.outage }}"{% endif %}{% if params.partial %} data-page-partial="{{ params.partial }}"{% endif %} data-noun-many="{{ params.nounMany }}" data-noun-one="{{ params.nounOne }}" data-testid="{{ id }}-load-more">
  {% if params.nextHref %}<a class="btn btn-sm btn-wide my-3" href="{{ params.nextHref }}" data-load-more-link data-testid="{{ id }}-load-more-link">More<span class="sr-only"> {{ params.nounMany }}</span></a>{% endif %}
  <span class="loading loading-spinner loading-sm my-3" aria-hidden="true" hidden data-load-more-spinner data-testid="{{ id }}-load-more-spinner"></span>
  <p class="my-3 text-sm text-base-content/70"{% if params.nextHref %} hidden{% endif %} data-load-more-end data-testid="{{ id }}-load-more-end">No more {{ params.nounMany }}</p>
  <p class="my-3 text-sm text-base-content/70" hidden data-load-more-partial data-testid="{{ id }}-load-more-partial"></p>
  <p class="mt-3 text-sm text-error" role="alert" hidden data-load-more-error data-testid="{{ id }}-load-more-error"></p>
  <button class="btn btn-sm my-3" type="button" hidden data-load-more-retry data-testid="{{ id }}-load-more-retry">Retry</button>
  <p class="sr-only" aria-live="polite" data-load-more-status data-testid="{{ id }}-load-more-status"></p>
  <div class="h-px w-full" aria-hidden="true" data-load-more-sentinel data-testid="{{ id }}-load-more-sentinel"></div>
</do-load-more>
