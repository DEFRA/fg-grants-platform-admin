{%- from "../../../core/macros.njk" import attrs -%}
{%- from "../../atoms/button/macro.njk" import Button -%}
{%- from "../../atoms/icon-button/macro.njk" import IconButton -%}
<au-copy data-value="{{ p.value }}"{{ attrs(p) }}>{% if p.text %}{{ Button({ text: p.text, iconStart: 'copy', size: p.size or 'sm', attributes: { 'data-au-copy': true } }) }}{% else %}{{ IconButton({ icon: 'copy', label: p.label or 'Copy', size: p.size or 'xs', attributes: { 'data-au-copy': true } }) }}{% endif %}</au-copy>
