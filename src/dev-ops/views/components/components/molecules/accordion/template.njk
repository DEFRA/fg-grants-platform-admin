{%- from "../../../core/macros.njk" import attrs, cls -%}
<au-accordion{% if p.single %} data-single{% endif %}{% if p.headingLevel %} data-heading-level="{{ p.headingLevel }}"{% endif %}><div class="{{ cls('au-accordion' ~ (' au-accordion-framed' if p.framed else '') ~ (' au-accordion-sm' if p.size == 'sm' else ''), p) }}"{{ attrs(p) }}>{{ caller() }}</div></au-accordion>
