{%- from "../../../core/macros.njk" import attrs, cls -%}
{%- set id = p.id or auId('au-menu') -%}
  <au-dropdown class="{{ cls('au-dropdown', p) }}"{% if p.align %} data-align="{{ p.align }}"{% endif %}{% if p.placement %} data-placement="{{ p.placement }}"{% endif %}{{ attrs(p) }}>
    <button type="button" class="{{ p.triggerClasses }}" popovertarget="{{ id }}" aria-haspopup="menu"{% if p.triggerLabel %} aria-label="{{ p.triggerLabel }}"{% endif %}{% if p.triggerTitle %} title="{{ p.triggerTitle }}"{% endif %}{% if p.triggerTestId %} data-testid="{{ p.triggerTestId }}"{% endif %}{% if p.triggerHidden %} hidden{% endif %}{% for k, v in p.triggerAttributes %} {{ k }}="{{ v }}"{% endfor %}>{{ p.trigger | safe }}</button>
    <div class="au-float au-dropdown-pop" popover id="{{ id }}"{% if p.panelTestId %} data-testid="{{ p.panelTestId }}"{% endif %}>
      <div class="au-menu{{ ' au-menu-' ~ p.menuWidth if p.menuWidth }}" role="{{ p.menuRole or 'menu' }}"{% if p.menuLabel %} aria-label="{{ p.menuLabel }}"{% endif %}>{{ p.menuHtml | safe if p.menuHtml else (caller() if caller) }}</div>
    </div>
  </au-dropdown>
