{%- from "../../../core/macros.njk" import attrs, cls, body -%}
{%- from "../../atoms/icon/macro.njk" import Icon -%}
<div class="{{ cls('au-empty' ~ (' au-empty-compact' if p.compact else ''), p) }}"{{ attrs(p) }}>
    {%- if p.icon %}<span class="au-empty-icon">{{ Icon({ name: p.icon, size: 'xl' }) }}</span>{% endif -%}
    <p class="au-empty-title"{% if p.titleTestId %} data-testid="{{ p.titleTestId }}"{% endif %}>{{ p.title }}</p>
    {%- if p.text or p.html or caller %}<p class="au-empty-body"{% if p.bodyTestId %} data-testid="{{ p.bodyTestId }}"{% endif %}>{{ body(p, caller) }}</p>{% endif -%}
    {%- if p.actions %}<div class="au-empty-actions">{{ p.actions | safe }}</div>{% endif -%}
  </div>
