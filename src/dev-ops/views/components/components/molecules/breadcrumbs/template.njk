{%- from "../../../core/macros.njk" import attrs, cls -%}
{%- from "../../atoms/icon/macro.njk" import Icon -%}
{%- from "../../atoms/link/macro.njk" import Link -%}
<nav class="{{ cls('au-breadcrumbs', p) }}" aria-label="{{ p.label or 'Breadcrumbs' }}"{{ attrs(p) }}><ol>
    {%- for it in p.items -%}
      <li>{% if loop.last %}<span aria-current="page">{{ it.text }}</span>{% elif it.href %}{{ Link({ text: it.text, href: it.href, subtle: true, size: 'sm' }) }}{% else %}<a class="au-link au-link-subtle au-link-sm"><span>{{ it.text }}</span></a>{% endif %}
        {%- if not loop.last %}{{ Icon({ name: 'chevron-right', size: 'xs', classes: 'au-breadcrumbs-sep au-dir-icon' }) }}{% endif %}</li>
    {%- endfor -%}
  </ol></nav>
