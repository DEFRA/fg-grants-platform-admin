{%- from "../../../core/macros.njk" import attrs, iconTemplate -%}
{%- from "../../atoms/button/macro.njk" import Button -%}
{%- from "../../atoms/icon/macro.njk" import Icon -%}
{%- set id = p.id or auId('au-range') -%}
  {%- set text = p.value or (auFormatRange(p.start, p.end) if (p.start and p.end) else (p.allLabel or 'Any time')) -%}
  {%- set isSet = p.value or (p.start and p.end) -%}
  <au-date-range-chip{% if p.min %} data-min="{{ p.min }}"{% endif %}{% if p.max %} data-max="{{ p.max }}"{% endif %}{% if p.hint %} data-hint="{{ p.hint }}"{% endif %}{{ attrs(p) }}><div class="au-dropdown">
    <button type="button" class="au-chip{{ ' is-set' if isSet }}" popovertarget="{{ id }}" aria-haspopup="dialog"><span class="au-chip-label">{{ p.label }}:</span><span class="au-chip-value">{{ text }}</span>{{ Icon({ name: 'chevron-down', size: 'sm', classes: 'au-chevron' }) }}</button>
    <div class="au-float au-popover au-popover-padded" popover id="{{ id }}" role="dialog" aria-label="{{ p.label }}"><div class="au-range">
      <div class="au-range-presets" role="group" aria-label="Quick ranges">
        {%- for pr in p.presets -%}
          {%- if pr.href %}<a class="au-btn au-btn-{{ 'secondary' if pr.checked else 'tertiary' }} au-btn-sm" href="{{ pr.href }}"{% if pr.checked %} aria-current="true"{% endif %}><span>{{ pr.text }}</span></a>
          {%- else %}<button type="submit" class="au-btn au-btn-{{ 'secondary' if pr.checked else 'tertiary' }} au-btn-sm" name="{{ p.name }}" value="{{ pr.value }}"{% if p.form %} form="{{ p.form }}"{% endif %} aria-pressed="{{ 'true' if pr.checked else 'false' }}"><span>{{ pr.text }}</span></button>{% endif -%}
        {%- endfor -%}
      </div>
      {%- if p.startName and p.endName -%}
        <div class="au-range-cal">
          {%- if not p.form %}<form method="get"{% if p.action %} action="{{ p.action }}"{% endif %} class="au-stack au-gap-sm">{% for f in p.hidden %}<input type="hidden" name="{{ f.name }}" value="{{ f.value }}">{% endfor %}{% else %}<div class="au-stack au-gap-sm">{% endif -%}
            <label class="au-label au-label-sm au-range-native-label">From <input type="date" data-au-range="start" name="{{ p.startName }}" value="{{ p.start or '' }}"{% if p.form %} form="{{ p.form }}"{% endif %}{% if p.min %} min="{{ p.min }}"{% endif %}{% if p.max %} max="{{ p.max }}"{% endif %}></label>
            <label class="au-label au-label-sm au-range-native-label">To <input type="date" data-au-range="end" name="{{ p.endName }}" value="{{ p.end or '' }}"{% if p.form %} form="{{ p.form }}"{% endif %}{% if p.min %} min="{{ p.min }}"{% endif %}{% if p.max %} max="{{ p.max }}"{% endif %}></label>
            {{- Button({ text: 'Apply', size: 'sm', type: 'submit', form: p.form }) -}}
          {%- if not p.form %}</form>{% else %}</div>{% endif -%}
        </div>
      {%- endif -%}
    </div></div>
  </div>{{ iconTemplate({ names: ['chevron-left', 'chevron-right', 'chevron-down'] }) }}</au-date-range-chip>
