{%- from "../../../core/macros.njk" import attrs, cls, iconTemplate -%}
{%- from "../../atoms/icon/macro.njk" import Icon -%}
<au-theme-toggle{% if p.cookie %} data-cookie="{{ p.cookie }}"{% endif %}><label class="{{ cls('au-theme', p) }}" title="{{ p.label or 'Dark theme' }}"{{ attrs(p) }}><input type="checkbox" aria-label="{{ p.label or 'Dark theme' }}"{% if p.theme == 'dark' %} checked{% endif %}>{% set dark = p.theme == 'dark' %}<span class="au-theme-knob" aria-hidden="true">{{ Icon({ name: 'moon' if dark else 'sun', size: 'xs' }) }}</span><span class="au-theme-other" aria-hidden="true">{{ Icon({ name: 'sun' if dark else 'moon', size: 'xs' }) }}</span></label>{{ iconTemplate({ names: ['sun', 'moon'] }) }}</au-theme-toggle>
