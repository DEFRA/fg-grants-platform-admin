{%- from "../../../core/macros.njk" import attrs, cls -%}
<li class="{{ cls('au-timeline-item', p) }}"{{ attrs(p) }}>
    {%- if p.mark %}<span class="au-timeline-icon">{{ p.mark | safe }}</span>{% else %}<span class="au-timeline-mark au-dot-{{ p.tone or 'neutral' }}" aria-hidden="true"></span>{% endif -%}
    <div class="au-timeline-body">
      <div class="au-timeline-head"><span class="au-timeline-title">{{ p.titleHtml | safe if p.titleHtml else p.title }}</span>{% if p.meta or p.metaHtml %}<span class="au-timeline-meta">{{ p.metaHtml | safe if p.metaHtml else p.meta }}</span>{% endif %}</div>
      {%- if caller %}<div class="au-timeline-content">{{ caller() }}</div>{% endif -%}
    </div>
  </li>
