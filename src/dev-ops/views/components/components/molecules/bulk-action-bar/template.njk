{%- from "../../../core/macros.njk" import attrs, cls -%}
{%- from "../../atoms/link/macro.njk" import Link -%}
<div class="{{ cls('au-bulkbar', p) }}" role="region" aria-label="{{ p.count }} selected"{{ attrs(p) }}><span class="au-bulkbar-count">{{ p.count }} selected</span><div class="au-actions au-actions-sm">{{ p.actions | safe }}</div>{% if p.clearHref %}{{ Link({ text: 'Clear selection', href: p.clearHref, size: 'sm' }) }}{% endif %}</div>
