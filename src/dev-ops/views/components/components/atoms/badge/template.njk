{%- from "../../../core/macros.njk" import attrs, cls, body -%}
{%- from "../../atoms/icon/macro.njk" import Icon -%}
<span class="{{ cls('au-badge' ~ (' au-badge-sm' if p.size == 'sm' else '') ~ ' au-badge-' ~ (p.tone or 'neutral') ~ (' au-badge-outline' if p.variant == 'outline' else '') ~ (' au-mono' if p.mono else ''), p) }}"{% if p.title %} title="{{ p.title }}"{% endif %}{{ attrs(p) }}>{% if p.icon %}{{ Icon({ name: p.icon, size: 'xs' }) }}{% endif %}{{ body(p, caller) }}</span>
