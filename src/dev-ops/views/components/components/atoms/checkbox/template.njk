{%- from "../../../core/macros.njk" import attrs, cls -%}
{%- from "../../atoms/icon/macro.njk" import Icon -%}
{%- set id = p.id or auId('cb') -%}
  <label class="{{ cls('au-check' ~ (' au-check-sm' if p.size == 'sm' else '') ~ (' is-disabled' if p.disabled else ''), p) }}" for="{{ id }}"{{ attrs(p) }}><input id="{{ id }}" type="checkbox" class="au-check-input"{% if p.name %} name="{{ p.name }}"{% endif %}{% if p.value is defined %} value="{{ p.value }}"{% endif %}{% if p.checked %} checked{% endif %}{% if p.disabled %} disabled{% endif %}{% if p.indeterminate %} data-au-indeterminate{% endif %}{% if not (p.label or p.html) and p.ariaLabel %} aria-label="{{ p.ariaLabel }}"{% endif %}{% if p.describedBy %} aria-describedby="{{ p.describedBy }}"{% endif %}{% if p.invalid %} aria-invalid="true"{% endif %}{% for k, v in p.inputAttributes %} {{ k }}="{{ v }}"{% endfor %}><span class="au-check-box" aria-hidden="true">{{ Icon({ name: 'minus' if p.indeterminate else 'check', size: 'xs', strokeWidth: 3 }) }}</span>{% if p.label or p.html %}<span>{{ p.html | safe if p.html else p.label }}</span>{% endif %}</label>
