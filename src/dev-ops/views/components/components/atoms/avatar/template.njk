{%- from "../../../core/macros.njk" import attrs, cls -%}
{%- set words = (p.name or '').split(' ') -%}
  {%- set initials = ((words[0] | first) ~ ((words | last | first) if words | length > 1 else '')) | upper -%}
  <span class="{{ cls('au-avatar au-avatar-' ~ (p.size or 'md'), p) }}"{% if p.decorative %} aria-hidden="true"{% else %} role="img" aria-label="{{ p.name }}"{% endif %}{{ attrs(p) }}><span class="au-avatar-initials">{{ initials }}</span></span>
