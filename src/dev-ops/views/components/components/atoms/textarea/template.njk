{%- from "../../../core/macros.njk" import attrs, cls -%}
<textarea{% if p.id %} id="{{ p.id }}"{% endif %} class="{{ cls('au-textarea' ~ (' au-mono' if p.mono else '') ~ (' is-invalid' if p.invalid else ''), p) }}"{% if p.name %} name="{{ p.name }}"{% endif %} rows="{{ p.rows or 3 }}"{% if p.mono %} spellcheck="false" wrap="off"{% endif %}{% if p.invalid %} aria-invalid="true"{% endif %}{% if p.describedBy %} aria-describedby="{{ p.describedBy }}"{% endif %}{% if p.label %} aria-label="{{ p.label }}"{% endif %}{% if p.labelledBy %} aria-labelledby="{{ p.labelledBy }}"{% endif %}{% if p.readonly %} readonly{% endif %}{% if p.maxlength %} maxlength="{{ p.maxlength }}"{% endif %}{% if p.placeholder %} placeholder="{{ p.placeholder }}"{% endif %}{{ attrs(p) }}>
{{ p.value }}</textarea>
