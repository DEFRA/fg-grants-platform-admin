{%- from "../../../core/macros.njk" import attrs, cls, body -%}
{%- from "../../atoms/icon-button/macro.njk" import IconButton -%}
<span class="{{ cls('au-tag' ~ (' au-tag-sm' if p.size == 'sm' else ''), p) }}"{{ attrs(p) }}><span class="au-tag-label{{ ' au-mono' if p.mono }}">{{ body(p, caller) }}</span>
    {%- if p.removeHref -%}{{ IconButton({ icon: 'x', size: 'xs', label: p.removeLabel or 'Remove', href: p.removeHref, classes: 'au-tag-remove', testId: p.removeTestId, title: false }) }}
    {%- elif p.removeName -%}{{ IconButton({ icon: 'x', size: 'xs', label: p.removeLabel or 'Remove', type: 'submit', name: p.removeName, value: p.removeValue, form: p.removeForm, classes: 'au-tag-remove', testId: p.removeTestId, title: false }) }}
    {%- endif -%}
  </span>
