{%- from "../../../core/macros.njk" import attrs, cls, body -%}
<span class="{{ cls('au-status' ~ (' au-status-sm' if p.size == 'sm' else ''), p) }}"{% if p.title %} title="{{ p.title }}"{% endif %}{{ attrs(p) }}><span class="au-dot au-dot-{{ p.tone or 'neutral' }}" aria-hidden="true"></span>{% if p.text or p.html or caller %}<span>{{ body(p, caller) }}</span>{% endif %}</span>
