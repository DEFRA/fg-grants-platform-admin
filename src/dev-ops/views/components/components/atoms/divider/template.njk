{%- from "../../../core/macros.njk" import attrs, cls -%}
{%- set p = p or {} -%}{% if p.vertical %}<span class="{{ cls('au-divider-v', p) }}" role="separator" aria-orientation="vertical"{{ attrs(p) }}></span>{% else %}<hr class="{{ cls('au-divider' ~ (' au-divider-strong' if p.strong else ''), p) }}"{{ attrs(p) }}>{% endif %}
