{% from "icon/macro.njk" import icon %}

{# Tailwind only sees class names written literally in this file. #}
{% set factLabel = "text-sm font-medium text-base-content/70" %}
{% set monoValue = "font-mono text-sm leading-none break-all" %}
{% set monoMuted = "font-mono text-sm leading-none text-base-content/70" %}
{% set monoTime = "font-mono text-sm leading-none tabular-nums whitespace-nowrap" %}
{% set factList = "grid grid-cols-1 content-start gap-x-6 gap-y-3 sm:grid-cols-[8rem_minmax(0,1fr)]" %}

{% macro factValue(fact, testId) %}
  {%- if fact.kind == "mono" -%}
    {% if fact.href %}<a class="link {{ monoValue }}" href="{{ fact.href }}" data-testid="{{ testId }}">{{ fact.text }}</a>{% else %}<span class="{{ monoValue }}" data-testid="{{ testId }}">{{ fact.text }}</span>{% endif %}{% if fact.from %} <span class="{{ monoMuted }}" data-testid="{{ testId }}-from">from {{ fact.from }}</span>{% endif %}
  {%- elif fact.kind == "date" and fact.instant -%}
    <time class="{{ monoTime }}" datetime="{{ fact.instant }}" data-testid="{{ testId }}">{{ fact.text }}</time>
  {%- elif fact.kind == "date" -%}
    {# Stored but empty: said as such, so it never reads as missing. #}
    <span class="{{ monoMuted }}" data-testid="{{ testId }}">{{ fact.text if fact.text else '""' }}</span>
  {%- elif fact.kind == "link" -%}
    <a class="link" href="{{ fact.href }}" target="_blank" rel="noopener noreferrer" data-testid="{{ testId }}">{{ fact.text }}<span class="sr-only"> (opens in a new tab)</span></a>{{ icon({ name: 'external-link', class: 'inline size-3.5 align-middle opacity-50' }) }}
  {%- elif fact.kind == "codes" -%}
    <span data-testid="{{ testId }}">{% for code in fact.codes %}<span class="{{ monoValue }}">{{ code }}</span>{% if not loop.last %}<span class="text-base-content/40">, </span>{% endif %}{% endfor %}</span>
  {%- else -%}
    <span data-testid="{{ testId }}">{{ fact.text }}</span>
  {%- endif -%}
{% endmacro %}

<section class="card card-border bg-base-100" aria-label="{{ params.label }}" data-testid="{{ params.testId }}-overview">
  <div class="card-body p-5">
    {# Two lists, not one grid: auto-placement never goes backwards, so the right-hand facts would stack below the left. #}
    <div class="grid gap-x-6 gap-y-3 text-sm lg:grid-cols-2" data-testid="{{ params.testId }}-facts">
      {% for column in params.facts %}
        <dl class="{{ factList }}">
          {% for fact in column %}
            <div class="contents" data-testid="{{ params.testId }}-fact-{{ fact.id }}">
              <dt class="{{ factLabel }}">{{ fact.label }}</dt>
              <dd class="min-w-0">{{ factValue(fact, params.testId ~ "-" ~ fact.id) }}</dd>
            </div>
          {% endfor %}
        </dl>
      {% endfor %}
    </div>
  </div>
</section>
