{% from "code-text/macro.njk" import codeText %}
{% from "icon/macro.njk" import icon %}
{% from "muted/macro.njk" import muted %}
{% from "no-value/macro.njk" import noValue %}
{% from "status-badge/macro.njk" import statusBadge %}
{% from "./macro.njk" import codes, fact, factList %}

{# Tailwind only sees class names written literally in this file. #}
{% set monoValue = "text-sm" %}
{# A link keeps the line's own height, so its underline sits on the label's baseline. #}
{% set monoLink = "link text-sm" %}
{% set monoMuted = "font-mono text-sm leading-none " ~ muted %}
{% set monoTime = "font-mono text-sm leading-none tabular-nums" %}

{% macro factValue(fact, testId, draw) %}
  {%- if fact.kind == "mono" -%}
    {% if fact.href %}<a class="{{ monoLink }}" href="{{ fact.href }}" data-testid="{{ testId }}">{{ codeText(fact.text) }}</a>{% else %}<span class="{{ monoValue }}" data-testid="{{ testId }}">{{ codeText(fact.text) }}</span>{% endif %}{% if fact.from %} <span class="{{ monoMuted }}" data-testid="{{ testId }}-from">from {{ fact.from }}</span>{% endif %}
  {%- elif fact.kind == "date" and fact.instant -%}
    <time class="{{ monoTime }}" datetime="{{ fact.instant }}" data-testid="{{ testId }}">{{ fact.text }}</time>
  {%- elif fact.kind == "date" -%}
    {# Stored but empty: said as such, so it never reads as missing. #}
    <span class="{{ monoMuted }}" data-testid="{{ testId }}">{{ fact.text if fact.text else '""' }}</span>
  {%- elif fact.kind == "link" -%}
    <a class="link" href="{{ fact.href }}" target="_blank" rel="noopener noreferrer" data-testid="{{ testId }}">{{ fact.text }}<span class="sr-only"> (opens in a new tab)</span></a>{{ icon({ name: 'external-link', class: 'inline size-3.5 align-middle opacity-50' }) }}
  {%- elif fact.kind == "codes" -%}
    <span data-testid="{{ testId }}">{{ codes(fact.codes) }}</span>
  {%- elif fact.kind == "lines" -%}
    <span class="flex flex-col gap-1" data-testid="{{ testId }}">
      {%- for line in fact.lines -%}
        <span class="flex flex-wrap items-baseline gap-x-1.5" data-testid="{{ testId }}-line"><span>{{ line.label }}</span>
          {% if line.codes | length %} <span>{% for code in line.codes %}{{ codeText(code, "text-sm") }}{% if not loop.last %}<span class="text-base-content/40">, </span>{% endif %}{% endfor %}</span>{% endif %}
          {% for badge in line.badges %} <span class="{{ muted }}" aria-hidden="true">·</span> {{ statusBadge(badge) }}{% endfor %}
          {% if line.note %} <span class="{{ muted }}" data-testid="{{ testId }}-note">· {{ line.note }}</span>{% endif %}
        </span>
      {%- endfor -%}
    </span>
  {%- elif fact.kind == "none" -%}
    {{ noValue({ testId: testId }) }}
  {%- elif draw -%}
    {{ draw(fact) }}
  {%- else -%}
    <span data-testid="{{ testId }}">{{ fact.text }}</span>{% if fact.note %} <span class="{{ muted }}" data-testid="{{ testId }}-note">· {{ fact.note }}</span>{% endif %}
  {%- endif -%}
{% endmacro %}

{%- set draw = caller -%}
{%- set testId = params.testId -%}
<section class="card card-border bg-base-100"{% if params.title %} aria-labelledby="{{ testId }}-facts-title"{% else %} aria-label="{{ params.label }}"{% endif %} data-testid="{{ testId }}-overview">
  <div class="card-body {{ 'gap-3 ' if params.title }}p-5">
    {% if params.title %}<h2 class="card-title text-base" id="{{ testId }}-facts-title">{{ params.title }}</h2>{% endif %}
    {# Two lists, not one grid: auto-placement never goes backwards, so the right-hand facts would stack below the left. #}
    <div class="grid gap-x-6 gap-y-3 text-sm lg:grid-cols-2" data-testid="{{ testId }}-facts">
      {% for column in params.facts %}
        <dl class="{{ factList }}">
          {% for item in column %}
            {% call fact(item.label, testId ~ "-fact-" ~ item.id) %}{{ factValue(item, testId ~ "-" ~ item.id, draw) }}{% endcall %}
          {% endfor %}
        </dl>
      {% endfor %}
    </div>
  </div>
</section>
