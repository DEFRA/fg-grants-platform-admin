{# Tailwind only sees class names written literally in this file. #}
<do-modal{% if params.open %} data-open{% endif %}{% if params.locked %} data-locked{% endif %} data-testid="{{ params.id }}-modal">
  <dialog class="modal items-start bg-[#18181b]/32 pt-[72px]" id="{{ params.id }}" aria-labelledby="{{ params.id }}-title"{% if params.formError %} aria-describedby="{{ params.id }}-form-error"{% endif %} data-testid="{{ params.id }}">
    <div class="modal-box flex max-h-[calc(100dvh-120px)] w-[min(560px,calc(100%-32px))] max-w-none flex-col rounded-xl p-0 shadow-[0_24px_64px_rgba(0,0,0,.22)]">
      <div class="flex flex-col gap-1 px-6 pt-5 pb-1">
        <h2 class="text-[19px] font-bold focus:outline-none" id="{{ params.id }}-title" tabindex="-1" data-testid="{{ params.id }}-title">{{ params.title }}{% if params.clientId %} <span class="font-['Noto_Sans_Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace] break-all text-base-content/60" data-testid="{{ params.id }}-client">{{ params.clientId }}</span>{% endif %}</h2>
      </div>
      {% if params.formError %}
        <p class="mx-6 mt-3 rounded-lg border border-[#fecaca] bg-[#fef2f2] px-3.5 py-3 text-[13px] leading-normal text-[#7f1d1d] focus:outline-none" id="{{ params.id }}-form-error" role="alert" tabindex="-1" data-modal-error data-reset-remove data-testid="{{ params.id }}-form-error">{{ params.formError }}</p>
      {% endif %}
      {{ body }}
    </div>
    {% if not params.locked %}
      <form method="dialog" class="modal-backdrop"><button type="submit" tabindex="-1">Close</button></form>
    {% endif %}
  </dialog>
</do-modal>
