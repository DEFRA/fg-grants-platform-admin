{% from "code-text/macro.njk" import codeText %}
{% from "icon/macro.njk" import icon %}
{% from "inline-badge/macro.njk" import inlineBadge %}
{% from "muted/macro.njk" import muted %}
{% from "name-code/macro.njk" import nameCode %}
{% from "no-value/macro.njk" import noValue %}
{% from "state-graph/macro.njk" import statusPanelSection, stageFacts, statusRef, setTrigger %}
{% from "status-badge/macro.njk" import statusBadge %}

{# Tailwind only sees class names written literally in this file. #}
{% set arrow = "inline-flex gap-1" %}

{% macro tasksNote(note) %}
  {%- if note.kind == "needs-tasks" -%}
    <span class="block" data-testid="workflow-status-panel-tasks">Hidden from caseworkers until all mandatory tasks in {{ note.stageName }} are complete · <a class="link" href="{{ note.href }}">see tasks ›</a></span>
  {%- elif note.kind == "gas-blocked" -%}
    <span class="block" data-testid="workflow-status-panel-tasks">CW rejects GAS's message while mandatory tasks in {{ note.stageName }} (the case's current stage) are open. After its retries the message goes to CW's inbox as a dead letter, and nothing re-applies it: <a class="link" href="{{ note.href }}">redrive it once the tasks are done ›</a></span>
  {%- else -%}
    <span class="block {{ muted }}" data-testid="workflow-status-panel-tasks">checks tasks: none in this stage, never blocks</span>
  {%- endif -%}
{% endmacro %}

{%- set panel = params -%}
<div class="flex flex-wrap items-center gap-2" data-testid="workflow-status-panel-badges">
  <span class="inline-flex flex-wrap items-center gap-1.5" data-testid="workflow-status-panel-theme">CW shows it as {{ statusBadge({ label: panel.name, status: panel.name, role: panel.role }) }} {{ codeText(panel.theme) }}</span>
  {% for flag in panel.flags %}{{ inlineBadge({ text: flag.label, title: flag.title, srText: flag.title, testId: "workflow-status-panel-flag" }) }} {% endfor %}
</div>
{{ stageFacts({ phase: panel.phase, stage: panel.stage, testId: "workflow-status-panel-stage" }) }}
{% for finding in panel.findings %}
  <div role="alert" class="alert alert-warning alert-soft text-sm" data-testid="workflow-status-panel-finding">
    {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
    <span class="min-w-0 break-words">
      {%- if finding.kind == "dead end" -%}
        <strong class="font-semibold">Dead end:</strong> no action or GAS message moves a case out of this status, and it doesn't close the case. Cases here stay open.
      {%- elif finding.kind == "unreachable" -%}
        <strong class="font-semibold">Unreachable:</strong> no action or GAS move leads here, and it isn't the starting status. A case can only be here if a data fix or migration moved it.
      {%- else -%}
        If GAS is on grant {{ finding.version }} too, after this message GAS is at <strong class="font-semibold">{{ finding.at.name }}</strong> and will next send <strong class="font-semibold">{{ finding.sends.name }}</strong> ({{ codeText(finding.sends.position) }}) {{ setTrigger(finding.when) }}. This status has no move to it, so CW would dead-letter that message.
      {%- endif -%}
    </span>
  </div>
{% endfor %}
{% for item in panel.maySend %}
  <p class="text-sm {{ muted }}" data-testid="workflow-status-panel-may-send">If {{ item.onlyWhen }}, GAS may also send <strong class="font-semibold">{{ item.sends.name }}</strong> ({{ codeText(item.sends.position) }}){% if not item.sends.defined %}, which the grant doesn't define{% endif %}; no move from this status takes that message.</p>
{% endfor %}
{% if panel.waysIn %}
  {% call statusPanelSection({ title: "Ways in", testId: "workflow-status-panel-ways-in" }) %}
    {% if panel.startsHere %}<div data-testid="workflow-status-panel-starts-here">New cases start here</div>{% endif %}
    {% for way in panel.waysIn %}
      <div data-testid="workflow-status-panel-way">
        {{ statusRef(way.from) }}
        {% if way.via.kind == "action" %}
          <span class="block">{{ nameCode({ name: way.via.name, code: way.via.code }) }}</span>
        {% else %}
          <span class="block {{ muted }}">GAS move</span>
        {% endif %}
      </div>
    {% else %}
      {% if not panel.startsHere %}{{ noValue({}) }}{% endif %}
    {% endfor %}
  {% endcall %}
{% endif %}
{% call statusPanelSection({ title: "Ways out", testId: "workflow-status-panel-ways-out" }) %}
  {% for way in panel.waysOut %}
    <div class="{{ arrow }}" data-testid="workflow-status-panel-way">
      <span class="shrink-0" aria-hidden="true">→</span>
      <div class="min-w-0">
        {{ statusRef(way.to) }}
        <span class="block">
          {%- if way.move.kind == "action" -%}
            {{ nameCode({ name: way.move.name, code: way.move.code }) }}{% if way.tasks and way.tasks.kind == "needs-tasks" %} {{ inlineBadge({ text: "needs tasks", tone: "warning", testId: "workflow-status-panel-needs-tasks" }) }}{% endif %}{% for badge in way.move.badges %} {{ inlineBadge({ text: badge }) }}{% endfor %}
          {%- else -%}
            <span class="{{ muted }}">GAS may send</span>
          {%- endif -%}
        </span>
        {% if way.tasks %}{{ tasksNote(way.tasks) }}{% endif %}
      </div>
    </div>
  {% else %}
    {% if panel.closes %}<span class="{{ muted }}">Closes case</span>{% else %}{{ noValue({}) }}{% endif %}
  {% endfor %}
{% endcall %}
{% call statusPanelSection({ title: "Tells GAS", testId: "workflow-status-panel-tells-gas" }) %}
  {% set tells = panel.tellsGas %}
  {% if tells.kind == "mapped" %}
    <p>CW tells GAS.</p>
    {% for line in tells.lines %}
      {% if line.to %}
        <p data-testid="workflow-status-panel-way">If the application is at GAS stage {{ nameCode({ name: line.stage.name, code: line.stage.code }) }} in {{ nameCode({ name: line.phase.name, code: line.phase.code }) }}, and in a status that move allows, GAS moves it to {% if line.to.href %}<a class="link font-semibold" href="{{ line.to.href }}">{{ line.to.name }}</a>{% else %}<strong class="font-semibold">{{ line.to.name }}</strong>{% endif %} ({{ codeText(line.to.position) }}).</p>
      {% else %}
        <p data-testid="workflow-status-panel-way">If the application is at GAS stage {{ nameCode({ name: line.stage.name, code: line.stage.code }) }} in {{ nameCode({ name: line.phase.name, code: line.phase.code }) }}, GAS ignores it: the target {{ codeText(line.mappedTo) }} is not a PHASE:STAGE:STATUS.</p>
      {% endif %}
    {% endfor %}
    <p>Otherwise GAS ignores it.</p>
  {% elif tells.kind == "ignored" %}
    {{ inlineBadge({ text: "GAS ignores this", title: "The grant has no mapping for this status, so the application doesn't move.", testId: "workflow-status-panel-ignored" }) }}
  {% elif tells.kind == "not-stored" %}
    <span data-testid="workflow-status-panel-not-stored">Grant definition not stored · <a class="link" href="{{ tells.href }}">open grant {{ tells.version }} ›</a></span>
  {% elif tells.kind == "none" %}
    {{ noValue({}) }}
  {% elif tells.text == "start" %}
    <span class="{{ muted }}">Not sent (cases start here)</span>
  {% elif tells.text == "gas-only" %}
    <span class="{{ muted }}">Not sent. Cases only arrive here when GAS moves them, and CW tells GAS only about caseworker actions.</span>
  {% elif tells.text == "no-grant" %}
    <span class="{{ muted }}">No grant</span>
  {% elif tells.text == "unreadable" %}
    <span class="{{ muted }}">Grant definition cannot be read</span>
  {% elif tells.text == "timed-out" %}
    <span class="{{ muted }}">fg-gas-backend did not answer in time</span>
  {% else %}
    <span class="{{ muted }}">Grant could not be read from fg-gas-backend</span>
  {% endif %}
{% endcall %}
