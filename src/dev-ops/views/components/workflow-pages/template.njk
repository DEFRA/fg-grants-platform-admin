{% from "code-text/macro.njk" import codeText %}
{% from "inline-badge/macro.njk" import inlineBadge %}
{% from "muted/macro.njk" import muted %}
{% from "no-value/macro.njk" import noValue %}
{% from "workflow-pages/action-cell.njk" import actionCell %}

{# Tailwind only sees class names written literally in this file. #}
{% set card = "card card-border mt-4 bg-base-100 first:mt-0" %}
{% set monoMuted = "font-mono text-sm " ~ muted %}
{% set factLabel = "text-sm font-medium " ~ muted %}
{% set note = "mt-0.5 text-sm " ~ muted %}

{% macro storedText(value) %}
  {%- if value.kind == "value" -%}
    {{ codeText(value.text, "text-sm") }}
  {%- elif value.kind == "empty" -%}
    <span class="{{ monoMuted }}">{{ value.text }}</span>
  {%- else -%}
    {{ noValue({}) }}
  {%- endif -%}
{% endmacro %}

{%- set tab = params.tab -%}
{%- set testId = params.testId -%}
{%- set environment = params.environment -%}
<div data-testid="{{ testId }}">
  <section class="{{ card }}" aria-labelledby="{{ testId }}-banner-title" data-testid="{{ testId }}-banner">
    <div class="card-body gap-3 p-5">
      <h2 class="card-title text-base" id="{{ testId }}-banner-title">Case banner</h2>
      <dl id="banner" class="grid grid-cols-[minmax(6rem,8rem)_minmax(0,1fr)] gap-x-4 gap-y-3 text-sm">
        <dt class="{{ factLabel }}">Heading from</dt>
        <dd class="min-w-0" data-testid="{{ testId }}-title">{{ storedText(tab.banner.title) }}</dd>
        <dt class="{{ factLabel }}">Buttons</dt>
        <dd class="min-w-0" data-testid="{{ testId }}-buttons">
          {%- for call in tab.banner.buttons -%}
            {{ actionCell(call, testId ~ "-button", environment) }}
          {%- else -%}
            {{ noValue({}) }}
          {%- endfor -%}
          <div class="{{ note }}" data-testid="{{ testId }}-buttons-who">Shown to caseworkers with ReadWrite and the workflow's roles.</div>
        </dd>
        {% if tab.banner.summary | length %}
          <dt class="{{ factLabel }}">Summary</dt>
          <dd class="min-w-0">
            <div class="w-full overflow-x-auto">
              <table class="table table-sm w-auto max-w-3xl min-w-[32rem]" data-testid="{{ testId }}-summary">
                <thead>
                  <tr><th scope="col">Key</th><th scope="col">Label</th><th scope="col">Value from</th><th scope="col">Type</th></tr>
                </thead>
                <tbody>
                  {% for row in tab.banner.summary %}
                    <tr class="hover:bg-base-200" data-testid="{{ testId }}-summary-row"><td>{{ codeText(row.key, "text-sm") }}</td><td>{{ row.label }}</td><td>{{ storedText(row.valueFrom) }}</td><td>{{ codeText(row.type, "text-sm") }}</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </dd>
        {% endif %}
      </dl>
    </div>
  </section>

  <section class="{{ card }}" aria-labelledby="{{ testId }}-tabs-title" data-testid="{{ testId }}-tabs">
    <div class="card-body gap-3 p-5">
      <h2 class="card-title text-base" id="{{ testId }}-tabs-title">Case tabs</h2>
      <div class="w-full overflow-x-auto">
        <table class="table w-full min-w-[48rem] table-fixed">
          <colgroup><col class="w-[8%]"><col class="w-[20%]"><col class="w-[24%]"><col class="w-[33%]"><col class="w-[15%]"></colgroup>
          <thead>
            <tr><th scope="col">Order</th><th scope="col">Tab</th><th scope="col">Shown when</th><th scope="col">Calls when opened</th><th scope="col">Components</th></tr>
          </thead>
          <tbody>
            {% for row in tab.tabs %}
              <tr class="hover:bg-base-200 [&>td]:align-top" id="tab-{{ row.key }}" data-testid="{{ testId }}-tab-row">
                <td>{{ codeText(row.order | string, "text-sm") }}</td>
                <td>
                  {{- row.label }}{% if row.builtIn %}{{ inlineBadge({ text: "built in", class: "ml-1.5", testId: testId ~ "-built-in" }) }}{% endif %}
                  {%- if row.customLink %}
                    <div class="{{ note }}" data-testid="{{ testId }}-custom-link">link goes to {% if row.customLink.address %}{{ codeText(row.customLink.address, "text-sm") }}{% else %}an address worked out from the case{% endif %}</div>
                  {%- endif -%}
                </td>
                <td data-testid="{{ testId }}-shown-when">{% if row.shownWhen %}when {{ codeText(row.shownWhen, "text-sm") }} is set and not null, false, 0 or "" (an empty list or object counts as set){% else %}Always{% endif %}</td>
                <td>
                  {%- for call in row.fires -%}
                    {{ actionCell(call, testId ~ "-action", environment) }}
                    <div class="{{ note }} mb-1.5" data-testid="{{ testId }}-action-when">every time the tab opens · result not stored</div>
                  {%- else -%}
                    {{ noValue({}) }}
                  {%- endfor -%}
                </td>
                <td data-testid="{{ testId }}-components">
                  {%- if row.components | length -%}
                    <span title="{{ row.components | join(', ') }}">{{ row.components | length }} component{{ "s" if row.components | length != 1 }}</span>
                  {%- else -%}
                    {{ noValue({}) }}
                  {%- endif -%}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>
