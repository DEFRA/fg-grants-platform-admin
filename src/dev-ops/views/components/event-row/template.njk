{% from "muted/macro.njk" import muted -%}
{% from "status-badge/macro.njk" import statusBadge %}
{% from "./macro.njk" import createdCell, firstCellDeadLetter, rowClass, rowClassDeadLetter %}

{% macro identity(row) %}
  <a href="{{ row.eventHref }}" title="{{ row.eventName.name }}" class="block truncate text-sm font-semibold no-underline after:absolute after:inset-0 focus-visible:outline-none" data-testid="event-link"><span aria-hidden="true" data-testid="event-type-name">{{ row.eventName.name }}</span><span class="sr-only" data-testid="event-link-name">{{ row.eventName.spoken }}, event {{ row.eventId }}</span></a>
  <div class="w-fit max-w-full truncate font-mono text-sm {{ muted }}" aria-hidden="true" data-testid="event-id">{{ row.eventId }}</div>
{% endmacro %}

{% macro statusDetail(row) %}
  {%- if row.latency -%}
    <div class="w-fit truncate pl-3.5 font-mono text-sm tabular-nums {{ muted }}" title="{{ row.latencyTitle }}" data-testid="event-latency">took {{ row.latency }}</div>
  {%- endif -%}
{% endmacro %}

{%- set row = params -%}
  <tr class="{{ rowClassDeadLetter if row.isDeadLetter else rowClass }}" data-testid="event-row">
    <td{% if row.isDeadLetter %} class="{{ firstCellDeadLetter }}"{% endif %}>{{ identity(row) }}</td>
    <td class="overflow-hidden" data-testid="event-status">
      <span class="inline-flex whitespace-nowrap">{{ statusBadge({
        status: row.status,
        label: row.statusLabel,
        role: row.statusRole,
        retrying: row.statusRetrying
      }) }}</span>
      {{ statusDetail(row) }}
    </td>
    {{ createdCell({ text: row.createdAt, instant: row.createdAtInstant, precise: row.createdAtPrecise, clock: row.createdAtClock, testId: "event-created" }) }}
  </tr>
