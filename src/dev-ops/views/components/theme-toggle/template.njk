{% from "icon/macro.njk" import icon %}

{# The checkbox alone switches the theme: daisyUI's .theme-controller applies
   the theme named in `value` through CSS when checked. The do-theme-toggle
   element is enhancement only — it makes the choice survive a reload.

   daisyUI's `toggle`, with the two glyphs as its children: the component
   crossfades whichever one the checkbox is not on, so the control says which
   way it is set and which way it would go without a word beside it. The order
   is load-bearing — the input first, then the unchecked glyph, then the
   checked one. #}
<do-theme-toggle data-testid="do-theme-toggle">
  {# aria-label sits on the input, not the label: a wrapping label names its
     control through its content, and this one has none — aria-label on the
     label element would leave the checkbox nameless. #}
  <label class="toggle text-base-content">
    <input type="checkbox" class="theme-controller" value="dark" aria-label="Dark theme">
    {{ icon({ name: 'sun', class: 'size-4' }) }}
    {{ icon({ name: 'moon', class: 'size-4' }) }}
  </label>
</do-theme-toggle>
