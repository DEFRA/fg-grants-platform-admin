{% from "code-text/macro.njk" import codeText %}
{% from "inline-badge/macro.njk" import inlineBadge %}
{% from "no-value/macro.njk" import noValue %}
{% from "muted/macro.njk" import muted %}
{% from "icon/macro.njk" import icon %}
{% from "words/macro.njk" import words %}

{# Tailwind only sees class names written literally in this file. #}
{% set columns = "sm:grid sm:grid-cols-[minmax(0,2fr)_minmax(0,1.3fr)_minmax(0,1fr)_minmax(0,2.4fr)] sm:gap-3" %}
{# The CSP blocks inline styles, so each level's indent is a class; deeper levels take the last. #}
{% set indents = ["pl-0", "pl-5", "pl-10", "pl-15", "pl-20", "pl-25", "pl-30", "pl-35", "pl-40"] %}
{% set mono = "font-mono text-sm break-words" %}
{% set separator = "text-base-content/40" %}

{%- set testId = params.testId -%}
{%- set would = "" if params.checked else "would be " -%}
<div data-testid="{{ testId }}">
  <div class="{{ columns }} hidden border-b border-base-300 pb-2 text-sm font-semibold {{ muted }}" aria-hidden="true" data-testid="{{ testId }}-head"><span>Property</span><span>Type</span><span>Required</span><span>Constraints</span></div>
  {%- for row in params.rows -%}
    {%- if row.kind == "end" -%}
      </details>
    {%- elif row.kind == "group" -%}
      <div class="border-b border-base-200 pt-4 pb-2 text-sm font-semibold {{ indents[row.indent] }}" data-testid="{{ testId }}-group">{{ words(row.heading) }}</div>
    {%- else -%}
      {%- set field = row.field -%}
      {%- set indent = indents[field.indent] or indents | last -%}
      {%- if row.kind == "open" -%}
        {#- Not daisyUI's collapse: its title is a padded block with the arrow at the far end, and this fold is a grid row with the chevron at the name's indent. -#}
        <details open>
        <summary class="cursor-pointer list-none border-b border-base-200 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-base-content [&::-webkit-details-marker]:hidden" data-testid="{{ testId }}-fold">
      {%- else -%}
        <div class="border-b border-base-200">
      {%- endif -%}
      <div class="{{ columns }} items-start py-2 text-sm" data-testid="{{ testId }}-row">
        <span class="flex min-w-0 items-start gap-1 {{ indent }}">
          {%- if row.kind == "open" -%}
            {{ icon({ name: 'chevron-down', class: 'mt-0.5 size-3.5 shrink-0 -rotate-90 ' ~ muted ~ ' [details[open]>summary_&]:rotate-0' }) }}
          {%- else -%}
            <span class="w-3.5 shrink-0"></span>
          {%- endif -%}
          <span class="min-w-0 break-words">
            <span data-testid="{{ testId }}-name">{{ codeText(field.name) }}</span>{% if field.title %} <span class="{{ muted }}">{{ field.title }}</span>{% endif %}{% if field.closed %} {{ inlineBadge({ text: "closed", title: "Fields not listed under it " ~ (would or "are ") ~ "removed on submission", testId: testId ~ "-closed" }) }}{% endif %}
            {%- if field.from %}<span class="block text-xs {{ muted }}" data-testid="{{ testId }}-from">from {{ words([{ code: field.from }]) }}</span>{% endif -%}
            {%- if field.description %}<span class="block truncate text-xs {{ muted }}" title="{{ field.description }}" data-testid="{{ testId }}-description">{{ field.description }}</span>{% endif -%}
          </span>
        </span>
        <span class="mt-1 ml-4.5 flex flex-wrap items-center gap-x-3 gap-y-1 {{ indent }} sm:contents">
          <span class="sr-only">Type: </span><span class="{{ mono }}" data-testid="{{ testId }}-type">{{ words(field.type) }}</span>
          <span data-testid="{{ testId }}-required">{% if field.required %}Required{% else %}<span class="{{ muted }}">Optional</span>{% endif %}</span>
          <span class="sr-only">Constraints: </span><span class="min-w-0" data-testid="{{ testId }}-constraints">
            {%- for constraint in field.constraints -%}
              {%- if not loop.first %}<span class="{{ separator }}">, </span>{% endif -%}
              <span data-testid="{{ testId }}-constraint">{{ words(constraint) }}</span>
            {%- endfor -%}
            {%- if field.defaultValue !== null -%}
              {%- if field.constraints | length %} {% endif -%}
              {{ inlineBadge({ text: "default " ~ field.defaultValue, title: ("Would be filled" if would else "Filled") ~ " in when missing", testId: testId ~ "-default" }) }}
            {%- elif not field.constraints | length -%}
              {{ noValue({}) }}
            {%- endif -%}
          </span>
        </span>
      </div>
      {%- if row.kind == "open" -%}
        </summary>
      {%- else -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
</div>
