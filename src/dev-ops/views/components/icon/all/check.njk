{# lucide (ISC), `check`, copied verbatim from https://lucide.dev — the root
   element is ours, carrying the caller's classes. The tick on the selected
   item of a filter menu; always decorative, because the item's
   `aria-current` is what says it is selected. #}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"{% if params.class %} class="{{ params.class }}"{% endif %} data-testid="do-icon-check">
  <path d="M20 6 9 17l-5-5"/>
</svg>
