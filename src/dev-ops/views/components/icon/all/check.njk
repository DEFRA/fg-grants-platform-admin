{# The confirmation half of the copy button: the clipboard swaps to this for a
   second and a half, which is the whole of the feedback a copy needs. Same
   grid and stroke as `clipboard`, so the swap changes the glyph and nothing
   else about the button. #}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"{% if params.class %} class="{{ params.class }}"{% endif %} data-testid="do-icon-check">
  <path d="m5 13 4.5 4.5L19 7"/>
</svg>
