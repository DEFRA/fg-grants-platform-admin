{% from "code-text/macro.njk" import codeText %}
{% from "facts-card/macro.njk" import codes, factsCard %}
{% from "icon/macro.njk" import icon %}
{% from "inline-badge/macro.njk" import inlineBadge %}
{% from "mapping-table/macro.njk" import mappingTable, mappingValue %}
{% from "muted/macro.njk" import muted %}
{% from "no-value/macro.njk" import noValue %}
{% from "service-address/macro.njk" import serviceAddress %}

{# Tailwind only sees class names written literally in this file. #}
{% set card = "card card-border mt-4 bg-base-100 first:mt-0" %}
{# The CSP blocks inline styles, so each depth's indent is a class. #}
{% set indents = ["pl-0", "pl-4", "pl-8", "pl-12", "pl-16", "pl-20", "pl-24"] %}
{% set note = "text-sm " ~ muted %}
{% set head = "whitespace-nowrap" %}
{% set pageViewText = "Runs every time the customer opens any page while the agreement is in this state; outputs are not saved." %}

{% macro pageLink(page) %}<a class="link text-sm underline-offset-4 decoration-dotted" href="#page-{{ page }}">{{ codeText(page) }}</a>{% endmacro %}

{% macro stateBadges(state, testId, lockText) %}
  {%- if state.initial %}{{ inlineBadge({ text: "initial", class: "ml-1.5", testId: testId ~ "-initial" }) }}{% endif -%}
  {%- if state.locksVersion %}{{ inlineBadge({ text: "locks version", title: lockText, class: "ml-1.5", testId: testId ~ "-locks-version" }) }}{% endif -%}
{% endmacro %}

{% macro movesTo(action) %}
  {%- if action.stays -%}
    <span class="text-sm {{ muted }}">stays {{ codeText(action.target) }}</span>
  {%- else -%}
    <span class="text-sm">{{ codeText(action.target) }}</span>
  {%- endif -%}
{% endmacro %}

{% macro requires(rules, testId) %}
  {%- for rule in rules -%}
    <div class="text-sm" data-testid="{{ testId }}-rule">{{ codeText(rule.name) }} = {{ codeText(rule.value) }}{% if rule.message %}<div class="{{ note }}">{{ rule.message }}</div>{% endif %}</div>
  {%- else -%}
    {{ noValue({}) }}
  {%- endfor -%}
{% endmacro %}

{% macro runs(action, testId) %}
  {{ codes(action.runs) }}
  {%- if action.sets | length %}<div class="mt-1 text-sm" data-testid="{{ testId }}-sets"><span class="{{ muted }}">Sets</span> {{ codes(action.sets) }}</div>{% endif -%}
{% endmacro %}

{% macro actionName(action) %}
  <span class="text-sm">{{ codeText(action.name) }}</span>{% if action.page %}<div class="{{ note }}">opens page {{ pageLink(action.page) }}</div>{% endif %}
{% endmacro %}

{% macro sends(rows) %}
  {%- for row in rows -%}
    <div class="text-sm {{ indents[row.depth] | default(indents | last) }}">
      {{- codeText(row.field) -}}
      {%- if row.kind == "value" and row.value.kind == "literal" %} = {{ mappingValue(row.value) }}
      {%- elif row.kind == "value" %} <span class="{{ muted }}">←</span> {{ mappingValue(row.value) }}
      {%- elif row.kind == "each" %} <span class="{{ muted }}">for each</span> {{ codeText(row.forEach) }}
      {%- endif -%}
    </div>
  {%- endfor -%}
{% endmacro %}

{%- set tab = params.tab -%}
{%- set testId = params.testId -%}
{%- set environment = params.environment -%}
<div data-testid="{{ testId }}">
  {% if tab.problem !== null %}
    <div role="alert" class="alert alert-error alert-soft text-sm" data-testid="{{ testId }}-problem">
      {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
      <span class="min-w-0 break-words">GAS can't load this agreement definition, so agreements that resolve to it can't be created or progressed. Reason: {{ codeText(tab.problem) }}. Publish a corrected version.{% if tab.failed %} <span data-testid="{{ testId }}-problem-failed">GAS has marked this file unusable. New agreements use the newest usable {{ tab.major }}.x agreement definition at or below {{ tab.version }}; actions before acceptance use the newest usable {{ tab.major }}.x one, which may be later.</span>{% endif %}</span>
    </div>
  {% else %}
    {% call(item) factsCard({ facts: tab.facts, title: "Agreement definition", testId: testId }) %}
      {%- if item.kind == "codes" -%}
        <span data-testid="{{ testId }}-{{ item.id }}">{{ codes(item.codes) }}</span>
      {%- elif item.kind == "created-when" -%}
        the grant runs {{ codeText("GENERATE_OFFER") }} on a Phases move · <a class="link" href="{{ item.href }}">see Phases ›</a>
      {%- else -%}
        {% for endpoint in item.endpoints %}
          <div class="mb-1.5 flex flex-wrap items-baseline gap-x-1.5 text-sm" data-testid="{{ testId }}-endpoint">
            <span>{{ codeText(endpoint.code) }}</span><span class="{{ muted }}" aria-hidden="true">·</span>
            {{- serviceAddress({ method: endpoint.method, path: endpoint.path, url: endpoint.url, service: endpoint.service, unset: endpoint.unset, source: "GAS", environment: environment, testId: testId ~ "-endpoint-address" }) -}}
          </div>
        {% endfor %}
      {%- endif -%}
    {% endcall %}

    {% if tab.missingServiceUrls | length %}
      <div role="alert" class="alert alert-warning alert-soft mt-4 text-sm" data-testid="{{ testId }}-missing-urls">
        {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
        <span class="min-w-0 break-words">
          {%- for name in tab.missingServiceUrls -%}
            {%- if not loop.first %}{{ " and " if loop.last else ", " }}{% endif %}{{ codeText(name) }}
          {%- endfor %} {{ "are" if tab.missingServiceUrls | length > 1 else "is" }} unset in GAS here, and GAS won't load this agreement definition while any service it names has no URL. On this environment, agreements that resolve to it can't be created, and while it is the newest usable {{ tab.major }}.x definition, actions on {{ tab.major }}.x agreements before acceptance fail too (see the States caption).</span>
      </div>
    {% endif %}

    <section class="{{ card }}" aria-labelledby="{{ testId }}-states-title" data-testid="{{ testId }}-states">
      <div class="card-body gap-3 p-5">
        <h2 class="card-title text-base" id="{{ testId }}-states-title">States</h2>
        {% set lockText = "Until an agreement is accepted, GAS runs its actions with the newest usable " ~ tab.major ~ ".x agreement definition, which may not be this one. From accepted on, it stays on the version it was accepted under." %}
        <p class="{{ note }}" data-testid="{{ testId }}-states-caption">Until an agreement is accepted, GAS runs its actions with the newest usable {{ tab.major }}.x agreement definition, which may not be this one. From {{ codeText("accepted") }} on, it stays on the version it was accepted under.</p>
        <ul class="divide-y divide-base-300 sm:hidden" data-testid="{{ testId }}-state-blocks">
          {% for state in tab.states %}
            <li class="py-2 text-sm" data-testid="{{ testId }}-state-block">
              <div class="font-medium">{{ codeText(state.name) }}{{ stateBadges(state, testId ~ "-block", lockText) }}{% if state.page %} <span class="font-normal {{ muted }}">· shows</span> {{ pageLink(state.page) }}{% endif %}</div>
              {% for action in state.actions %}
                <div class="mt-1">{{ codeText(action.name) }} <span class="{{ muted }}">→</span> {% if action.stays %}<span class="{{ muted }}">stays</span> {% endif %}{{ codeText(action.target) }}{% if action.runs | length %} <span class="{{ muted }}">· runs</span> {{ codes(action.runs) }}{% endif %}</div>
              {% else %}
                <div class="mt-1 {{ muted }}">No actions</div>
              {% endfor %}
            </li>
          {% endfor %}
        </ul>
        <div class="hidden w-full overflow-x-auto sm:block">
          <table class="table w-full min-w-[44rem] table-fixed" data-testid="{{ testId }}-states-table">
            <thead>
              <tr>
                <th scope="col" class="{{ head }}">State</th>
                <th scope="col" class="{{ head }}">Shows page</th>
                {% if tab.pageProcesses %}<th scope="col" class="{{ head }}" title="{{ pageViewText }}" data-testid="{{ testId }}-page-view-head">Runs on each page view</th>{% endif %}
                <th scope="col" class="{{ head }}">Action</th>
                <th scope="col" class="{{ head }}">Moves to</th>
                <th scope="col" class="{{ head }}">Requires</th>
                <th scope="col" class="{{ head }}">Runs</th>
              </tr>
            </thead>
            {% for state in tab.states %}
              {% set span = state.actions | length or 1 %}
              <tbody class="border-t border-base-300" data-testid="{{ testId }}-state">
                {% for action in state.actions %}
                  <tr class="hover:bg-base-200 align-top" data-testid="{{ testId }}-state-row">
                    {% if loop.first %}
                      <th scope="rowgroup" rowspan="{{ span }}" class="font-normal"><span class="text-sm">{{ codeText(state.name) }}</span>{{ stateBadges(state, testId, lockText) }}</th>
                      <td rowspan="{{ span }}">{% if state.page %}{{ pageLink(state.page) }}{% else %}{{ noValue({}) }}{% endif %}</td>
                      {% if tab.pageProcesses %}<td rowspan="{{ span }}" title="{{ pageViewText }}">{{ codes(state.pageProcesses) }}</td>{% endif %}
                    {% endif %}
                    <td>{{ actionName(action) }}</td>
                    <td>{{ movesTo(action) }}</td>
                    <td>{{ requires(action.requires, testId) }}</td>
                    <td>{{ runs(action, testId) }}</td>
                  </tr>
                {% else %}
                  <tr class="hover:bg-base-200 align-top" data-testid="{{ testId }}-state-row">
                    <th scope="rowgroup" class="font-normal"><span class="text-sm">{{ codeText(state.name) }}</span>{{ stateBadges(state, testId, lockText) }}</th>
                    <td>{% if state.page %}{{ pageLink(state.page) }}{% else %}{{ noValue({}) }}{% endif %}</td>
                    {% if tab.pageProcesses %}<td title="{{ pageViewText }}">{{ codes(state.pageProcesses) }}</td>{% endif %}
                    <td colspan="4"><span class="text-sm {{ muted }}">No actions</span></td>
                  </tr>
                {% endfor %}
              </tbody>
            {% endfor %}
          </table>
        </div>
      </div>
    </section>

    <section class="{{ card }}" aria-labelledby="{{ testId }}-pages-title" data-testid="{{ testId }}-pages">
      <div class="card-body gap-3 p-5">
        <h2 class="card-title text-base" id="{{ testId }}-pages-title">Pages</h2>
        <div class="w-full overflow-x-auto">
          <table class="table w-full min-w-[32rem] table-fixed" data-testid="{{ testId }}-pages-table">
            <colgroup><col class="w-[22%]"><col></colgroup>
            <thead>
              <tr><th scope="col" class="{{ head }}">Page</th><th scope="col" class="{{ head }}">Title</th></tr>
            </thead>
            <tbody>
              {% for page in tab.pages %}
                <tr class="hover:bg-base-200 align-top" id="page-{{ page.id }}" data-testid="{{ testId }}-page-row">
                  <td><span class="text-sm">{{ codeText(page.id) }}</span></td>
                  <td class="text-sm">
                    <div>{{ page.title }}</div>
                    {% if page.details | length %}
                      <div class="{{ note }}" data-testid="{{ testId }}-page-details">
                        {%- for detail in page.details -%}
                          {%- if not loop.first %} · {% endif -%}
                          <span>
                            {%- if detail.kind == "layout" %}layout {{ codeText(detail.layout) }}
                            {%- elif detail.kind == "watermark" %}Watermark when {{ detail.state }}: {{ detail.text }}
                            {%- elif detail.kind == "print" %}printable
                            {%- elif detail.kind == "contents" %}contents list
                            {%- elif detail.kind == "back" %}back link to {{ codeText(detail.href) }}
                            {%- else %}{{ codeText(detail.id) }}{% if detail.condition %} (shown when {{ codeText(detail.condition) }}){% endif %}
                            {%- endif -%}
                          </span>
                        {%- endfor -%}
                      </div>
                    {% endif %}
                    {% if page.components | length %}<div class="{{ note }}" data-testid="{{ testId }}-page-components">Components: {{ page.components | join(", ") }}</div>{% endif %}
                    {% if page.buttons | length %}
                      <div class="mt-1" data-testid="{{ testId }}-page-buttons">
                        <span class="{{ muted }}">Buttons</span>
                        {% for button in page.buttons %}
                          <div class="{{ 'text-warning' if button.problem else '' }}" data-testid="{{ testId }}-page-button">
                            {%- if button.problem == "no-page" -%}
                              ⚠ {{ codeText(button.action) }} has no page: this button returns an error
                            {%- elif button.problem == "not-in-state" -%}
                              ⚠ {{ codeText(button.action) }} is not an action of {{ codes(button.states) }}: this {{ "form" if button.form else "button" }} returns an error
                            {%- else -%}
                              {{ button.text }} → {{ codeText(button.action) }}{% if button.page %} <span class="{{ muted }}">(page {{ codeText(button.page) }})</span>{% endif %}
                            {%- endif -%}
                          </div>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {% if tab.createdWith | length %}
      <section class="{{ card }}" aria-labelledby="{{ testId }}-created-with-title" data-testid="{{ testId }}-created-with">
        <div class="card-body gap-3 p-5">
          <h2 class="card-title text-base" id="{{ testId }}-created-with-title">Created with</h2>
          {{ mappingTable({ rows: tab.createdWith, testId: testId ~ "-created-with-fields" }) }}
        </div>
      </section>
    {% endif %}

    <section class="{{ card }}" aria-labelledby="{{ testId }}-processes-title" data-testid="{{ testId }}-processes">
      <div class="card-body gap-3 p-5">
        <h2 class="card-title text-base" id="{{ testId }}-processes-title">Processes</h2>
        {% if tab.processes | length %}
          <div class="w-full overflow-x-auto">
            <table class="table w-full min-w-[40rem] table-fixed" data-testid="{{ testId }}-processes-table">
              <colgroup><col class="w-[22%]"><col class="w-[16%]"><col class="w-[36%]"><col class="w-[26%]"></colgroup>
              <thead>
                <tr><th scope="col" class="{{ head }}">Process</th><th scope="col" class="{{ head }}">Type</th><th scope="col" class="{{ head }}">Calls</th><th scope="col" class="{{ head }}">Outputs</th></tr>
              </thead>
              <tbody>
                {% for process in tab.processes %}
                  <tr class="hover:bg-base-200 align-top" data-testid="{{ testId }}-process-row">
                    <td><span class="text-sm">{{ codeText(process.name) }}</span></td>
                    <td class="text-sm" data-testid="{{ testId }}-process-type">{{ process.type }}{% if process.requestsPayment %}<div class="{{ note }}">requests the agreement payment{% if tab.paymentHref %} (<a class="link" href="{{ tab.paymentHref }}">see Payment ›</a>){% endif %}</div>{% endif %}</td>
                    <td>
                      {%- if process.call -%}
                        {{ serviceAddress({ method: process.call.method, path: process.call.path, url: process.call.url, service: process.call.service, unset: process.call.unset, source: "GAS", environment: environment, testId: testId ~ "-process" }) }}
                        {%- if process.sends | length -%}
                          <div class="mt-2" data-testid="{{ testId }}-process-sends"><span class="text-sm {{ muted }}">Sends{% if process.bodyOnGet %} (body sent with a GET){% endif %}</span>{{ sends(process.sends) }}</div>
                        {%- endif -%}
                      {%- else -%}
                        {{ noValue({}) }}
                      {%- endif -%}
                    </td>
                    <td>
                      {%- for output in process.outputs -%}
                        <div class="text-sm" data-testid="{{ testId }}-process-output">{{ codeText(output.field) }} <span class="{{ muted }}">←</span> {{ mappingValue(output.value) }}</div>
                      {%- else -%}
                        {{ noValue({}) }}
                      {%- endfor -%}
                      {%- if process.outputs | length -%}
                        <div class="{{ note }}" data-testid="{{ testId }}-process-lands">
                          {%- for land in process.lands -%}
                            {%- if not loop.first %}; {% endif %}{{ "saved to the agreement" if land == "saved" else "for the page only" }}
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <p class="px-4 py-10 text-center {{ note }}" data-testid="{{ testId }}-no-processes">No processes.</p>
        {% endif %}
      </div>
    </section>
  {% endif %}
</div>
