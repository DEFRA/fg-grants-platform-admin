{% from "event-row/macro.njk" import createdCell, rowClass, rowClassDeadLetter %}
{% from "status-badge/macro.njk" import statusBadge %}
{% from "status-text/macro.njk" import statusText %}

{# Tailwind only sees class names written literally in this file. #}
{% set titleLink = "block truncate text-sm font-semibold no-underline after:absolute after:inset-0 focus-visible:outline-none" %}
{% set titleLinkMono = "block w-fit break-all font-mono text-sm font-semibold no-underline after:absolute after:inset-0 focus-visible:outline-none" %}
{% set titleText = "block truncate text-sm font-semibold" %}
{% set titleTextMono = "block w-fit break-all font-mono text-sm font-semibold" %}

{% macro name(row) %}
  {%- if row.eventName -%}
    <span aria-hidden="true" data-testid="bucket-row-title">{{ row.eventName.name }}</span><span class="sr-only">{{ row.eventName.spoken }}{% if row.subtitle %}, {{ row.subtitle }}{% endif %}</span>
  {%- else -%}
    <span data-testid="bucket-row-title">{{ row.title }}</span>
  {%- endif -%}
{% endmacro %}

{# The whole row is the title's link; a row with no page of its own is no link, so it takes no hover either. #}
{% macro identity(row) %}
  <div class="flex flex-wrap items-center gap-2">
    {% if row.href %}
      <a href="{{ row.href }}" class="{{ titleLinkMono if row.mono else titleLink }}"{% if row.eventName %} title="{{ row.eventName.name }}"{% endif %} data-testid="bucket-row-link">{{ name(row) }}</a>
    {% else %}
      <span class="{{ titleTextMono if row.mono else titleText }}">{{ name(row) }}</span>
    {% endif %}
  </div>
  {% if row.subtitle %}<div class="w-fit max-w-full truncate font-mono text-sm text-base-content/70"{% if row.eventName %} aria-hidden="true"{% endif %} data-testid="bucket-row-subtitle">{{ row.subtitle }}</div>{% endif %}
{% endmacro %}

{% macro cell(item) %}
  {%- set testId = "bucket-cell-" ~ item.key -%}
  {%- if item.kind == "badge" -%}
    <td class="overflow-hidden" data-testid="{{ testId }}"><span class="inline-flex whitespace-nowrap">{{ statusBadge({ status: item.status, label: item.label, role: item.role }) }}</span></td>
  {%- elif item.kind == "position" -%}
    <td class="overflow-hidden" data-testid="{{ testId }}">{{ statusText({ statusLabel: item.statusLabel, positionLabel: item.positionLabel, testId: testId ~ "-label" }) }}</td>
  {%- elif item.kind == "time" -%}
    {{ createdCell({ text: item.time.text, instant: item.time.instant, precise: item.time.precise, clock: item.time.clock, testId: testId }) }}
  {%- elif item.kind == "mono" -%}
    <td><div class="truncate font-mono text-sm" title="{{ item.text }}" data-testid="{{ testId }}">{{ item.text }}</div></td>
  {%- elif item.kind == "text" -%}
    <td><div class="truncate text-sm" title="{{ item.text }}" data-testid="{{ testId }}">{{ item.text }}</div></td>
  {%- elif item.right -%}
    <td class="text-right"><span class="ml-auto block w-fit font-mono text-sm text-base-content/70" data-testid="{{ testId }}-none">—</span></td>
  {%- else -%}
    <td><span class="text-base-content/70" data-testid="{{ testId }}-none">—</span></td>
  {%- endif -%}
{% endmacro %}

{%- set row = params -%}
  <tr{% if row.href %} class="{{ rowClassDeadLetter if row.alarming else rowClass }}"{% elif row.alarming %} class="bg-error/5"{% endif %} data-testid="bucket-row">
    <td>{{ identity(row) }}</td>
    {% for item in row.cells %}{{ cell(item) }}{% endfor %}
    {{ createdCell({ text: row.time.text, instant: row.time.instant, precise: row.time.precise, clock: row.time.clock, testId: "bucket-row-time" }) }}
  </tr>
