{% from "muted/macro.njk" import muted %}
{% from "icon/macro.njk" import icon %}
{% from "inline-badge/macro.njk" import inlineBadge %}
{% from "name-code/macro.njk" import nameCode %}

{# Tailwind only sees class names written literally in this file. Colours are
   classes, not inline styles, which the CSP blocks. #}
{% set edgeStrokes = {
  plain: "stroke-current",
  strong: "stroke-info",
  dashed: "stroke-current",
  dotted: "stroke-current",
  "strong-dotted": "stroke-info"
} %}
{% set nodeStrokes = {
  selected: "stroke-base-content",
  flagged: "stroke-warning",
  plain: "stroke-base-content/25"
} %}
{% set nodeStrokeWidths = { selected: 2, flagged: 2.5, plain: 1 } %}
{# The neutral dot matches status-badge's. #}
{% set dots = {
  neutral: "fill-base-content/80",
  info: "fill-info",
  warning: "fill-warning",
  success: "fill-success",
  error: "fill-error"
} %}
{% set legendBoxes = {
  flagged: "inline-block h-4 w-6 rounded border-2 border-warning",
  "other-phase": "inline-block h-4 w-6 rounded border border-dashed border-base-content/40"
} %}
{% set edgeWidths = { plain: 1.5, strong: 2, dashed: 1.5, dotted: 1.5, "strong-dotted": 2 } %}
{# Moves only GAS can make, or that run no process, are dashed, so their meaning is never colour alone. #}
{% set dash = "4 3" %}
{# A move matched only by a bare status code is dotted. #}
{% set edgeDashes = { dashed: dash, dotted: "1 3", "strong-dotted": "1 3" } %}
{% set scroller = "overflow-x-auto pb-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content" %}

{% macro legend(items, testId) %}
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm font-normal {{ muted }}" data-testid="{{ testId }}-legend">
    {% for item in items %}
      <span class="inline-flex items-center gap-1.5" data-testid="{{ testId }}-legend-item" data-kind="{{ item.kind }}">
        {%- if legendBoxes[item.kind] -%}
          <span class="{{ legendBoxes[item.kind] }}" aria-hidden="true"></span>
        {%- elif item.kind == "colour" -%}
          <span class="status status-info" aria-hidden="true"></span>
        {%- elif item.kind == "start" -%}
          <span aria-hidden="true">{{ inlineBadge({ text: "start" }) }}</span>
        {%- else -%}
          <svg width="28" height="8" aria-hidden="true"><line x1="0" y1="4" x2="28" y2="4" class="{{ edgeStrokes[item.kind] }}" stroke-width="{{ edgeWidths[item.kind] }}"{% if edgeDashes[item.kind] %} stroke-dasharray="{{ edgeDashes[item.kind] }}"{% endif %}/></svg>
        {%- endif -%}
        {{ item.label }}
      </span>
    {% endfor %}
  </div>
{% endmacro %}

{%- set testId = params.testId -%}
{%- set graphs = params.graphs -%}
<do-state-graph class="block">
{% if graphs.duplicated | length %}
  <div role="alert" class="alert alert-warning alert-soft mb-3 text-sm" data-testid="{{ testId }}-duplicates">
    {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
    <div>
      {% for position in graphs.duplicated %}
        <p><span class="font-mono">{{ position }}</span> appears more than once in this definition. The graph shows it once, where it first appears.</p>
      {% endfor %}
    </div>
  </div>
{% endif %}

<div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-[minmax(0,1fr)_24rem]">
  <div class="min-w-0">
    {% for graph in graphs.phases %}
      {% set markerId = testId ~ "-" ~ graph.id %}
      <section class="card card-border mt-4 bg-base-100 first:mt-0" id="phase-{{ graph.code }}" aria-labelledby="{{ markerId }}-title" data-testid="{{ testId }}-phase" data-phase="{{ graph.code }}">
        <div class="card-body gap-3 p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
            <h2 class="card-title min-w-0 text-base break-words" id="{{ markerId }}-title">{{ nameCode({ name: graph.name, code: graph.code, testId: testId ~ "-phase-title" }) }}</h2>
            {% if loop.first %}{{ legend(params.legend, testId) }}{% endif %}
          </div>
          {% if graph.nodes | length %}
            {# The element shows the hint only while the graph is wider than its box. #}
            <p class="flex items-center gap-1.5 text-sm {{ muted }}" id="{{ markerId }}-scroll-hint" hidden data-testid="{{ testId }}-scroll-hint">{{ icon({ name: 'move-horizontal', class: 'size-4 shrink-0' }) }}This graph is wider than its card. Scroll sideways, or tab to it and use the arrow keys, to see every status.</p>
            <div class="{{ scroller }}" tabindex="0" role="region" aria-label="{{ graph.name or graph.code }} statuses" data-graph-scroll data-hint="{{ markerId }}-scroll-hint" data-testid="{{ testId }}-scroller">
              <svg width="{{ graph.width }}" height="{{ graph.height }}" viewBox="0 0 {{ graph.width }} {{ graph.height }}" class="block max-w-none {{ muted }}" data-testid="{{ testId }}-graph">
                <defs>
                  <marker id="{{ markerId }}-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="fill-current"/></marker>
                  <marker id="{{ markerId }}-strong" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="fill-info"/></marker>
                </defs>
                {% for band in graph.bands %}
                  <rect x="{{ band.x }}" y="{{ band.y }}" width="{{ band.width }}" height="{{ band.height }}" rx="10" class="fill-base-200 stroke-base-300" stroke-width="1" data-testid="{{ testId }}-band"/>
                {% endfor %}
                {% for edge in graph.edges %}
                  <path d="{{ edge.d }}" fill="none" class="{{ edgeStrokes[edge.kind] }}" stroke-width="{{ edgeWidths[edge.kind] }}"{% if edgeDashes[edge.kind] %} stroke-dasharray="{{ edgeDashes[edge.kind] }}"{% endif %} marker-end="url(#{{ markerId }}-{{ 'strong' if edge.kind == 'strong' or edge.kind == 'strong-dotted' else 'arrow' }})" data-testid="{{ testId }}-edge" data-kind="{{ edge.kind }}"><title>{{ edge.title }}</title></path>
                {% endfor %}
                {# Drawn after the edges, on a plate, so no edge crosses a label. #}
                {% for band in graph.bands %}
                  <g class="text-base-content" data-band-label data-x="{{ band.x }}" data-room="{{ band.width - band.labelWidth - 8 }}" data-testid="{{ testId }}-band-label">
                    <rect x="{{ band.x + 4 }}" y="{{ band.y + 4 }}" width="{{ band.labelWidth }}" height="18" rx="4" class="fill-base-100"/>
                    <text x="{{ band.x + 10 }}" y="{{ band.y + 17 }}" class="fill-current">{% if band.name %}<tspan font-size="12">{{ band.name }}</tspan><tspan dx="6" font-size="10" opacity="0.7" class="font-mono">{{ band.code }}</tspan>{% else %}<tspan font-size="10" class="font-mono">{{ band.code }}</tspan>{% endif %}</text>
                  </g>
                {% endfor %}
                {% for node in graph.nodes %}
                  <a href="{{ node.href }}" class="group text-base-content" aria-label="{{ node.label }}"{% if node.state == 'selected' %} aria-current="true"{% endif %} data-testid="{{ testId }}-node" data-position="{{ node.position }}">
                    <rect x="{{ node.x }}" y="{{ node.y }}" width="{{ node.width }}" height="{{ node.height }}" rx="8" class="fill-base-100 {{ nodeStrokes[node.state] }} group-focus-visible:stroke-base-content group-focus-visible:[stroke-width:3]" stroke-width="{{ nodeStrokeWidths[node.state] }}"{% if node.kind == 'other-phase' %} stroke-dasharray="{{ dash }}"{% endif %}/>
                    {%- if node.kind == 'other-phase' -%}
                      <text x="{{ node.textX }}" y="{{ node.textY }}" font-size="11" class="fill-current">{{ node.name }}</text>
                    {%- else -%}
                      {%- if node.dot -%}
                        <circle cx="{{ node.dot.x }}" cy="{{ node.dot.y }}" r="4" class="{{ dots[node.tone] }}"/>
                      {%- endif -%}
                      <text x="{{ node.textX }}" y="{{ node.nameY }}" font-size="13" class="fill-current" data-testid="{{ testId }}-node-name">{{ node.name }}</text>
                      <text x="{{ node.textX }}" y="{{ node.codeY }}" font-size="10" class="fill-current font-mono opacity-70" data-testid="{{ testId }}-node-code">{{ node.code }}</text>
                      {%- if node.flagged -%}
                        <text x="{{ node.findingX }}" y="{{ node.nameY }}" font-size="12" class="fill-warning" aria-hidden="true" data-testid="{{ testId }}-node-finding">⚠</text>
                      {%- endif -%}
                      {%- if node.chip -%}
                        <text x="{{ node.x + 6 }}" y="{{ node.chipY }}" font-size="10" class="fill-current opacity-70" data-testid="{{ testId }}-node-chip">{{ "↺ any status" if node.chip == "any status" else node.chip }}</text>
                      {%- endif -%}
                    {%- endif -%}
                    <title>{{ node.label }}</title>
                  </a>
                {% endfor %}
              </svg>
            </div>
          {% else %}
            <p class="text-sm {{ muted }}" data-testid="{{ testId }}-phase-empty">No statuses.</p>
          {% endif %}
        </div>
      </section>
    {% endfor %}
  </div>
  {# Before the graph below `lg`, so the selected status is read first on a phone. #}
  <section class="card card-border order-first self-start bg-base-100 lg:sticky lg:top-4 lg:order-none" id="panel" tabindex="-1" aria-label="Status" data-testid="{{ testId }}-panel">
    <div class="card-body gap-3 p-5 text-sm">
      {% if graphs.selected %}
        <h2 class="card-title min-w-0 text-base break-words" data-testid="{{ testId }}-panel-title">{{ nameCode({ name: graphs.selected.status.name, code: graphs.selected.status.code, layout: "stacked" }) }}</h2>
      {% endif %}
      {{ caller() }}
    </div>
  </section>
</div>
</do-state-graph>
