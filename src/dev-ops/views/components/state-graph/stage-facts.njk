{% macro fact(label, item) %}
  <dt class="text-sm font-medium text-base-content/70">{{ label }}</dt>
  <dd class="min-w-0"><span class="font-mono text-sm leading-none break-words">{{ item.code }}</span>{% if item.name %} <span class="text-base-content/60">{{ item.name }}</span>{% endif %}</dd>
{% endmacro %}
<dl class="grid grid-cols-[4rem_minmax(0,1fr)] gap-x-3 gap-y-1"{% if params.testId %} data-testid="{{ params.testId }}"{% endif %}>
  {{ fact("Phase", params.phase) }}
  {{ fact("Stage", params.stage) }}
</dl>
