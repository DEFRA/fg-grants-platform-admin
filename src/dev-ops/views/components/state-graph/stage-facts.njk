{% from "muted/macro.njk" import muted %}
{% from "name-code/macro.njk" import nameCode %}
{% macro fact(label, item) %}
  <dt class="text-sm font-medium {{ muted }}">{{ label }}</dt>
  <dd class="min-w-0">{{ nameCode({ name: item.name, code: item.code }) }}</dd>
{% endmacro %}
<dl class="grid grid-cols-[4rem_minmax(0,1fr)] gap-x-3 gap-y-1"{% if params.testId %} data-testid="{{ params.testId }}"{% endif %}>
  {{ fact("Phase", params.phase) }}
  {{ fact("Stage", params.stage) }}
</dl>
