{%- from "code-text/macro.njk" import codeText -%}
{%- if params.kind == "sends" -%}
  when {{ params.source }} sends {{ codeText(params.code) }}
{%- elif params.kind == "claim" -%}
  when the last claim is submitted
{%- elif params.kind == "gas" -%}
  when GAS runs {{ codeText(params.process) }}
{%- else -%}
  when it makes that move
{%- endif -%}
