{# A table's column widths. An events table gives each kind of column its own
   share, the same on every events table, and the event takes the rest; any
   other list shares the width evenly between its columns. Tailwind only sees
   class names written literally in this file. #}
{%- set shares = {
  badge: "w-[20%] xl:w-[18%]",
  position: "w-[22%] xl:w-[20%]",
  mono: "w-[20%] xl:w-[17%]",
  time: "w-[17%] xl:w-[13%]"
} -%}
{%- set otherShare = "w-[18%] xl:w-[15%]" -%}
{%- set evenly = ["w-1/2", "w-1/3", "w-1/4", "w-1/5", "w-1/6"] -%}
{%- set even = evenly[params.columns | length] if params.even else null -%}
<colgroup>
  <col{% if even %} class="{{ even }}"{% endif %}>
  {% for column in params.columns %}<col class="{{ even or shares[column.format] or otherShare }}">{% endfor %}
  <col class="{{ even or shares.time }}">
</colgroup>
<thead>
  <tr{% if params.testId %} data-testid="{{ params.testId }}"{% endif %}>
    <th scope="col">{{ params.title }}</th>
    {% for column in params.columns %}
      <th scope="col"{% if column.right %} class="text-right"{% endif %}>{{ column.label }}</th>
    {% endfor %}
    <th scope="col" class="text-right">{{ params.time }}</th>
  </tr>
</thead>
