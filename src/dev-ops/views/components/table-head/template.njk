{# A table's column widths. An events table gives each kind of column its own
   share, the same on every events table, and the event takes the rest; any
   other list shares the width evenly between its columns, unless it has a
   layout of its own. Tailwind only sees class names written literally in this file. #}
{%- set shares = {
  badge: "w-[20%] xl:w-[18%]",
  position: "w-[22%] xl:w-[20%]",
  mono: "w-[20%] xl:w-[17%]",
  time: "w-[17%] xl:w-[13%]"
} -%}
{%- set otherShare = "w-[18%] xl:w-[15%]" -%}
{%- set evenly = ["w-1/2", "w-1/3", "w-1/4", "w-1/5", "w-1/6"] -%}
{#- The version lists: each column its own width, by key; on a phone, without Status, the version and the time take more. -#}
{%- set versionWidths = {
  title: "w-[22%] sm:w-[26%]",
  version: "w-[17%] sm:w-[14%]",
  definition: "w-[34%] sm:w-[22%]",
  status: "w-[14%]",
  time: "w-[27%] sm:w-[24%]"
} -%}
{%- set phoneHidden = "hidden sm:table-cell" -%}
{#- A col that is not display: table-column stops being a column, so it is only hidden on a phone. -#}
{%- set phoneHiddenCol = "max-sm:hidden" -%}
{%- set widths = versionWidths if params.layout == "versions" else null -%}
{%- set even = evenly[params.columns | length] if params.even and not widths else null -%}
<colgroup>
  <col{% if widths %} class="{{ widths.title }}"{% elif even %} class="{{ even }}"{% endif %}>
  {% for column in params.columns %}<col class="{{ (widths[column.key] if widths else (even or shares[column.format] or otherShare)) }}{% if column.phoneHidden %} {{ phoneHiddenCol }}{% endif %}">{% endfor %}
  <col class="{{ widths.time if widths else (even or shares.time) }}">
</colgroup>
<thead>
  <tr{% if params.testId %} data-testid="{{ params.testId }}"{% endif %}>
    <th scope="col">{{ params.title }}</th>
    {% for column in params.columns %}
      {%- set classes = (["text-right"] if column.right else []).concat([phoneHidden] if column.phoneHidden else []) -%}
      <th scope="col"{% if classes | length %} class="{{ classes | join(' ') }}"{% endif %}>{{ column.label }}</th>
    {% endfor %}
    <th scope="col" class="text-right">{{ params.time }}</th>
  </tr>
</thead>
