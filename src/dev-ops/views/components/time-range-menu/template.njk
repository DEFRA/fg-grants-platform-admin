{% from "icon/macro.njk" import icon %}

{# Tailwind only sees class names written literally in this file. #}
{% set trigger = "btn [&:has(+:popover-open)]:[--btn-bg:color-mix(in_oklab,var(--btn-color,var(--color-base-200)),#000_5%)] [&:has(+:popover-open)]:[--btn-border:color-mix(in_oklab,var(--btn-color,var(--color-base-200)),#000_7%)] [&:has(+:popover-open)]:[--btn-shadow:0_0_0_0_oklch(0%_0_0/0)] [&:has(+:popover-open)]:translate-y-[0.5px]" %}
{% set triggerActive = "btn font-semibold shadow-[inset_0_-3px_0_var(--color-base-content)] [&:has(+:popover-open)]:[--btn-bg:color-mix(in_oklab,var(--btn-color,var(--color-base-200)),#000_5%)] [&:has(+:popover-open)]:[--btn-border:color-mix(in_oklab,var(--btn-color,var(--color-base-200)),#000_7%)] [&:has(+:popover-open)]:translate-y-[0.5px]" %}
{# The menu is the trigger's next sibling, so `:has(+:popover-open)` turns the chevron with no script. #}
{% set chevron = "size-4 opacity-60 transition-transform [:has(+:popover-open)>&]:rotate-180" %}
{% set menuItem = "flex items-center gap-2" %}
{% set menuItemActive = "flex items-center gap-2 font-semibold" %}
{% set tick = "size-4.5 shrink-0" %}
{% set tickHidden = "size-4.5 shrink-0 invisible" %}

{%- set id = params.id -%}
{%- set range = params.range -%}
<div class="flex items-center gap-2" data-testid="{{ id }}-range">
  <button class="{{ triggerActive if range.active else trigger }}" type="button" popovertarget="{{ id }}-range-panel" title="{{ range.title }}" data-testid="{{ id }}-range-button">
    {{ icon({ name: 'clock', class: 'size-4 opacity-60' }) }}
    <span><span class="font-normal opacity-70">Time:</span> {{ range.label }}</span>
    {{ icon({ name: 'chevron-down', class: chevron }) }}
  </button>
  <div class="dropdown card card-sm mt-2 w-72 border border-base-300 bg-base-100 shadow-md" popover id="{{ id }}-range-panel" data-testid="{{ id }}-range-panel">
    <div class="card-body gap-2 p-2">
      <ul class="menu menu-md w-full p-0" data-testid="{{ id }}-range-presets">
        <li>
          <a class="{{ menuItemActive if range.anyTimeActive else menuItem }}" href="{{ range.anyTimeHref }}"{% if range.anyTimeActive %} aria-current="page"{% endif %} data-testid="{{ id }}-range-any">{{ icon({ name: 'check', class: tick if range.anyTimeActive else tickHidden }) }}<span>All</span></a>
        </li>
        {% for preset in range.presets %}
          <li>
            <a class="{{ menuItemActive if preset.active else menuItem }}" href="{{ preset.href }}" title="{{ preset.title }}"{% if preset.active %} aria-current="true"{% endif %} data-value="{{ preset.key }}" data-testid="{{ id }}-range-preset">{{ icon({ name: 'check', class: tick if preset.active else tickHidden }) }}<span>{{ preset.label }}</span></a>
          </li>
        {% endfor %}
      </ul>

      <form method="get" action="{{ range.action }}" data-testid="{{ id }}-range-form">
        {% for field in range.hiddenFields %}
          <input type="hidden" name="{{ field.name }}" value="{{ field.value }}" data-testid="{{ id }}-range-filter">
        {% endfor %}
        <fieldset class="fieldset border-t border-base-300 pt-2">
          <legend class="fieldset-legend text-sm" data-testid="{{ id }}-range-absolute-heading">Custom</legend>
          <label class="label" for="{{ id }}-range-from" data-testid="{{ id }}-range-from-label">From</label>
          <input class="input w-full font-mono text-sm" id="{{ id }}-range-from" type="datetime-local" step="1" name="from" value="{{ range.fromInput }}" data-testid="{{ id }}-range-from">
          <label class="label" for="{{ id }}-range-to" data-testid="{{ id }}-range-to-label">To</label>
          <input class="input w-full font-mono text-sm" id="{{ id }}-range-to" type="datetime-local" step="1" name="to" value="{{ range.toInput }}" data-testid="{{ id }}-range-to">
          <button class="btn btn-sm mt-2 self-end" type="submit" data-testid="{{ id }}-range-apply">Apply</button>
        </fieldset>
      </form>
    </div>
  </div>
</div>
