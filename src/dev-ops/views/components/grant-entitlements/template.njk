{% from "code-text/macro.njk" import codeText %}
{% from "facts-card/macro.njk" import codes, fact, factList %}
{% from "icon/macro.njk" import icon %}
{% from "muted/macro.njk" import muted %}
{% from "no-value/macro.njk" import noValue %}
{% from "status-badge/macro.njk" import statusBadge %}

{# Tailwind only sees class names written literally in this file. #}
{% set card = "card card-border mt-4 bg-base-100 first:mt-0" %}
{% set ruleList = "grid grid-cols-[minmax(6rem,9rem)_minmax(0,1fr)] content-start gap-x-4 gap-y-3 text-sm sm:gap-x-6" %}
{% set note = "text-sm " ~ muted %}
{% set chipClass = "badge badge-ghost badge-sm h-auto w-fit max-w-full whitespace-normal border-base-300 py-0.5 text-left no-underline" %}
{% set onSubmitLabels = {
  "cant-claim": "Can't be claimed",
  "waits-for-approval": "Waits for approval",
  "requests-payment": "Requests payment",
  "no-payment-file": "No payment file"
} %}
{% set anyText = {
  status: "any status",
  "stage-and-status": "any stage, any status"
} %}

{% macro yesNo(value) %}{% if value %}Yes{% else %}<span class="{{ muted }}">No</span>{% endif %}{% endmacro %}

{% macro chip(position, testId) %}
  <a class="{{ chipClass }}" href="{{ position.href }}" title="{{ position.code }}: open in Phases" data-testid="{{ testId }}-chip">{{ codeText(position.label) }}{% if position.any %} <span class="{{ muted }}">{{ anyText[position.any] }}</span>{% endif %}<span class="sr-only">, open in Phases</span></a>
{% endmacro %}

{% macro chips(positions, testId) %}
  {%- if positions | length -%}
    <div class="flex flex-wrap gap-1">{% for position in positions %}{{ chip(position, testId) }}{% endfor %}</div>
  {%- else -%}
    {{ noValue({}) }}
  {%- endif -%}
{% endmacro %}

{% macro move(value, testId) %}
  <span class="inline-flex flex-wrap items-center gap-1">{{ chip(value.from, testId) }}{{ icon({ name: 'arrow-right', class: 'size-3.5 shrink-0 ' ~ muted }) }}<span class="sr-only">moves to</span>{{ chip(value.to, testId) }}</span>
{% endmacro %}

{% macro onSubmit(value, role, testId) %}
  <div class="flex flex-wrap items-baseline gap-x-1.5" data-testid="{{ testId }}-on-submit">
    {{- statusBadge({ role: role, label: onSubmitLabels[value.kind] }) -}}
    {%- if value.kind == "cant-claim" %} <span class="{{ muted }}">({{ "materialised: GAS doesn't derive these yet" if value.reason == "materialised" else "no Claimable at" }})</span>
    {%- elif value.kind == "waits-for-approval" %} <span class="{{ muted }}" aria-hidden="true">·</span> <span class="min-w-0">GAS has no approval step yet, so these claims stay awaiting: no payment, no move.</span>
    {%- endif -%}
  </div>
  {%- if value.kind == "requests-payment" and value.payment == "not-stored" %}<div class="mt-1 {{ note }}" data-testid="{{ testId }}-payment-not-stored">Payment definition not stored yet: GAS fetches it when it first needs it.</div>{% endif -%}
  {%- if value.kind == "requests-payment" and value.payment == "failed" %}<div class="mt-1 text-sm" data-testid="{{ testId }}-payment-failed">Payment definition failed: these claim payments fail.</div>{% endif -%}
  {%- if value.move %}<div class="mt-1 flex flex-wrap items-center gap-1 text-sm" data-testid="{{ testId }}-moves">Moves the application to {{ chip(value.move.to, testId) }} when the last claim is submitted at {{ chip(value.move.from, testId) }}</div>{% endif -%}
{% endmacro %}

{% macro warningText(warning) %}
  {%- if warning.kind == "materialised-claim" -%}
    {{ codeText(warning.claimCode) }} is materialised, which GAS doesn't derive yet, so its claim rules never apply.
  {%- elif warning.kind == "no-claimable-at" -%}
    {{ codeText(warning.claimCode) }} can't be claimed: its claim rules list no "Claimable at" status, so GAS rejects every claim (WRONG_POSITION). Publish a version that sets {{ codeText("claim.claimableAt") }}.
  {%- else -%}
    {{ codeText(warning.claimCode) }} requests payment on submit, but the <a class="link" href="{{ warning.paymentHref }}">payment definition</a> reads {{ codeText("$.agreement") }}: claim payments can only read {{ codeText("$.claim") }} and {{ codeText("$.execution") }}, so these fields resolve empty and GAS refuses the payment.
  {%- endif -%}
{% endmacro %}

{%- set view = params.view -%}
{%- set testId = params.testId -%}
<div data-testid="{{ testId }}">
  {% if view.nothing %}
    <div class="card card-border bg-base-100" data-testid="{{ testId }}-nothing">
      <p class="px-4 py-10 text-center {{ note }}">Nothing can be claimed on this version: it has no entitlement templates.</p>
    </div>
  {% else %}
    <section class="card card-border bg-base-100" aria-labelledby="{{ testId }}-claims-title" data-testid="{{ testId }}-claims">
      <div class="card-body gap-3 p-5">
        <h2 class="card-title text-base" id="{{ testId }}-claims-title">Claims (all templates)</h2>
        <div class="grid gap-x-6 gap-y-3 text-sm lg:grid-cols-2">
          <dl class="{{ factList }}">
            {% call fact("After the last claim", testId ~ "-move") %}
              {%- if view.claims.move -%}
                {{ move(view.claims.move, testId) }}
              {%- else -%}
                {{ noValue({}) }}
              {%- endif -%}
            {% endcall %}
          </dl>
          <dl class="{{ factList }}">
            {% call fact("Payment definition", testId ~ "-payment-file") %}
              {%- if view.claims.paymentHref -%}
                <a class="link" href="{{ view.claims.paymentHref }}">{{ view.claims.paymentLink }}</a>
              {%- else -%}
                {{ noValue({}) }}
              {%- endif -%}
            {% endcall %}
            {% call fact("Claim roles", testId ~ "-roles") %}
              {%- if view.claims.roles -%}
                {%- if view.claims.roles.allOf | length %}<div><span class="{{ muted }}">all of:</span> {{ codes(view.claims.roles.allOf) }}</div>{% endif -%}
                {%- if view.claims.roles.anyOf | length %}<div><span class="{{ muted }}">any of:</span> {{ codes(view.claims.roles.anyOf) }}</div>{% endif -%}
              {%- else -%}
                <span class="{{ muted }}">Any operator</span>
              {%- endif -%}
            {% endcall %}
          </dl>
        </div>
      </div>
    </section>

    <div class="mt-4">
      {% set factId = testId ~ "-fact-" %}
      {% for template in view.templates %}
        <section class="{{ card }}" aria-labelledby="{{ testId }}-template-{{ loop.index }}" data-testid="{{ testId }}-template">
          <div class="card-body gap-3 p-5">
            <h2 class="card-title flex-wrap items-baseline gap-x-2 gap-y-0 text-base" id="{{ testId }}-template-{{ loop.index }}" data-testid="{{ testId }}-template-title">{{ codeText(template.claimCode) }} <span class="min-w-0 basis-full font-normal sm:basis-auto">{{ template.name }}</span></h2>
            {% if not template.materialised %}<p class="-mt-2 {{ note }}" data-testid="{{ testId }}-grant-ops">Shown in Grant Ops as a claimable item.</p>{% endif %}
            {% if template.description %}<p class="{{ note }}" data-testid="{{ testId }}-description">{{ template.description }}</p>{% endif %}
            <dl class="{{ ruleList }}" data-testid="{{ testId }}-summary">
              {% call fact("On submit", factId ~ "on-submit") %}{{ onSubmit(template.onSubmit, template.onSubmitRole, testId) }}{% endcall %}
            </dl>
            {% for warning in template.warnings %}
              <div class="alert alert-warning alert-soft text-sm" data-testid="{{ testId }}-warning">
                {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
                <span class="min-w-0 break-words">{{ warningText(warning) }}</span>
              </div>
            {% endfor %}
            <div class="grid gap-x-6 gap-y-4 lg:grid-cols-2">
              <div>
                <h3 class="mb-2 text-sm font-semibold">How it's created</h3>
                <dl class="{{ ruleList }}">
                  {% call fact("Created by", factId ~ "created-by") %}{% if template.materialised %}materialised: projected from the application's position and past claims. GAS doesn't derive these yet, so nothing can be claimed against them{% else %}an operator (claimable item){% endif %}{% endcall %}
                  {% call fact("Max per application", factId ~ "max-entitlements") %}{{ template.maxEntitlements }}{% endcall %}
                  {% call fact("Can be created at", factId ~ "available-at") %}{{ chips(template.availableAt, testId) }}{% endcall %}
                </dl>
              </div>
              <div>
                <h3 class="mb-2 text-sm font-semibold">Claiming</h3>
                <dl class="{{ ruleList }}">
                  {% call fact("Claimable at", factId ~ "claimable-at") %}{% if template.claim %}{{ chips(template.claim.claimableAt, testId) }}{% else %}{{ noValue({}) }}{% endif %}{% endcall %}
                  {% call fact("Max claims", factId ~ "max-claims") %}{% if template.claim %}{{ template.claim.maximumClaims }} <span class="{{ muted }}">per entitlement</span>{% else %}{{ noValue({}) }}{% endif %}{% endcall %}
                  {% call fact("Partial", factId ~ "partial") %}{% if template.claim %}{{ yesNo(template.claim.partial) }}{% else %}{{ noValue({}) }}{% endif %}{% endcall %}
                  {% call fact("Approval", factId ~ "approval") %}{% if template.claim %}{{ yesNo(template.claim.approval) }}{% else %}{{ noValue({}) }}{% endif %}{% endcall %}
                  {% call fact("Evidence", factId ~ "evidence") %}{% if template.claim %}{{ yesNo(template.claim.evidence) }}{% else %}{{ noValue({}) }}{% endif %}{% endcall %}
                </dl>
              </div>
            </div>
            {% if template.fields | length %}
              <h3 class="mt-2 text-sm font-semibold">Fields</h3>
              <div class="w-full overflow-x-auto" data-testid="{{ testId }}-fields">
                <table class="table w-full min-w-[40rem] table-fixed">
                  <colgroup><col class="w-[16%]"><col class="w-[14%]"><col class="w-[32%]"><col class="w-[16%]"><col class="w-[22%]"></colgroup>
                  <thead>
                    <tr><th scope="col" class="whitespace-nowrap">Field</th><th scope="col" class="whitespace-nowrap">Source</th><th scope="col" class="whitespace-nowrap">Label or value</th><th scope="col" class="whitespace-nowrap">Unit</th><th scope="col" class="whitespace-nowrap">Bounds</th></tr>
                  </thead>
                  <tbody>
                    {% for field in template.fields %}
                      <tr class="hover:bg-base-200 align-top" data-testid="{{ testId }}-field">
                        <td><span class="text-sm">{{ codeText(field.name) }}</span></td>
                        <td class="text-sm" data-testid="{{ testId }}-field-source">{% if field.source == "Entered" %}Entered{% else %}<span class="{{ muted }}">{{ field.source }}</span>{% endif %}</td>
                        <td>{% if field.source == "Entered" %}{{ field.text }}{% else %}<code class="block whitespace-pre-wrap text-sm">{{ codeText(field.text) }}</code>{% endif %}</td>
                        <td><span class="text-sm">{{ codeText(field.unit) }}</span></td>
                        <td>{{ codes(field.bounds) }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            {% endif %}
            {% if template.help %}
              <details class="collapse collapse-arrow rounded-box border border-base-300" data-testid="{{ testId }}-help">
                <summary class="collapse-title text-sm font-medium">Help · {{ template.help.summary }}</summary>
                <div class="collapse-content text-sm">
                  {% for block in template.help.content %}
                    {% if block.items %}
                      <ul class="ml-5 list-disc">{% for item in block.items %}<li>{{ item }}</li>{% endfor %}</ul>
                    {% else %}
                      <p>{{ block.text }}</p>
                    {% endif %}
                  {% endfor %}
                </div>
              </details>
            {% endif %}
          </div>
        </section>
      {% else %}
        <div class="card card-border bg-base-100" data-testid="{{ testId }}-empty">
          <p class="px-4 py-10 text-center {{ note }}">No entitlement templates.</p>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>
