{% from "code-text/macro.njk" import codeText %}
{% from "facts-card/macro.njk" import fact, factList %}
{% from "icon/macro.njk" import icon %}
{% from "mapping-table/macro.njk" import mappingTable, mappingValue %}
{% from "muted/macro.njk" import muted %}

{# Tailwind only sees class names written literally in this file. #}
{% set card = "card card-border mt-4 bg-base-100 first:mt-0" %}
{% set facts = factList ~ " text-sm" %}
{% set factLabel = "text-sm font-medium " ~ muted %}
{% set note = "text-sm " ~ muted %}
{% set lineColumns = [
  ["schemeCode", "Scheme"],
  ["description", "Description"],
  ["amountPence", "Amount (pence)"],
  ["accountCode", "Account"],
  ["fundCode", "Fund"],
  ["deliveryBody", "Delivery body"],
  ["marketingYear", "Marketing year"]
] %}
{% set readsText = {
  claim: ["$.claim", "the submitted claim"],
  agreement: ["$.agreement", "the stored agreement"],
  execution: ["$.execution.executedAt", "when GAS ran it"],
  row: ["@.", "the current row of a For each"]
} %}

{% macro tabLink(href, label) %}{% if href %} <a class="link" href="{{ href }}">{{ label }} ›</a>{% endif %}{% endmacro %}

{# A literal description is read as words; anything else is a mapping. #}
{% macro lineCell(value) %}
  {%- if value and value.kind == "expression" -%}
    <span class="text-sm {{ muted }}">calculated ›</span>
  {%- elif value and value.kind == "literal" and not value.empty -%}
    <span class="text-sm">{{ value.text }}</span><span class="ml-1.5 text-xs {{ muted }}" data-comes-from>fixed</span>
  {%- else -%}
    {{ mappingValue(value, "always") }}
  {%- endif -%}
{% endmacro %}

{%- set view = params.view -%}
{%- set testId = params.testId -%}
<div data-testid="{{ testId }}">
  <section class="card card-border bg-base-100" aria-labelledby="{{ testId }}-when-title" data-testid="{{ testId }}-when">
    <div class="card-body gap-3 p-5">
      <h2 class="card-title text-base" id="{{ testId }}-when-title">When GAS requests this payment</h2>
      <dl class="{{ facts }}">
        {% call fact("Requested when", testId ~ "-requested-when") %}
          {% if view.requestedWhen.claim %}<div data-testid="{{ testId }}-requested-on-claim">a claim is submitted (claim payments){{ tabLink(view.hrefs.entitlements, "Entitlements") }}</div>{% endif %}
          {% if view.requestedWhen.agreement %}<div data-testid="{{ testId }}-requested-on-agreement">an agreement action runs {{ codeText("CREATE_AGREEMENT_PAYMENT") }}{{ tabLink(view.hrefs.agreement, "Agreement") }}</div>{% endif %}
        {% endcall %}
        {% if view.reads | length %}
          {% call fact("Reads", testId ~ "-reads") %}
            {%- for root in view.reads -%}
              {%- if not loop.first %}<span class="{{ muted }}" aria-hidden="true"> · </span>{% endif -%}
              <span>{{ codeText(readsText[root][0]) }} <span class="{{ muted }}">{{ readsText[root][1] }}</span></span>
            {%- endfor -%}
          {% endcall %}
        {% endif %}
        {% call fact("Used for", testId ~ "-used-for") %}
          agreement payments whose agreement is on {{ view.version }} (the version it was created or accepted under{% if view.hrefs.agreement %}, <a class="link" href="{{ view.hrefs.agreement }}">see the Agreement tab</a>{% endif %}), and claims on applications currently on {{ view.version }}. GAS has no fallback: if this file can't load, those payments fail.
        {% endcall %}
      </dl>
      {% if view.readsAgreementRows %}
        <p class="{{ note }}" data-testid="{{ testId }}-row-ids">Reads the stored agreement, where GAS has replaced {{ codeText("actionRef") }}/{{ codeText("itemRef") }}/{{ codeText("ref") }} with stable ids: {{ codeText("actionId") }}, {{ codeText("itemId") }}, {{ codeText("id") }} ({{ codeText("action:1") }}, {{ codeText("item:1") }}).</p>
      {% endif %}
      {% if view.mixed %}
        <div class="alert alert-warning alert-soft text-sm" data-testid="{{ testId }}-mixed">
          {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
          <span class="min-w-0 break-words">This definition reads {{ codeText("$.agreement") }}, but claim payments can only read {{ codeText("$.claim") }} and {{ codeText("$.execution") }}, so these fields resolve empty and GAS refuses the payment.</span>
        </div>
      {% endif %}
    </div>
  </section>

  <section class="{{ card }}" aria-labelledby="{{ testId }}-request-title" data-testid="{{ testId }}-request">
    <div class="card-body gap-3 p-5">
      <h2 class="card-title text-base" id="{{ testId }}-request-title">Payment request</h2>
      {{ mappingTable({ rows: view.request, testId: testId ~ "-fields" }) }}
    </div>
  </section>

  {% for due in view.duePayments %}
    {% set titleId = testId ~ "-due-" ~ loop.index %}
    <section class="{{ card }}" aria-labelledby="{{ titleId }}" data-testid="{{ testId }}-due">
      <div class="card-body gap-3 p-5">
        <h2 class="card-title flex-wrap text-base" id="{{ titleId }}" data-testid="{{ testId }}-due-title">{{ due.title.text }}{% if due.title.forEach %} <span class="text-sm font-normal">(one per item of {{ codeText(due.title.forEach) }})</span>{% endif %}</h2>
        {% if due.kind == "from" %}
          <dl class="{{ facts }}">
            {% call fact("From", testId ~ "-from") %}{{ mappingValue(due.value, "always") }}{% endcall %}
          </dl>
        {% else %}
          <div class="flex flex-col gap-3" data-testid="{{ testId }}-due-facts">
            {% if due.forEach %}
              <dl class="{{ facts }}">
                {% call fact("For each", testId ~ "-due-fact-for-each") %}{{ mappingValue(due.forEach) }}{% endcall %}
              </dl>
            {% endif %}
            <div class="grid gap-x-6 gap-y-3 lg:grid-cols-2">
              <dl class="{{ facts }}">
                {% call fact("Due date", testId ~ "-due-fact-due-date") %}{{ mappingValue(due.dueDate, "always") }}{% endcall %}
              </dl>
              <dl class="{{ facts }}">
                {% call fact("Total (pence)", testId ~ "-due-fact-total") %}{{ mappingValue(due.totalAmountPence, "always") }}{% endcall %}
              </dl>
            </div>
          </div>
          {% set lines = due.lines %}
          {% if lines.kind == "from" %}
            <p class="{{ note }}" data-testid="{{ testId }}-lines-from">Invoice lines from {{ mappingValue(lines.value, "always") }}</p>
          {% elif not lines.rows | length %}
            <div role="alert" class="alert alert-warning alert-soft text-sm" data-testid="{{ testId }}-no-lines">
              {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
              <span class="min-w-0 break-words">No invoice lines: GAS needs at least one on each due payment, so every payment for this version fails.</span>
            </div>
          {% else %}
            {% if lines.forEach %}
              <p class="{{ note }}" data-testid="{{ testId }}-for-each">One line per row of {{ mappingValue(lines.forEach) }}</p>
            {% endif %}
            <div class="w-full overflow-x-auto">
              <table class="table w-full min-w-[48rem] table-fixed" data-testid="{{ testId }}-lines">
                <thead>
                  <tr>{% for column in lineColumns %}<th scope="col" class="whitespace-nowrap">{{ column[1] }}</th>{% endfor %}</tr>
                </thead>
                <tbody>
                  {% for line in lines.rows %}
                    {% if line.kind == "from" %}
                      <tr class="hover:bg-base-200" data-testid="{{ testId }}-line-from"><td colspan="7"><span class="text-sm {{ muted }}">Line from</span> {{ mappingValue(line.value, "always") }}</td></tr>
                    {% else %}
                      <tr class="hover:bg-base-200 align-top" data-testid="{{ testId }}-line">{% for column in lineColumns %}<td>{{ lineCell(line[column[0]]) }}</td>{% endfor %}</tr>
                      {% if line.calculated | length %}
                        <tr data-testid="{{ testId }}-line-expressions">
                          <td colspan="7" class="pt-0">
                            <details class="text-sm">
                              <summary class="cursor-pointer {{ muted }}">Calculated fields</summary>
                              <dl class="{{ facts }} mt-2">
                                {% for column in lineColumns %}
                                  {% if column[0] in line.calculated %}
                                    <dt class="{{ factLabel }}">{{ column[1] }}</dt>
                                    <dd class="min-w-0 whitespace-pre-wrap">{{ codeText(line[column[0]].text) }}</dd>
                                  {% endif %}
                                {% endfor %}
                              </dl>
                            </details>
                          </td>
                        </tr>
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% endif %}
        {% endif %}
      </div>
    </section>
  {% else %}
    <div role="alert" class="alert alert-warning alert-soft mt-4 text-sm" data-testid="{{ testId }}-no-due">
      {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
      <span class="min-w-0 break-words">No due payments: GAS needs at least one, so every payment for this version fails.</span>
    </div>
  {% endfor %}
  {% if view.duePayments | length %}
    <p class="mt-3 {{ note }}" data-testid="{{ testId }}-checks">GAS checks after resolving: every field is present, as text or whole pence; each due payment has at least one invoice line and its total equals its lines; the request total equals the due payments. A payment that fails is not created.</p>
  {% endif %}
</div>
