{% from "code-text/macro.njk" import codeText %}
{% from "muted/macro.njk" import muted %}
{% from "./macro.njk" import mappingValue %}

{# Tailwind only sees class names written literally in this file. The CSP blocks inline styles, so each depth's indent is a class. #}
{% set indents = ["pl-0", "pl-4", "pl-8", "pl-12", "pl-16", "pl-20", "pl-24"] %}
{% set comesFromCell = "hidden text-sm sm:table-cell " ~ muted %}

{%- set testId = params.testId -%}
<div class="w-full overflow-x-auto" data-testid="{{ testId }}">
  <table class="table w-full table-fixed sm:min-w-[40rem]">
    <colgroup><col class="w-2/5 sm:w-[30%]"><col><col class="hidden w-28 sm:table-column"></colgroup>
    <thead>
      <tr><th scope="col" class="whitespace-nowrap">Field</th><th scope="col" class="whitespace-nowrap">Value</th><th scope="col" class="hidden whitespace-nowrap sm:table-cell">Comes from</th></tr>
    </thead>
    <tbody>
      {% for row in params.rows %}
        <tr class="hover:bg-base-200 align-top" data-testid="{{ testId }}-row">
          <td><span class="block text-sm {{ indents[row.depth] | default(indents | last) }}" data-testid="{{ testId }}-field">{{ codeText(row.field) }}</span></td>
          {% if row.kind == "value" %}
            <td>{{ mappingValue(row.value, "phone") }}</td>
            <td class="{{ comesFromCell }}" data-testid="{{ testId }}-comes-from">{{ row.value.comesFrom }}</td>
          {% elif row.kind == "each" %}
            <td><span class="text-sm"><span class="{{ muted }}">For each</span> {{ codeText(row.forEach) }}</span></td>
            <td class="{{ comesFromCell }}" data-testid="{{ testId }}-comes-from">for each</td>
          {% elif row.kind == "list" %}
            <td></td>
            <td class="{{ comesFromCell }}" data-testid="{{ testId }}-comes-from">list</td>
          {% else %}
            <td></td>
            <td class="{{ comesFromCell }}"></td>
          {% endif %}
        </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
