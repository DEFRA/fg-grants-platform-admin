{%- from "code-text/macro.njk" import codeText -%}
{%- from "muted/macro.njk" import muted -%}
{%- from "no-value/macro.njk" import noValue -%}
{#- Tailwind only sees class names written literally in this file. -#}
{%- set suffixClasses = { always: "ml-1.5 text-xs " ~ muted, phone: "ml-1.5 text-xs sm:hidden " ~ muted } -%}
{%- if not value -%}
  {{ noValue({}) }}
{%- elif value.empty -%}
  <span class="font-mono text-sm {{ muted }}">""</span>
{%- elif value.kind == "expression" -%}
  {#- Two lines, and the whole expression on opening. -#}
  <details class="group inline-block max-w-full align-top" data-expression><summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden"><span class="line-clamp-2 text-sm group-open:line-clamp-none" title="{{ value.text }}">{{ codeText(value.text) }}</span></summary></details>
{%- else -%}
  <span class="text-sm">{{ codeText(value.text) }}</span>
{%- endif -%}
{%- if value and suffix %}{{ " " }}<span class="{{ suffixClasses[suffix] }}" data-comes-from>{{ value.comesFrom }}</span>{% endif -%}
