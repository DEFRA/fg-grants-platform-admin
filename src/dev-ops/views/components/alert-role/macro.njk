{# One alert class and icon per role, for every banner. Tailwind only sees class names written literally in this file. #}
{# The success role is solid: `alert-soft` writes the message in the role's own
   colour on a tint of that colour, and for success that is a pale green on a
   pale green, under 3:1. #}
{% set alertRoles = {
  success: "alert-success",
  info: "alert-soft alert-info",
  warning: "alert-soft alert-warning",
  error: "alert-soft alert-error"
} %}
{% set alertIcons = {
  success: "circle-check",
  info: "info",
  warning: "exclamation-triangle",
  error: "exclamation-circle"
} %}
