{% from "icon/macro.njk" import icon %}
{% from "words/macro.njk" import words %}
{% from "alert-role/macro.njk" import alertRoles, alertIcons %}

{% set layout = "alert join-item justify-start gap-4 text-sm" %}

{%- set testId = params.testId -%}
{%- set banner = params.banner -%}
{% if params.notices | length or banner %}
  <div class="join join-vertical mb-4 w-full" data-testid="{{ testId }}-banner-region">
    {% for notice in params.notices %}
      <div role="{{ 'status' if notice.role == 'success' else 'alert' }}" class="{{ layout }} {{ alertRoles[notice.role] }}" data-testid="{{ testId }}-notice">
        {{ icon({ name: alertIcons[notice.role], class: 'size-4 shrink-0' }) }}
        <span class="max-w-3xl">{{ words(notice.words) }}</span>
      </div>
    {% endfor %}
    {% if banner %}
      <div role="status" class="{{ layout }} {{ alertRoles[banner.tone] }}" data-tone="{{ banner.tone }}" data-testid="{{ testId }}-banner">
        {{ icon({ name: alertIcons[banner.tone], class: 'size-4 shrink-0 self-start mt-0.5' }) }}
        <div class="flex max-w-3xl flex-col gap-2">
          {% for line in banner.lines %}
            <p class="break-words" data-testid="{{ testId }}-banner-line">{{ words(line) }}</p>
          {% endfor %}
          {% if banner.fetch %}
            <form method="post" action="{{ banner.fetch.action }}">
              <input type="hidden" name="back" value="{{ banner.fetch.back }}">
              <input type="hidden" name="tab" value="{{ banner.fetch.tab }}">
              <button class="btn btn-sm" type="submit" data-testid="{{ testId }}-fetch">{{ banner.fetch.label }}</button>
            </form>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
{% endif %}
