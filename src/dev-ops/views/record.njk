{% extends 'layouts/page.njk' %}

{% from "muted/macro.njk" import muted %}
{% from "back/macro.njk" import back %}
{% from "event-row/macro.njk" import eventRow, eventsHead %}
{% from "facts-card/macro.njk" import factsCard %}
{% from "code-text/macro.njk" import codeText %}
{% from "icon/macro.njk" import icon %}
{% from "inbox-search/macro.njk" import inboxSearch %}
{% from "json-viewer/macro.njk" import jsonViewer %}

{% macro noData(record) %}
  <div role="alert" class="alert alert-warning alert-soft text-sm" data-testid="{{ record.itemId }}-no-data">
    {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
    <span>{{ record.source }} returned no data for this tab</span>
  </div>
{% endmacro %}

{% block pageTitle %}{{ record.title }} {{ ref }} – {{ productName }}{% endblock %}

{% block content %}
  {{ back({ href: backHref or homeHref, list: record.listId, label: backLabel, navLabel: (record.listId | capitalize) ~ " list", testId: record.itemId }) }}

  <header class="mt-2 mb-5" data-testid="{{ record.itemId }}-header">
    <h1 class="flex flex-wrap items-baseline gap-x-2 text-xl font-semibold break-words" data-testid="{{ record.itemId }}-title"><span>{{ record.title }}</span> <span class="font-mono text-sm font-normal break-all {{ muted }} select-all" data-testid="{{ record.itemId }}-ref">{{ ref }}</span></h1>
    {% block recordHeader %}{% endblock %}
  </header>

  {% block beforeTabs %}{% endblock %}

    <nav class="mb-4" aria-label="Sections" data-testid="{{ record.itemId }}-tabs">
      {# One row that scrolls on a phone, with the open tab brought into view. #}
      <do-tab-strip class="tabs tabs-border flex-nowrap overflow-x-auto [scrollbar-gutter:stable]">
        {% for item in tabs %}
          <a class="tab shrink-0{% if item.active %} tab-active{% endif %}" href="{{ item.href }}"{% if item.active %} aria-current="page"{% endif %} data-testid="{{ record.itemId }}-tab">{{ item.label }}</a>
        {% endfor %}
      </do-tab-strip>
    </nav>

    {% block tabBody %}
    {% if sectionError %}
      <div role="alert" class="alert alert-error alert-soft text-sm" data-testid="{{ record.itemId }}-section-error">
        {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
        <span>{{ sectionError }}</span>
      </div>
    {% elif tooLarge %}
      <div role="alert" class="alert alert-warning alert-soft text-sm" data-testid="{{ record.itemId }}-too-large">
        {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
        <span>Too large to show</span>
      </div>
    {% elif tab == "overview" and facts %}
      {{ factsCard({ facts: facts, label: 'Overview', testId: record.itemId }) }}
    {% elif tab == "events" and events and versionEvents %}
      {% if unavailableSources %}
        <div role="alert" class="alert alert-warning alert-soft mb-3 text-sm" data-testid="{{ record.itemId }}-events-partial">
          {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
          <span>Some event sources are unavailable: {{ unavailableSources }}. Showing the rest.</span>
        </div>
      {% endif %}
      {% set versioned = versionEvents %}
      <div class="card card-border overflow-clip bg-base-100" data-testid="{{ record.itemId }}-events">
        {% if events.rows | length %}
          {% if versioned %}
            <div class="px-4 pt-3 text-sm {{ muted }}" data-testid="{{ record.itemId }}-events-caption">
              <p>{{ codeText("ConfigVersionUpdated") }} events {{ versioned.source }} received for {{ versioned.code }} {{ versioned.version }}, newest first.</p>
              <div>A version {{ versioned.source }} rejected has no page: {% call inboxSearch({ service: versioned.source, code: versioned.code, testId: record.itemId ~ "-events-search" }) %}search {{ versioned.source }}'s inbox for {{ codeText(versioned.code) }} ›{% endcall %}</div>
            </div>
          {% endif %}
          <div class="w-full overflow-x-auto">
            <table class="table w-full min-w-[64rem] table-fixed" data-testid="{{ record.itemId }}-events-table">
              {{ eventsHead({}) }}
              <tbody>
                {% for row in events.rows %}{{ eventRow(row) }}{% endfor %}
              </tbody>
            </table>
          </div>
          {% if events.more %}
            <p class="border-t border-base-300 px-4 py-3 text-sm {{ muted }}" data-testid="{{ record.itemId }}-events-more">Showing the newest 50 from {{ versioned.source }}'s inbox.</p>
          {% endif %}
        {% else %}
          <div class="px-4 py-10 text-center text-sm {{ muted }}" data-testid="{{ record.itemId }}-events-empty">
            {# An unread source cannot be said to hold nothing: the alert above says why the table is empty. #}
            {% if not unavailableSources %}
              <p class="mb-2">{{ versioned.source }} holds no config event for {{ versioned.code }} {{ versioned.version }}. Events {{ versioned.source }} no longer holds are not listed.</p>
            {% endif %}
            <div>{% call inboxSearch({ service: versioned.source, code: versioned.code, testId: record.itemId ~ "-events-search" }) %}Search {{ versioned.source }}'s inbox for {{ codeText(versioned.code) }} to see every version's events ›{% endcall %}</div>
          </div>
        {% endif %}
      </div>
    {% elif tab == "raw" and raw %}
      {% if raw.tooLarge %}
        <div role="alert" class="alert alert-warning alert-soft text-sm" data-testid="{{ record.itemId }}-raw-too-large">
          {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
          <span>Too large to show</span>
        </div>
      {% elif raw.view %}
        <section class="card card-border bg-base-100" aria-label="Raw" data-testid="{{ record.itemId }}-raw-card">
          <div class="card-body p-5">
            {{ jsonViewer({ view: raw.view, label: record.title ~ " document", testId: record.itemId ~ "-raw" }) }}
          </div>
        </section>
      {% else %}
        {{ noData(record) }}
      {% endif %}
    {% else %}
      {{ noData(record) }}
    {% endif %}
    {% endblock %}
{% endblock %}
