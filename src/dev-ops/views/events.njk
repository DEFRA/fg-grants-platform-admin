{% extends 'layouts/page.njk' %}

{% from "icon/macro.njk" import icon %}
{% from "pager/macro.njk" import pager %}
{% from "status-badge/macro.njk" import statusBadge %}

{# The page is stock daisyUI: a `join` of link-buttons for each facet, a
   popover `dropdown` for the window, a `join` for the search, a `collapse` for
   the failures panel and a real `table` for the events. Nothing on it is a
   selector this app authored — the hand-rolled grid table, the segment tint,
   the caret and the failures grid have all gone back to components.

   The class names are still written as literal strings in this file, because
   Tailwind scans this file's text for candidates and never sees a class
   assembled in TypeScript. #}

{# The group labels name a control, they are not options in it: smaller and
   muted, in sentence case, so the eye never mistakes `Status` for a segment it
   could have clicked. #}
{% set filterLabel = "text-xs font-medium text-base-content/60" %}

{# A true segmented control, not a row of loose chips: one border around the
   group, drawn by the `join`, and segments that share it. The selected segment
   is `btn-active`, which is daisyUI's own word for "this is the one on". #}
{% set activeChip = "btn btn-sm join-item btn-active" %}
{% set inactiveChip = "btn btn-sm join-item font-normal" %}
{# The time-range button wears the same mark an active segment does, because
   it says the same kind of thing: this is the window the page is on. Spelled
   whole rather than concatenated into the attribute, so every class name in
   this file is a literal Tailwind and daisyUI can both see. #}
{% set rangeButton = "btn btn-sm" %}
{% set activeRangeButton = "btn btn-sm btn-active" %}
{# A segment with nothing behind it. Dimmed, and still a link: an operator who
   can see that Failed holds nothing has been answered, and a segment that
   vanished when it emptied could not be told from one the page forgot to
   draw. #}
{% set emptyChip = "btn btn-sm join-item font-normal text-base-content/60" %}
{# The figure on a segment, as a badge inside the button — official syntax, and
   the reason this control is worth its width: seven status words said which
   slices exist and nothing about which of them is worth opening. Tabular,
   because the segments are read down as much as along. #}
{% set segmentCount = "badge badge-ghost badge-sm tabular-nums" %}
{# The one figure in the toolbar allowed a colour: the dead letters, and only
   while there are some. A red zero is an alarm about nothing. #}
{% set segmentCountAlarm = "badge badge-error badge-sm tabular-nums" %}

{# One segment: the word, and how many events are behind it.

   Every figure is a facet: it says how many events *selecting this segment*
   would find, not how many the current selection holds. So the Caseworking
   segment still carries its own number on a page filtered to GAS, and a
   segment is never a zero merely because something else is selected.

   A count that could not be read draws nothing at all — no dash, no zero, no
   alert. The control is a perfectly good filter without its figures, and a
   summary that failed has not made the page below it an error. #}
{% macro segment(chip, testId) %}
  {# A zero says nothing a dimmed segment has not already said, and seven of
     them across the status group was seven badges of noise on a healthy page —
     the one figure worth reading, the dead letters, had to compete with them.
     The count still exists on a segment that is empty; it is on the title,
     where a figure nobody needs at a glance belongs. #}
  {%- set emptyTitle = (chip.title ~ " · " ~ chip.countLabel ~ " events") if chip.title else (chip.countLabel ~ " events") -%}
  {%- set chipTitle = emptyTitle if chip.zero else chip.title -%}
  <a class="{{ activeChip if chip.active else (emptyChip if chip.zero else inactiveChip) }}" href="{{ chip.href }}"{% if chip.active %} aria-current="page"{% endif %}{% if chipTitle %} title="{{ chipTitle }}"{% endif %}{% if chip.value %} data-value="{{ chip.value }}"{% endif %} data-testid="{{ testId }}">{{ chip.label }}{% if chip.countLabel and not chip.zero %} <span class="{{ segmentCountAlarm if chip.alarming else segmentCount }}" data-testid="{{ testId }}-count">{{ chip.countLabel }}</span>{% endif %}</a>
{% endmacro %}

{# The identity cell: an id, and the type under it when there is one.

   The id is the row's name. It is the one identifier every event has — an
   audit record publishes no CloudEvent type at all — and it is set in mono and
   semibold because it is a machine string and the first thing an operator
   scans down.

   It is a link, and it opens this row's own page — the payload, the timestamps,
   the journey. It is deliberately NOT a `?q=` search: an id belongs to exactly
   one row, so a search by it could only ever answer with the row already on
   screen. It carries the list's own query as `?from=`, so the back link on the
   page it opens returns to this exact page — same filter, same search, same
   cursor.

   The type sits under it, smaller and quieter, in sans: the dots in a name
   like `case.status.updated` already say it is a symbol, and setting it in the
   id's own mono would have made the cell a wall of one texture with no first
   word. It is simply absent on a row that has no type. #}
{% macro identity(row) %}
  <a href="{{ row.eventHref }}" class="link link-hover block truncate font-mono text-sm font-semibold" title="{{ row.eventId }}" data-testid="event-id">{{ row.eventId }}</a>
  {% if row.type %}
    <div class="truncate text-xs text-base-content/60" title="{{ row.type }}" data-testid="event-type">{{ row.type }}</div>
  {% endif %}
{% endmacro %}

{# Which hop, and where the message was going. Not `A → B (via …)`: producer →
   consumer is the fact a developer works out once and then knows, and it was
   spending the widest column on the page saying it on every row.

   The first line is which hop a row is. An outbox write and the inbox consume
   that answers it carry one event id, so searching that id returns both, and
   until this line said `GAS · Outbox` against `CW · Inbox` nothing on either
   row told them apart. It is spelled by the same `toSourceName` the journey
   table uses, so a row and the page it opens say the hop the same way.

   The second is where the message went: `to Caseworking`, resolved through the
   same subscription map the detail page's Route uses. The transport's own name
   — the string that gets pasted into an AWS console or a log query — is on the
   title, whole and unshortened. An inbox row has no topic to name, so line two
   names the producer instead: `from GAS`.

   The hop is a link to this page filtered to its service. #}
{% macro sourceCell(row) %}
  {%- if row.hopHref -%}
    <a href="{{ row.hopHref }}" class="link link-hover block truncate" title="{{ row.hopTitle }}" data-testid="event-hop">{{ row.hop }}</a>
  {%- else -%}
    <div class="truncate" data-testid="event-hop">{{ row.hop }}</div>
  {%- endif -%}
  {%- if row.queue %}
    <div class="truncate text-xs text-base-content/50"{% if row.queueValue %} title="{{ row.queueValue }}"{% endif %} data-testid="event-queue">{{ row.queue }}</div>
  {%- endif -%}
{% endmacro %}

{# What the status is, and — only on the rows that have one — how it got there.

   Failure was a column of its own, and on a healthy page it was a ruled column
   of dashes. But a count and a time are not a fact about an event, they are a
   fact about its *status*, so they belong under it. A row that has failed says
   `attempts 5/5 · 5h 36m ago` on a second line; a row that has not is one line
   tall and says nothing at all.

   The sub-lines are indented to the label above them, so the status column
   reads as one left edge whether a row has one line or four. Muted mono: they
   are detail under a headline, not a second headline.

   Never red, except the error itself. A row that failed once and recovered is
   not a problem, and the dot and the row tint already say which rows are. #}
{% macro statusDetail(row) %}
  {%- if row.hasFailure or row.showAttempts -%}
    <div class="truncate pl-3.5 font-mono text-xs tabular-nums text-base-content/50" title="{{ row.failureTitle }}" data-testid="event-failure">attempts <span data-testid="event-attempts">{{ row.attempts }}</span> <span class="text-base-content/30" aria-hidden="true">·</span> <span data-testid="event-last-failure">{% if row.hasFailure %}{{ row.lastFailureAt }}{% else %}—{% endif %}</span></div>
  {%- endif -%}
  {%- if row.errorMessage -%}
    <div class="truncate pl-3.5 font-mono text-xs text-error/70" title="{{ row.errorTitle }}" data-testid="event-error">{{ row.errorMessage }}</div>
  {%- endif -%}
  {# How long it took, on the rows that finished. `Completed` said that a
     message got through and never said how long it took to, and a queue whose
     whole job is to be quick had no figure on this page saying whether it
     was. #}
  {%- if row.latency -%}
    <div class="truncate pl-3.5 font-mono text-xs tabular-nums text-base-content/50" title="Time from created to completed" data-testid="event-latency">took {{ row.latency }}</div>
  {%- endif -%}
{% endmacro %}

{# One row of the table, four cells. There was a fifth, a gutter holding a
   checkbox on every dead letter, which is gone with the batch redrive it fed:
   an event is redriven from its own page now, one decision at a time.

   A dead letter is the one row that wears a treatment of its own. Every other
   state on this page recedes — the commonest of them, Completed, as far as
   grey text — so the faint error wash is the only saturated thing on a calm
   page, and the exception is what the eye lands on from across the room. #}
{% macro eventRow(row) %}
  <tr class="{{ "bg-error/5 hover:bg-error/10" if row.isDeadLetter else "hover:bg-base-200" }}" data-testid="event-row">
    <td>{{ identity(row) }}</td>
    <td class="overflow-hidden" data-testid="event-status">
      {{ statusBadge({
        status: row.status,
        label: row.statusLabel,
        role: row.statusRole,
        retrying: row.statusRetrying
      }) }}
      {{ statusDetail(row) }}
    </td>
    <td>{{ sourceCell(row) }}</td>
    <td class="text-right">
      <div class="font-mono text-xs tabular-nums" title="{{ row.createdAtTitle }}" data-testid="event-created-at">{{ row.createdAt }}</div>
      {# The instant itself, under the age of it. `22m ago` is the right first
         reading and the wrong thing to match against a log line, and the
         absolute was on a tooltip nobody hovers while scanning a column.

         The date arrives once the row is more than a day old, and the seconds
         go with it: `1 Sep 08:18` places a row a keyset window has reached
         back to, and `08:18:01` places one from this morning. #}
      {% if row.createdAtClock %}<div class="font-mono text-xs tabular-nums text-base-content/40" title="{{ row.createdAtTitle }}" data-testid="event-created-clock"><span data-testid="event-created-clock-text">{{ row.createdAtClock }}</span></div>{% endif %}
    </td>
  </tr>
{% endmacro %}

{# The one page in the app that is an application rather than a document: the
   viewport is the frame, the heading and the toolbar take what they need, and
   the card below them takes everything that is left. The document itself never
   scrolls — the table does, inside the card — so the filters an operator works
   with stay on screen and the last row of a full page is the last row of the
   viewport rather than something below the fold.

   A short page keeps the same frame. Three rows in a card that stops after
   three rows reads as a broken page; three rows in a full-height card reads as
   a stream that happens to be quiet. #}
{% block bodyClass %} h-dvh overflow-hidden{% endblock %}

{% block content %}
  {# The page's own header, not the navbar. The subtitle says what the page is;
     the toolbar below says which slice of it is on screen, so the two never
     have to narrate each other.

     One line, not three. A display-sized title over a sentence over a rule
     spent sixty pixels of a viewport-height page introducing a table that
     introduces itself — on the one screen an operator keeps open all day. The
     `h1` stays, because the page still has one subject and the skip link still
     has somewhere to land; it is simply set at the size of the words around
     it, with the sentence beside it rather than under it. #}
  <hgroup class="mb-2 flex flex-wrap items-baseline gap-x-2" data-testid="events-heading">
    <h1 class="text-base font-semibold" data-testid="events-title">{{ pageTitle }}</h1>
    <p class="text-sm text-base-content/60" data-testid="events-subtitle">Inbox and outbox messages across GAS, Caseworking and connected services.</p>
  </hgroup>

  {% if unavailableSources %}
    <div role="alert" class="alert alert-warning alert-soft mb-3 text-sm" data-testid="events-partial">
      {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
      <span>Some event sources are unavailable: {{ unavailableSources }}. Showing the rest.</span>
    </div>
  {% endif %}

  {# Two rows, declared rather than emergent.

     Everything used to sit in one wrapping flex line: which controls shared a
     row depended on how wide the count badges happened to render that minute,
     so the toolbar re-laid itself out as the numbers changed and left a ragged
     void beside the last control that fitted. The rows are stated instead —
     what the page is filtered *to* on the first, how it is narrowed and
     searched on the second — and the second row is pushed to the right edge so
     the space between the two clusters is one gap rather than a field.

     Links, not a form: the page carries no client-side JavaScript, and each
     segment is simply the url of the page it selects. Every segment keeps the
     other group's filter and drops the cursor — a keyset position taken under
     one filter means nothing under another. Rendered whatever the table did,
     so a filter that found nothing can still be undone. #}
  <div class="mb-3 grid gap-y-2" data-testid="events-toolbar">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2" data-testid="events-filters">
      {# A label and the group it introduces are one object, so they are nested
         as one: a single flex row spaced them all alike, which put as much air
         between `Status` and its own segments as between the two controls. #}
      <div class="flex items-center gap-2">
        <span class="{{ filterLabel }}" data-testid="events-filter-label">Status</span>
        <div class="join" role="group" aria-label="Filter by status" data-testid="events-filter-status">
          {% for chip in statusFilters %}{{ segment(chip, "events-filter-status-chip") }}{% endfor %}
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="{{ filterLabel }}" data-testid="events-filter-label">Service</span>
        <div class="join" role="group" aria-label="Filter by service" data-testid="events-filter-service">
          {% for chip in serviceFilters %}{{ segment(chip, "events-filter-service-chip") }}{% endfor %}
        </div>
      </div>

    </div>

    {# The second row: the window and the needle, hard right. Neither is a
       facet of the stream — one narrows what the page is asking about and the
       other searches inside it — and both are read left-to-right into the
       table's own right edge. #}
    <div class="flex flex-wrap items-center justify-end gap-x-5 gap-y-2" data-testid="events-controls">
      {# The window, as one control instead of four.

         A `from` box, a `to` box and three quick links took a quarter of the
         filter row to say something none of them said out loud: which window
         the page is actually asking about. This says it on the button — `Last
         24h`, an absolute pair, or `Any time` — and keeps the machinery behind
         it.

         The panel is a popover, and the popover is the whole of the behaviour:
         the browser opens it from `popovertarget`, closes it on Escape and on
         a click anywhere else, and returns focus to the button. There is no
         script here at all — the custom element that used to supply exactly
         those two behaviours is gone. #}
      <div class="flex items-center gap-2" data-testid="events-range">
        <span class="{{ filterLabel }}" data-testid="events-filter-label">Time</span>
        <button class="{{ activeRangeButton if timeRange.active else rangeButton }}" type="button" popovertarget="events-range-panel" style="anchor-name:--events-range" title="{{ timeRange.title }}" data-testid="events-range-button">
          {{ icon({ name: 'clock', class: 'size-3.5 opacity-60' }) }}
          {{ timeRange.label }}
          {{ icon({ name: 'chevron-down', class: 'size-3 opacity-60' }) }}
        </button>
        <div class="dropdown card card-sm w-72 border border-base-300 bg-base-100 shadow-md" popover id="events-range-panel" style="position-anchor:--events-range" data-testid="events-range-panel">
          <div class="card-body gap-2 p-2">
            {# The ladder. Each rung is a plain GET link carrying every other
               filter, exactly as the quick links it replaces did: it writes an
               absolute `from`, clears `to`, drops the cursor, and names itself
               in `range=` so the button can say which rung it is. #}
            <ul class="menu menu-sm w-full p-0" data-testid="events-range-presets">
              {% for preset in timeRange.presets %}
                <li>
                  <a class="{{ "menu-active" if preset.active }}" href="{{ preset.href }}" title="{{ preset.title }}"{% if preset.active %} aria-current="true"{% endif %} data-value="{{ preset.key }}" data-testid="events-range-preset">{{ preset.label }}</a>
                </li>
              {% endfor %}
              {# `Any time` is a rung and not a `Clear ×` off to one side: "no
                 window" is a choice about the range like any other, and this
                 list is the one place an operator looks to make it. #}
              <li>
                <a class="{{ "menu-active" if timeRange.anyTimeActive }}" href="{{ timeRange.anyTimeHref }}"{% if timeRange.anyTimeActive %} aria-current="true"{% endif %} data-testid="events-range-any">Any time</a>
              </li>
            </ul>

            {# The two boxes that take a window no rung offers. Their own GET
               form, not the search one: this is the control whose whole job is
               to replace the window, so it carries the search as a hidden
               field and deliberately carries no `range` — applying a window of
               your own is precisely what stops it being `Last 24h`.

               `datetime-local` has no timezone in it at all — the browser
               shows the operator's own clock and submits a bare wall time —
               and the route reads what it submits as UTC. Every instant this
               page draws is UTC, so nothing says so on screen: a label
               repeated beside every figure is a label nobody reads. The two
               boxes keep it on their titles, where the parsing rule is the one
               thing an operator might actually need told. #}
            <form method="get" action="/dev-ops/events" data-testid="events-range-form">
              {% for field in rangeFilters %}
                <input type="hidden" name="{{ field.name }}" value="{{ field.value }}" data-testid="events-range-filter">
              {% endfor %}
              <fieldset class="fieldset border-t border-base-300 pt-2">
                <legend class="fieldset-legend" data-testid="events-range-absolute-heading">Absolute range</legend>
                <label class="label" for="events-range-from" data-testid="events-range-from-label">From</label>
                <input class="input input-sm w-full font-mono text-xs" id="events-range-from" type="datetime-local" step="1" name="from" value="{{ fromInput }}" data-testid="events-range-from">
                <label class="label" for="events-range-to" data-testid="events-range-to-label">To</label>
                <input class="input input-sm w-full font-mono text-xs" id="events-range-to" type="datetime-local" step="1" name="to" value="{{ toInput }}" data-testid="events-range-to">
                <button class="btn btn-sm mt-2 self-end" type="submit" data-testid="events-range-apply">Apply</button>
              </fieldset>
            </form>
          </div>
        </div>
      </div>

      {# The one control on the page that is a form rather than a link, because
         it is the one that takes a value the server cannot enumerate. It is
         also the shortest path an operator has: they arrive holding an id from
         a log line, a message id from a ticket or a reference from a case, and
         before this the answer was Ctrl+F over one keyset page.

         GET, so a search is a url — shareable, bookmarkable, and
         back-buttonable like every other state of this page.

         A form submits its own fields and nothing else, so every filter the
         toolbar holds is restated as a hidden field: without them, searching
         from a page filtered to Dead letter would quietly widen it to All. The
         window is among them now that its boxes live in the panel above,
         `range` with it, so a search from `Last 24h` comes back still saying
         so. The cursor is deliberately not among them — a keyset position
         taken over the whole stream means nothing over a search of it. #}
      <form class="join" method="get" action="/dev-ops/events" role="search" data-testid="events-search">
        {% for field in searchFilters %}
          <input type="hidden" name="{{ field.name }}" value="{{ field.value }}" data-testid="events-search-filter">
        {% endfor %}
        <label class="input input-sm join-item w-80" data-testid="events-search-label">
          {{ icon({ name: 'search', class: 'size-3.5 opacity-50' }) }}
          <input type="search" name="q" value="{{ q }}" placeholder="Event id, message id or reference…" aria-label="Search events" data-testid="events-search-input">
        </label>
        <button class="btn btn-sm join-item" type="submit" data-testid="events-search-submit">Search</button>
      </form>
    </div>
  </div>

  {# What the page is narrowed to, in the words the toolbar has no segment for.

     Two filters arrive without a control that shows their value: a search that
     is only a string inside a box, and a failure that arrives by being clicked
     in the panel below. Each is a filter an operator forgets is on, and a page
     read under a forgotten filter is a page lying about the stream.

     They sit under the toolbar rather than inside the card, because they are
     filter state and that is where the filters are. Each carries the way out
     of itself, one click, keeping everything else. #}
  {% if q or errorFilter %}
    <div class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs" data-testid="events-filter-notes">
      {% if q %}
        <span class="text-base-content/60" data-testid="events-note-search">Matching <span class="font-mono text-base-content/80">"{{ q }}"</span></span>
        <a class="link link-hover text-base-content/50" href="{{ clearSearchHref }}" data-testid="events-note-search-clear">Clear ×</a>
      {% endif %}
      {# The narrowest filter the page has, and the only one with no control
         anywhere on the toolbar showing its value: without this line an
         operator reads a page about one message with nothing on screen saying
         which. Sixty characters of it, the whole of it on the title. #}
      {% if errorFilter %}
        {% if q %}<span class="text-base-content/30" aria-hidden="true">·</span>{% endif %}
        <span class="text-base-content/60" data-testid="events-note-error">Error: <span class="font-mono text-base-content/80" title="{{ errorFilter.title }}">"{{ errorFilter.label }}"</span></span>
        <a class="link link-hover text-base-content/50" href="{{ errorFilter.clearHref }}" data-testid="events-note-error-clear">Clear ×</a>
      {% endif %}
    </div>
  {% endif %}

  {% if rows | length %}
    {# The list writes nothing. It used to be wrapped in a form, because the
       rows carried checkboxes and a batch redrive submitted them; that flow is
       gone, and with it the last POST on this page. Every write in the app is
       now made from one event's own page, where the operator can see what they
       are about to redrive. #}
    {# The card is the frame and the table inside it is the only thing that
       scrolls: the caption, the failures panel and the pager keep their
       places at the top and the bottom of it while the rows travel past
       between them. #}
    <div class="card card-border flex min-h-0 flex-1 flex-col overflow-hidden bg-base-100" data-testid="events-card">
        {# One row, not two. The failures summary and the caption are both
           *about this result set*, and stacked they were two strips of chrome
           before a single row of data.

           A one-cell grid: both children are placed in the same cell, so the
           disclosure keeps the full width of the card to open into while the
           right-hand cluster sits on its first line. A flex row would have
           given the panel only the width the buttons left it.

           The summary and its chevron are the only click target on the left —
           `w-fit` stops the disclosure at its own words — and everything on
           the right is outside `<summary>`, so neither the figure nor the
           buttons toggle anything. The row is drawn whenever any of them has
           something to say, so the total never disappears with the panel. #}
        {% if eventsTotal or topFailures %}
          <div class="grid shrink-0 grid-cols-1 grid-rows-1 border-b border-base-300" data-testid="events-card-header">

        {# Which failures the dead letters actually are.

           A queue with seven thousand dead letters in it is not seven thousand
           incidents; it is usually three, and the list cannot say which three
           because it is one keyset window ordered by time and the shape of an
           incident is spread across three hundred pages of it. Each row is one
           failure, how many events it has caused, and how long it has been
           causing them — and each row is the link that narrows the page to
           exactly that failure, message and all.

           Open when the page is already about dead letters, and folded shut
           when it is not: a summary of the queue's worst day should not push
           the table down on a page somebody opened to look at something else,
           but it should still say it is there. daisyUI's `collapse` on a
           native `details`, so the disclosure is still the browser's and the
           open state is still the server's. #}
        {% if topFailures %}
          <details class="group collapse col-start-1 row-start-1 max-h-64 overflow-y-auto rounded-none"{% if topFailures.open %} open{% endif %} data-testid="events-failures">
            {# `collapse-arrow` draws its mark against the far edge of the
               panel, which on a full-width row is a chevron a hand's breadth
               from the words it belongs to — and it would land under the
               caption. The glyph is inline instead, immediately after the
               label, turned over when the panel is open. #}
            <summary class="collapse-title flex min-h-10 w-fit items-center gap-1.5 px-4 py-0 text-sm text-base-content/70" data-testid="events-failures-summary">{{ topFailures.summary }}{{ icon({ name: 'chevron-down', class: 'size-3.5 opacity-60 transition-transform group-open:rotate-180' }) }}</summary>
            <div class="collapse-content px-0 pb-2" data-testid="events-failures-list">
              <div class="max-w-full overflow-x-auto">
                <table class="table table-xs" data-testid="events-failures-table">
                  <thead>
                    <tr>
                      <th>Error</th>
                      <th>Type</th>
                      <th class="text-right">Count</th>
                      <th class="text-right">First</th>
                      <th class="text-right">Last</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for group in topFailures.groups %}
                      <tr class="hover:bg-base-200" data-testid="events-failure-row">
                        <td class="max-w-96 truncate">
                          <a class="link link-hover font-mono {{ "text-error" if group.hasError else "text-base-content/50" }}" href="{{ group.href }}" title="{{ group.messageTitle }}" data-testid="events-failure-message">{{ group.message }}</a>
                        </td>
                        {# The failure message beside it is what names this
                           group; the type is the extra fact. A group of rows
                           that store none — audit records — leaves the cell
                           empty rather than standing something in for it. #}
                        <td class="text-base-content/70" data-testid="events-failure-type">{{ group.type if group.type else "" }}</td>
                        <td class="text-right font-mono font-medium tabular-nums" data-testid="events-failure-count">{{ group.countLabel }}</td>
                        <td class="text-right font-mono tabular-nums whitespace-nowrap text-base-content/50" title="{{ group.firstTitle }}" data-testid="events-failure-first">first {{ group.firstAt }}</td>
                        <td class="text-right font-mono tabular-nums whitespace-nowrap text-base-content/50" title="{{ group.lastTitle }}" data-testid="events-failure-last">last {{ group.lastAt }}</td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
              {# The groups that recorded no message are counted like any other,
                 and cannot be isolated like any other: `?error=` matches a
                 message, and there is none. Saying so is the honest answer. #}
              {% if topFailures.hasUnattributed %}
                <p class="px-4 pt-1 text-xs text-base-content/50" data-testid="events-failures-note">Events with no error recorded are counted here but cannot be isolated by a failure filter.</p>
              {% endif %}
            </div>
          </details>
        {% endif %}

        {# The right-hand end of that row: what the filters add up to.

           It is the figure the whole page answers to — it used to be the
           number on the STATUS `All` segment, which put the page's headline
           inside one segment of one control, and a facet at that, so selecting
           a status left it unmoved. It moves when any filter moves.

           It had the two bulk-redrive buttons beside it until they were taken
           off the page. Nothing on this list writes now, and the row is the
           same height without them. #}
        <div class="col-start-1 row-start-1 flex min-h-10 items-center gap-3 self-start justify-self-end px-4" data-testid="events-card-aside">
          {% if eventsTotal %}
            <span class="text-xs tabular-nums text-base-content/60" title="Events matching every filter on this page" data-testid="events-total">{{ eventsTotal }}</span>
          {% endif %}
        </div>
          </div>
        {% endif %}

        {# The table scrolls inside this box, not the page: four columns of ids
           do not fit a phone, and a body that scrolls sideways loses the
           header. The box takes whatever height the card has left, which is
           what gives `table-pin-rows` something to pin the header to and what
           keeps the pager on screen under a page of twenty rows. #}
        <div class="min-h-0 w-full flex-1 overflow-x-auto overflow-y-auto overscroll-contain" data-testid="events-scroller">
          {# `table-fixed`, and every column's share declared on its header.
             An auto table measures its own contents, so the columns moved
             between one page and the next — a page of 24-hex Mongo ids gave
             Event less width than a page of uuids, a page with no failure
             lines under the statuses narrowed Status, and paging felt like the
             table was being rebuilt each time. The proportions are tuned at
             the table's own minimum width, where Event still has room for a
             36-character id and Status for `attempts 5/5 · 2d ago` under its
             label; on a wider screen every column grows by the same ratio.

             The four percent the selection gutter held went to Event and
             Source, the two columns with something to say: an id and a hop are
             read, and a status and a timestamp are glanced at. #}
          <table class="table table-sm table-pin-rows min-w-[64rem] table-fixed" data-testid="events-table">
            <thead>
              <tr data-testid="events-head">
                <th class="w-[46%]">Event</th>
                <th class="w-[19%]">Status</th>
                <th class="w-[21%]">Queue</th>
                {# The one column of figures is right-aligned in the header as
                   well as in the body, so the heading sits over its own column
                   of digits rather than beside it. #}
                <th class="w-[14%] text-right">Created</th>
              </tr>
            </thead>
            <tbody>
              {% for row in rows %}{{ eventRow(row) }}{% endfor %}
            </tbody>
          </table>
        </div>

        {{ pager({
          previousHref: previousHref,
          nextHref: nextHref
        }) }}
    </div>
  {% else %}
    {# Every other outcome keeps the frame. A card that stops after one
       sentence under a full-height toolbar reads as a page that failed to
       draw — and an outage used to have no card at all, so the toolbar was
       left floating over an empty screen with a red strip above it. Nothing
       could be read is a state of the result set like any other, and it is
       reported inside the frame the result set lives in. #}
    <div class="card card-border min-h-0 flex-1 bg-base-100" data-testid="events-card">
      {% if unavailable %}
        <div class="p-4">
          <div role="alert" class="alert alert-error alert-soft text-sm" data-testid="events-error">
            {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
            <span>Events could not be loaded from GAS.</span>
          </div>
        </div>
      {% else %}
        {# An empty page under a search says which search found nothing, and
           offers the way back out of it. `No events found.` under a needle the
           operator typed reads as "this service has no events", which is a much
           more alarming sentence than the true one. #}
        <p class="px-4 py-10 text-center text-sm text-base-content/60" data-testid="events-empty">{% if q %}No events match "{{ q }}". <a class="link link-hover text-base-content/50" href="{{ clearSearchHref }}" data-testid="events-empty-clear">Clear search</a>{% else %}No events found.{% endif %}</p>
      {% endif %}
    </div>
  {% endif %}
{% endblock %}
