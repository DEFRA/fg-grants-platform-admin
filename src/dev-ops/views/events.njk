{% extends 'layouts/page.njk' %}

{% from "audit-switch/macro.njk" import auditSwitch %}
{% from "icon/macro.njk" import icon %}
{% from "load-more/macro.njk" import loadMore %}
{% from "status-badge/macro.njk" import statusBadge %}
{% from "sticky-top/macro.njk" import stickyTop %}

{# Tailwind only sees class names written literally in this file. #}

{% set trigger = "btn [&:has(+:popover-open)]:[--btn-bg:color-mix(in_oklab,var(--btn-color,var(--color-base-200)),#000_5%)] [&:has(+:popover-open)]:[--btn-border:color-mix(in_oklab,var(--btn-color,var(--color-base-200)),#000_7%)] [&:has(+:popover-open)]:[--btn-shadow:0_0_0_0_oklch(0%_0_0/0)] [&:has(+:popover-open)]:translate-y-[0.5px]" %}
{% set triggerActive = "btn font-semibold shadow-[inset_0_-3px_0_var(--color-base-content)] [&:has(+:popover-open)]:[--btn-bg:color-mix(in_oklab,var(--btn-color,var(--color-base-200)),#000_5%)] [&:has(+:popover-open)]:[--btn-border:color-mix(in_oklab,var(--btn-color,var(--color-base-200)),#000_7%)] [&:has(+:popover-open)]:translate-y-[0.5px]" %}
{# The menu is the trigger's next sibling, so `:has(+:popover-open)` turns the chevron with no script. #}
{% set chevron = "size-4 opacity-60 transition-transform [:has(+:popover-open)>&]:rotate-180" %}

{% set triggerName = "font-normal opacity-70" %}

{% set menu = "dropdown menu menu-md mt-2 w-60 rounded-box border border-base-300 bg-base-100 p-2 shadow-md" %}
{% set menuItem = "flex items-center gap-2" %}
{% set menuItemActive = "flex items-center gap-2 font-semibold" %}
{% set tick = "size-4.5 shrink-0" %}
{% set tickHidden = "size-4.5 shrink-0 invisible" %}

{% set tile = "stat px-4 py-2 hover:bg-base-200 focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-base-content" %}
{% set tileActive = "stat px-4 py-2 shadow-[inset_0_-3px_0_var(--color-base-content)] focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-base-content" %}
{% set tileTitle = "stat-title" %}
{% set tileTitleActive = "stat-title font-semibold text-base-content" %}
{% set tileValue = "stat-value min-w-[7ch] text-xl tabular-nums" %}
{% set tileValueQuiet = "stat-value min-w-[7ch] text-xl tabular-nums text-base-content/60" %}
{# Accepted contrast shortfall: 2.86:1 in light. #}
{% set tileValueAlarm = "stat-value min-w-[7ch] text-xl tabular-nums text-error" %}

{% set rowClass = "relative cursor-pointer hover:bg-base-200 has-[:focus-visible]:bg-base-200 has-[:focus-visible]:outline-2 has-[:focus-visible]:-outline-offset-2 has-[:focus-visible]:outline-base-content" %}
{% set rowClassDeadLetter = "relative cursor-pointer bg-error/5 hover:bg-error/10 has-[:focus-visible]:bg-error/10 has-[:focus-visible]:outline-2 has-[:focus-visible]:-outline-offset-2 has-[:focus-visible]:outline-base-content" %}

{% macro identity(row) %}
  <a href="{{ row.eventHref }}" class="block truncate text-sm font-semibold no-underline after:absolute after:inset-0 focus-visible:outline-none" data-testid="event-link"><span aria-hidden="true" data-testid="event-type-name">{{ row.eventName.name }}</span><span class="sr-only" data-testid="event-link-name">{{ row.eventName.spoken }}, event {{ row.eventId }}</span></a>
  <div class="relative w-fit max-w-full truncate font-mono text-sm text-base-content/70" aria-hidden="true" data-testid="event-id">{{ row.eventId }}</div>
{% endmacro %}

{% macro statusDetail(row) %}
  {%- if row.latency -%}
    <div class="relative w-fit truncate pl-3.5 font-mono text-sm tabular-nums text-base-content/70" title="{{ row.latencyTitle }}" data-testid="event-latency">took {{ row.latency }}</div>
  {%- endif -%}
{% endmacro %}

{% macro eventRow(row) %}
  <tr class="{{ rowClassDeadLetter if row.isDeadLetter else rowClass }}" data-testid="event-row">
    <td>{{ identity(row) }}</td>
    <td class="text-center"><div class="truncate" data-testid="event-service">{{ row.serviceLabel }}</div></td>
    <td class="text-center"><div class="truncate" data-testid="event-box">{{ row.boxLabel }}</div></td>
    <td class="overflow-hidden" data-testid="event-status">
      {# Lifted over the row's stretched link, so its title is reachable by mouse. #}
      <span class="relative inline-flex">{{ statusBadge({
        status: row.status,
        label: row.statusLabel,
        role: row.statusRole,
        retrying: row.statusRetrying
      }) }}</span>
      {{ statusDetail(row) }}
    </td>
    <td class="text-right">
      <div class="relative ml-auto w-fit font-mono text-sm tabular-nums" title="{{ row.createdAtTitle }}" data-testid="event-created-at">{{ row.createdAt }}<span class="sr-only" data-testid="event-created-absolute"> ({{ row.createdAtTitle }})</span></div>
      {% if row.createdAtClock %}<div class="relative ml-auto w-fit font-mono text-sm tabular-nums text-base-content/70" title="{{ row.createdAtTitle }}" aria-hidden="true" data-testid="event-created-clock"><span data-testid="event-created-clock-text">{{ row.createdAtClock }}</span></div>{% endif %}
    </td>
  </tr>
{% endmacro %}

{% block htmlAttributes %} class="[@media(min-width:64rem)_and_(min-height:40rem)]:scroll-pt-[calc(var(--sticky-top,15rem)+3rem)]"{% endblock %}
{% block navbarClass %} top-0 [@media(min-width:64rem)_and_(min-height:40rem)]:sticky [@media(min-width:64rem)_and_(min-height:40rem)]:z-30{% endblock %}

{% block content %}
  {% call stickyTop() %}
    <hgroup class="mb-2 flex flex-wrap items-baseline gap-x-2" data-testid="events-heading">
      <h1 class="text-xl font-semibold" data-testid="events-title">{{ pageTitle }}</h1>
      <p class="text-sm text-base-content/60" data-testid="events-subtitle">Inbox and outbox messages across GAS, CW-BE and connected services.</p>
    </hgroup>

    {% if unavailableSources %}
      <div role="alert" class="alert alert-warning alert-soft mb-3 text-sm" data-testid="events-partial">
        {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
        <span>Some event sources are unavailable: {{ unavailableSources }}. Showing the rest.</span>
      </div>
    {% endif %}

    <div class="stats stats-horizontal mb-3 w-fit max-w-full border border-base-300 bg-base-100" role="group" aria-label="Filter by status" data-testid="events-status-tiles">
      {% for chip in statusFilters %}
        {%- set tileName = chip.label if chip.value else "All statuses" -%}
        <a class="{{ tileActive if chip.active else tile }}" href="{{ chip.href }}" aria-label="{{ tileName }}{% if chip.countLabel %}: {{ chip.countLabel }} {{ "event" if chip.countLabel == "1" else "events" }}{% endif %}"{% if chip.active %} aria-current="page"{% endif %}{% if chip.title %} title="{{ chip.title }}"{% endif %}{% if chip.value %} data-value="{{ chip.value }}"{% endif %} data-testid="events-status-tile">
          <div class="{{ tileTitleActive if chip.active else tileTitle }}" data-testid="events-status-tile-label">{{ chip.label }}</div>
          {% if chip.alarming %}
            <div class="{{ tileValueAlarm }}" data-testid="events-status-tile-count">{{ chip.countLabel }}</div>
          {% elif chip.countLabel and not chip.zero %}
            <div class="{{ tileValue }}" data-testid="events-status-tile-count">{{ chip.countLabel }}</div>
          {% else %}
            <div class="{{ tileValueQuiet }}" data-testid="events-status-tile-count">{{ chip.countLabel or "—" }}</div>
          {% endif %}
        </a>
      {% endfor %}
    </div>

    <div class="mb-3 flex flex-wrap items-center gap-2" data-testid="events-toolbar">
      <div class="flex items-center gap-2" data-testid="events-range">
        <button class="{{ triggerActive if timeRange.active else trigger }}" type="button" popovertarget="events-range-panel" title="{{ timeRange.title }}" data-testid="events-range-button">
          {{ icon({ name: 'clock', class: 'size-4 opacity-60' }) }}
          <span><span class="{{ triggerName }}">Time:</span> {{ timeRange.label }}</span>
          {{ icon({ name: 'chevron-down', class: chevron }) }}
        </button>
        <div class="dropdown card card-sm mt-2 w-72 border border-base-300 bg-base-100 shadow-md" popover id="events-range-panel" data-testid="events-range-panel">
          <div class="card-body gap-2 p-2">
            <ul class="menu menu-md w-full p-0" data-testid="events-range-presets">
              <li>
                <a class="{{ menuItemActive if timeRange.anyTimeActive else menuItem }}" href="{{ timeRange.anyTimeHref }}"{% if timeRange.anyTimeActive %} aria-current="page"{% endif %} data-testid="events-range-any">{{ icon({ name: 'check', class: tick if timeRange.anyTimeActive else tickHidden }) }}<span>All</span></a>
              </li>
              {% for preset in timeRange.presets %}
                <li>
                  <a class="{{ menuItemActive if preset.active else menuItem }}" href="{{ preset.href }}" title="{{ preset.title }}"{% if preset.active %} aria-current="true"{% endif %} data-value="{{ preset.key }}" data-testid="events-range-preset">{{ icon({ name: 'check', class: tick if preset.active else tickHidden }) }}<span>{{ preset.label }}</span></a>
                </li>
              {% endfor %}
            </ul>

            <form method="get" action="/dev-ops/events" data-testid="events-range-form">
              {% for field in rangeFilters %}
                <input type="hidden" name="{{ field.name }}" value="{{ field.value }}" data-testid="events-range-filter">
              {% endfor %}
              <fieldset class="fieldset border-t border-base-300 pt-2">
                <legend class="fieldset-legend text-sm" data-testid="events-range-absolute-heading">Custom</legend>
                <label class="label" for="events-range-from" data-testid="events-range-from-label">From</label>
                <input class="input w-full font-mono text-sm" id="events-range-from" type="datetime-local" step="1" name="from" value="{{ fromInput }}" data-testid="events-range-from">
                <label class="label" for="events-range-to" data-testid="events-range-to-label">To</label>
                <input class="input w-full font-mono text-sm" id="events-range-to" type="datetime-local" step="1" name="to" value="{{ toInput }}" data-testid="events-range-to">
                <button class="btn btn-sm mt-2 self-end" type="submit" data-testid="events-range-apply">Apply</button>
              </fieldset>
            </form>
          </div>
        </div>
      </div>

      {%- set service = serviceFilters | selectattr("active") | first -%}
      <div class="flex items-center gap-2" data-testid="events-filter-service">
        <button class="{{ triggerActive if service and service.value else trigger }}" type="button" popovertarget="events-service-panel" data-testid="events-filter-service-button">
          {{ icon({ name: 'server', class: 'size-4.5 opacity-60' }) }}
          <span><span class="{{ triggerName }}">Service:</span> {{ service.label if service else "All" }}</span>
          {{ icon({ name: 'chevron-down', class: chevron }) }}
        </button>
        <ul class="{{ menu }}" popover id="events-service-panel" aria-label="Filter by service" data-testid="events-filter-service-panel">
          {% for chip in serviceFilters %}
            <li><a class="{{ menuItemActive if chip.active else menuItem }}" href="{{ chip.href }}"{% if chip.active %} aria-current="page"{% endif %}{% if chip.value %} data-value="{{ chip.value }}"{% endif %} data-testid="events-filter-service-chip">{{ icon({ name: 'check', class: tick if chip.active else tickHidden }) }}<span>{{ chip.label }}</span></a></li>
          {% endfor %}
        </ul>
      </div>

      {{ auditSwitch(showAudit) }}

      <form class="w-full sm:ml-auto sm:w-auto" method="get" action="/dev-ops/events" role="search" data-testid="events-search">
        {% for field in searchFilters %}
          <input type="hidden" name="{{ field.name }}" value="{{ field.value }}" data-testid="events-search-filter">
        {% endfor %}
        <div class="join flex">
          <label class="input join-item min-w-0 flex-1 sm:w-80 sm:flex-none" data-testid="events-search-label">
            {{ icon({ name: 'search', class: 'size-4.5 shrink-0 opacity-50' }) }}
            <input type="search" name="q" value="{{ q }}" placeholder="Event id, message id or segregation ref…" aria-label="Search events" data-testid="events-search-input">
          </label>
          <button class="btn join-item" type="submit" data-testid="events-search-submit">Search</button>
        </div>
      </form>
    </div>
  {% endcall %}

  {% if q or errorFilter %}
    <div class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm" data-testid="events-filter-notes">
      {% if q %}
        <span class="text-base-content/60" data-testid="events-note-search">Matching <span class="font-mono text-base-content/80">"{{ q }}"</span></span>
        <a class="link text-base-content/70" href="{{ clearSearchHref }}" data-testid="events-note-search-clear">Clear ×</a>
      {% endif %}
      {% if errorFilter %}
        {% if q %}<span class="text-base-content/30" aria-hidden="true">·</span>{% endif %}
        <span class="text-base-content/60" data-testid="events-note-error">Error: <span class="font-mono text-base-content/80" title="{{ errorFilter.title }}">"{{ errorFilter.label }}"</span></span>
        <a class="link text-base-content/70" href="{{ errorFilter.clearHref }}" data-testid="events-note-error-clear">Clear ×</a>
      {% endif %}
    </div>
  {% endif %}

  {% if rows | length %}
    {# `overflow-clip` makes no scroll container, so the header row can still stick. #}
    <div class="card card-border flex flex-col overflow-clip bg-base-100" data-testid="events-card">
        {% if topFailures %}
          <div class="shrink-0 border-b border-base-300" data-testid="events-card-header">
            {# The panel is the only scrollport here: a header pinned inside the wrapper below would resolve against a box that never scrolls. #}
            <details class="group collapse max-h-96 overflow-x-auto overflow-y-auto rounded-none" data-testid="events-failures">
              {# Sticky within the panel, not the viewport, so `--sticky-top` is untouched; the fill is the card's, so rows pass under it. #}
              <summary class="collapse-title sticky top-0 z-2 flex min-h-10 w-full cursor-pointer items-center bg-base-100 px-4 py-0 text-sm text-base-content/70 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-base-content" data-testid="events-failures-summary"><span class="flex w-fit items-center gap-1.5">{{ topFailures.summary }}{{ icon({ name: 'chevron-down', class: 'size-4 opacity-60 transition-transform group-open:rotate-180' }) }}</span></summary>
              <div class="collapse-content px-0 pb-2" data-testid="events-failures-list">
                <div class="max-w-full">
                  {# `[&_thead]:top-10` is the summary band's own 40px; `table-pin-rows` brings daisyUI's fill and z-index. #}
                  <table class="table table-pin-rows [&_thead]:top-10" data-testid="events-failures-table">
                    <thead>
                      <tr>
                        <th scope="col">Error</th>
                        <th scope="col">Type</th>
                        <th scope="col" class="text-right">Count</th>
                        <th scope="col" class="text-right">First</th>
                        <th scope="col" class="text-right">Last</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% for group in topFailures.groups %}
                        <tr class="hover:bg-base-200" data-testid="events-failure-row">
                          <td class="max-w-96 truncate">
                            {%- if group.href -%}
                              <a class="link link-hover font-mono text-error" href="{{ group.href }}"{% if group.messageTitle %} title="{{ group.messageTitle }}"{% endif %} data-testid="events-failure-message">{{ group.message }}</a>
                            {%- else -%}
                              <span class="font-mono text-base-content/50" data-testid="events-failure-message">{{ group.message }}</span>
                            {%- endif -%}
                          </td>
                          <td class="text-base-content/70" title="{{ group.type }}" data-testid="events-failure-type"><span aria-hidden="true">{{ group.eventName.name }}</span><span class="sr-only">{{ group.eventName.spoken }}</span></td>
                          <td class="text-right font-mono font-medium tabular-nums" data-testid="events-failure-count">{{ group.countLabel }}</td>
                          <td class="text-right font-mono tabular-nums whitespace-nowrap text-base-content/70" title="{{ group.firstTitle }}" data-testid="events-failure-first">{{ group.firstAt }}</td>
                          <td class="text-right font-mono tabular-nums whitespace-nowrap text-base-content/70" title="{{ group.lastTitle }}" data-testid="events-failure-last">{{ group.lastAt }}</td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              </div>
            </details>
          </div>
        {% endif %}

        {# Sticky and sideways scrolling cannot share a box: overflow here unpins the header. #}
        <div class="w-full overflow-x-auto [@media(min-width:64rem)_and_(min-height:40rem)]:overflow-visible" data-testid="events-scroller">
          <table class="table table-pin-rows w-full min-w-[64rem] table-fixed [@media(min-width:64rem)_and_(min-height:40rem)]:min-w-0 [@media(min-width:64rem)_and_(min-height:40rem)]:[&_thead]:top-[var(--sticky-top,15rem)]" data-testid="events-table">
            <thead>
              <tr data-testid="events-head">
                <th scope="col" class="w-[41%] xl:w-[52.5%]">Event</th>
                <th scope="col" class="w-[9%] text-center xl:w-[6.5%]">Service</th>
                <th scope="col" class="w-[21%] text-center xl:w-[18.5%]">Queue</th>
                <th scope="col" class="w-[15%] xl:w-[12.5%]">Status</th>
                <th scope="col" class="w-[14%] text-right xl:w-[10%]">Created</th>
              </tr>
            </thead>
            <tbody id="events-rows">
              {% for row in rows %}{{ eventRow(row) }}{% endfor %}
            </tbody>
          </table>
        </div>

        {{ loadMore({ nextHref: nextHref, rows: "events-rows" }) }}
    </div>
  {% else %}
    <div class="card card-border min-h-0 flex-1 bg-base-100" data-testid="events-card">
      {% if refused %}
        <div class="p-4">
          <div role="alert" class="alert alert-warning alert-soft text-sm" data-testid="events-refused">
            {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
            <span>GAS refused this link's parameters. <a class="link" href="/dev-ops/events" data-testid="events-refused-clear">Start again</a>.</span>
          </div>
        </div>
      {% elif unavailable %}
        <div class="p-4">
          <div role="alert" class="alert alert-error alert-soft text-sm" data-testid="events-error">
            {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
            <span>Events could not be loaded from GAS.</span>
          </div>
        </div>
      {% else %}
        {# The count a missing source contributes is a zero nobody counted, so
           the sentence says what was not read rather than leaving "none found"
           to be read as "none exist". #}
        <p class="px-4 py-10 text-center text-sm text-base-content/60" data-testid="events-empty">{% if q %}No events match "{{ q }}". <a class="link text-base-content/70" href="{{ clearSearchHref }}" data-testid="events-empty-clear">Clear search</a>{% else %}No events found.{% endif %}{% if unavailableSources %} <span data-testid="events-empty-unread">Some sources could not be read ({{ unavailableSources }}), so there may be events this page cannot see.</span>{% endif %}</p>
      {% endif %}
    </div>
  {% endif %}
{% endblock %}
