{% import "design-system/macros.njk" as au %}
{#- An event the service couldn't give: not found, timed out or unavailable, with the header kept. -#}
{%- call au.Page() -%}
  {{ au.PageHeader({ title: title, mono: true, back: { href: back.href, text: back.text, testId: 'event-back' }, titleTestId: 'event-title' }) }}

  {%- if missing.state == 'not-found' -%}
    {%- call au.Card({ testId: 'event-not-found' }) -%}
      {{ au.EmptyState({ icon: 'search-x', title: missing.title, text: missing.text, actions: au.Button({ text: back.text, href: back.href }) }) }}
    {%- endcall -%}
  {%- else -%}
    {%- set actions -%}
      {{ au.Button({ text: 'Try again', size: 'sm', iconStart: 'refresh-cw', href: retryHref, testId: 'event-retry' }) }}
      {{ au.Button({ text: back.text, size: 'sm', variant: 'tertiary', href: back.href }) }}
    {%- endset -%}
    {{ au.Alert({ tone: 'danger', title: missing.title, text: missing.text, actions: actions, testId: 'event-' ~ missing.state }) }}
  {%- endif -%}

  {%- if kept -%}
    {#- The edit couldn't be checked against the event: it is shown, so nothing typed is lost. -#}
    {%- call au.Card({ padded: true, title: 'Your changes', actions: au.CopyButton({ value: kept.text, text: 'Copy' }), testId: 'event-kept' }) -%}
      {%- call au.Stack({ gap: 'lg' }) -%}
        {{ au.Text({ tone: 'muted', text: 'They haven’t been saved. Copy them before you leave this page, then try again.' }) }}
        {{ au.Code({ block: true, framed: true, code: kept.text, label: 'Your changes', maxHeight: 360 }) }}
        {%- if kept.note -%}
          {%- call au.FactsList() %}{{ au.Fact({ label: 'Why are you changing it?', text: kept.note }) }}{% endcall -%}
        {%- endif -%}
      {%- endcall -%}
    {%- endcall -%}
  {%- endif -%}
{%- endcall -%}
