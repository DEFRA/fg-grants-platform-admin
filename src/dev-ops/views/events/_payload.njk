{% import "components/macros.njk" as gpa %}
{#- The payload: as stored, or being edited, reviewed, or held after a save the service didn't answer. -#}
{#- A post here lands on `#payload`, and a browser clears focus when that target can't take it: the answer to the post is the target. -#}
{%- set p = payload -%}
{%- set landing = 'payload' -%}

{%- if p.mode == 'view' -%}
  {%- set cardActions -%}
    {%- if p.edited %}{{ gpa.Badge({ text: 'Edited', size: 'sm', tone: 'info', testId: 'event-edited' }) }}{% endif -%}
    {{ gpa.CopyButton({ value: p.text, text: 'Copy' }) }}
    {%- if p.editHref %}{{ gpa.Button({ text: 'Edit', label: 'Edit payload', size: 'sm', iconStart: 'pencil', href: p.editHref, testId: 'event-edit' }) }}{% endif -%}
  {%- endset -%}
  {%- call gpa.Card({ title: 'Payload', id: null if banner else landing, actions: cardActions, testId: 'event-payload' }) -%}
    {{ gpa.Code({ block: true, code: p.text, label: 'Payload', language: 'json' }) }}
  {%- endcall -%}
  {%- if p.original -%}
    {%- call gpa.Disclosure({ text: 'Show the payload before the first edit', hideText: 'Hide the payload before the first edit', summaryTestId: 'event-original-toggle' }) -%}
      {%- call gpa.Card({ title: 'Payload before the first edit', actions: gpa.CopyButton({ value: p.original, text: 'Copy' }), testId: 'event-original' }) -%}
        {{ gpa.Code({ block: true, code: p.original, label: 'Payload before the first edit', language: 'json' }) }}
      {%- endcall -%}
    {%- endcall -%}
  {%- endif -%}

{%- elif p.mode == 'edit' -%}
  {%- call gpa.Card({ padded: true, title: 'Edit payload', id: null if p.landing else landing, testId: 'event-payload-editor' }) -%}
    {%- call gpa.Form({ action: p.action, label: 'Edit payload', wide: true, hidden: [{ name: 'revision', value: p.revision }, { name: 'back', value: p.back }, { name: 'note', value: p.note }] }) -%}
      {%- call gpa.Stack({ gap: 'lg' }) -%}
        {{ gpa.Text({ tone: 'muted', text: 'You’ll review your changes before anything is saved.' }) }}
        {%- if p.unchanged -%}
          {{ gpa.Alert({ tone: 'info', title: 'Nothing to review.', text: 'The payload is unchanged. Edit it, or discard your changes to leave it as it is.', id: landing if p.landing == 'unchanged' else null, focusOnArrival: p.landing == 'unchanged', testId: 'event-unchanged' }) }}
        {%- endif -%}
        {%- if p.stale -%}
          {{ gpa.Alert({ tone: 'danger', title: 'Not saved: the payload changed while you were editing.', text: 'Your version is still in the editor. Review it again to compare it with the payload as it is now, shown below.', id: landing if p.landing == 'stale' else null, focusOnArrival: p.landing == 'stale', testId: 'event-stale' }) }}
        {%- endif -%}
        {%- if p.notPlainJson -%}
          {{ gpa.Alert({ tone: 'warning', title: 'Some values in this payload aren’t plain JSON.', text: 'They’ll be saved as JSON text, for example dates as strings.', testId: 'event-not-plain-json' }) }}
        {%- endif -%}
        {%- call gpa.Stack({ gap: 'xs' }) -%}
          {{ gpa.Textarea({ id: landing if p.landing == 'error' else 'payload-editor', name: 'text', label: 'Payload', language: 'json', errorLine: p.errorLine, rows: p.rows, value: p.text, invalid: p.error, describedBy: 'payload-editor-err' if p.error else null, attributes: { autofocus: not p.landing, 'data-focus-on-arrival': p.landing == 'error' }, testId: 'event-payload-text' }) }}
          {%- if p.error %}{{ gpa.FieldMessage({ id: 'payload-editor-err', tone: 'error', text: p.error, testId: 'event-payload-error' }) }}{% endif -%}
        {%- endcall -%}
        {%- if p.current -%}
          {%- call gpa.Stack({ gap: 'xs' }) -%}
            {{ gpa.Text({ variant: 'label-md', text: 'The payload as it is now' }) }}
            {%- if p.current.by -%}
              {%- set savedBy %}Saved by {{ p.current.by }}{% if p.current.at %} at {{ gpa.Time(p.current.at) }}{% endif %}{% endset -%}
              {{ gpa.Text({ tone: 'subtle', html: savedBy }) }}
            {%- endif -%}
            {{ gpa.Code({ block: true, framed: true, code: p.current.text, label: 'The payload as it is now', maxHeight: 240, language: 'json', testId: 'event-current-payload' }) }}
          {%- endcall -%}
        {%- endif -%}
        {%- call gpa.FormActions() -%}
          {{ gpa.Button({ text: 'Review changes', variant: 'primary', type: 'submit', loadingOnSubmit: true, testId: 'event-review' }) }}
          {{ gpa.Button({ text: 'Discard', href: p.discardHref, testId: 'event-discard' }) }}
        {%- endcall -%}
      {%- endcall -%}
    {%- endcall -%}
  {%- endcall -%}

{%- elif p.mode == 'review' -%}
  {%- call gpa.Card({ padded: true, title: 'Review changes', id: null if p.landing else landing, testId: 'event-payload-review' }) -%}
    {%- call gpa.Form({ action: p.action, label: 'Save payload', wide: true, hidden: [{ name: 'text', value: p.text }, { name: 'revision', value: p.revision }, { name: 'back', value: p.back }] }) -%}
      {%- call gpa.Stack({ gap: 'lg' }) -%}
        {%- if p.landing == 'save-error' -%}
          {{ gpa.Alert({ tone: 'danger', title: p.saveError.title, text: p.saveError.text, id: landing, focusOnArrival: true, testId: 'event-save-error' }) }}
        {%- elif p.landing == 'note' -%}
          {{ gpa.ErrorSummary({ errors: [{ id: 'edit-note', text: p.noteError }], attributes: { id: landing } }) }}
        {%- endif -%}
        {%- for line in p.roundedLines -%}
          {{ gpa.Alert({ tone: 'warning', title: 'Number on line ' ~ line ~ ' will be rounded.', text: 'It’s too large to be saved exactly, so it will be saved rounded, as shown. Put it in quotes if every digit matters.', testId: 'event-rounded' }) }}
        {%- endfor -%}
        {%- if p.notPlainJson -%}
          {{ gpa.Alert({ tone: 'warning', title: 'Some values in this payload aren’t plain JSON.', text: 'They’ll be saved as JSON text, for example dates as strings.', testId: 'event-not-plain-json' }) }}
        {%- endif -%}
        {{ gpa.DiffViewer({ label: 'Your changes', before: p.before, after: p.text, maxHeight: 360, testId: 'event-diff' }) }}
        {%- call gpa.Field({ id: 'edit-note', label: 'Why are you changing it?', hint: 'Saved with the edit and shown on the event. Don’t include personal data.', error: p.noteError, count: { max: p.noteMax, value: p.note }, countId: 'edit-note-count', errorTestId: 'event-note-error' }) -%}
          {{ gpa.Textarea({ id: 'edit-note', name: 'note', rows: 3, value: p.note, invalid: p.noteError, maxlength: p.noteMax, describedBy: gpa.describedBy({ id: 'edit-note', hint: true, error: p.noteError, extra: 'edit-note-count' }), testId: 'event-note' }) }}
        {%- endcall -%}
        {%- call gpa.FormActions() -%}
          {{ gpa.Button({ text: 'Redrive', variant: 'primary', iconStart: 'refresh-cw', type: 'submit', name: 'then', value: 'redrive', loadingOnSubmit: true, testId: 'event-save-redrive' }) }}
          {{ gpa.Button({ text: 'Save', type: 'submit', loadingOnSubmit: true, testId: 'event-save' }) }}
          {{ gpa.Button({ text: 'Back', variant: 'tertiary', type: 'submit', name: 'step', value: 'edit', attributes: { formaction: p.reviewAction }, testId: 'event-review-back' }) }}
        {%- endcall -%}
      {%- endcall -%}
    {%- endcall -%}
  {%- endcall -%}

{%- elif p.mode == 'held' -%}
  {%- call gpa.Card({ padded: true, title: 'Your changes', testId: 'event-payload-held' }) -%}
    {%- call gpa.Stack({ gap: 'lg' }) -%}
      {{ gpa.Alert({ tone: 'danger', title: p.title, text: p.body, id: landing, focusOnArrival: true, testId: 'event-held' }) }}
      {{ gpa.DiffViewer({ label: 'Your changes', before: p.before, after: p.text, maxHeight: 320, testId: 'event-held-diff' }) }}
      {%- call gpa.FactsList() %}{{ gpa.Fact({ label: 'Why are you changing it?', text: p.note }) }}{% endcall -%}
      {%- call gpa.Form({ action: p.action, label: 'Try the save again', hidden: [{ name: 'text', value: p.text }, { name: 'revision', value: p.revision }, { name: 'note', value: p.note }, { name: 'back', value: p.back }] }) -%}
        {%- call gpa.FormActions() -%}
          {%- if p.canRetry %}{{ gpa.Button({ text: 'Try again', variant: 'primary', type: 'submit', name: 'then' if p.then else null, value: p.then if p.then else null, loadingOnSubmit: true, testId: 'event-held-retry' }) }}{% endif -%}
          {{ gpa.Button({ text: 'Cancel', href: p.cancelHref, testId: 'event-held-cancel' }) }}
        {%- endcall -%}
      {%- endcall -%}
    {%- endcall -%}
  {%- endcall -%}
{%- endif -%}
