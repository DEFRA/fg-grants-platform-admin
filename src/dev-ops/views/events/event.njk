{% extends 'layouts/page.njk' %}

{#- The page a redrive returned checks for its result; no other render does. -#}
{% block headScripts %}
  {%- if watch %}<script type="module" src="{{ getAssetPath('src/dev-ops/client/event-watch.ts') }}"></script>{% endif -%}
{% endblock %}

{#- One event: its status and id, its payload or its history, and the redrive and purge that act on it. -#}
{% block content %}
  {%- if missing -%}
    {% include "events/_missing.njk" %}
  {%- else -%}
    {% include "events/_record.njk" %}
  {%- endif -%}
{% endblock %}
