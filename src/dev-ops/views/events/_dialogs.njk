{% import "components/macros.njk" as gpa %}
{#- Redrive and purge: each opens from its button with a script, and arrives open from the address without one. -#}

{%- macro prodNote(d) -%}
  {%- if d.prod -%}
    {%- call gpa.Inline({ gap: 'sm', align: 'center' }) -%}
      {{ gpa.Badge({ text: 'prod', size: 'sm', tone: 'danger', variant: 'outline' }) }}{{ gpa.Text({ text: 'This changes production.', variant: 'label-md' }) }}
    {%- endcall -%}
  {%- endif -%}
{%- endmacro -%}

{%- if redriveDialog -%}
  {%- set d = redriveDialog -%}
  {%- set redriveActions -%}
    {{ gpa.Button({ text: 'Cancel', href: d.closeHref, attributes: { 'data-gpa-close': true } }) }}
    {{ gpa.Button({ text: 'Redrive', variant: 'primary', type: 'submit', form: 'redrive-form', loadingOnSubmit: true, testId: 'redrive-submit' }) }}
  {%- endset -%}
  {%- call gpa.Dialog({ id: d.id, title: 'Redrive this event?', open: d.open, closeHref: d.closeHref, actions: redriveActions, testId: 'redrive-dialog' }) -%}
    {%- call gpa.Stack({ gap: 'md' }) -%}
      {{ prodNote(d) }}
      {{ gpa.Text({ text: 'It goes back in the queue and is tried up to ' ~ d.allowed ~ ' more times.' if d.allowed else 'It goes back in the queue.' }) }}
      {%- if d.unchanged -%}
        {{ gpa.Text({ text: 'Nothing has changed since it failed. If the cause hasn’t been fixed in ' ~ d.service ~ ', it will fail again.', tone: 'muted', testId: 'redrive-unchanged' }) }}
      {%- endif -%}
      {%- if d.edited -%}
        {%- set editedText %}It will use the payload edited by {{ d.edited.by }}{% if d.edited.at %} on {{ gpa.Time(d.edited.at) }}{% endif %}, not the original.{% endset -%}
        {{ gpa.Alert({ tone: 'info', html: editedText, testId: 'redrive-edited' }) }}
      {%- endif -%}
      {%- if d.purged -%}
        {%- set purgedText %}It was purged{% if d.purged.at %} on {{ gpa.Time(d.purged.at) }}{% endif %} by {{ d.purged.by }}. Redriving brings it back to the queue; the purge stays in its history.{% endset -%}
        {{ gpa.Alert({ tone: 'info', html: purgedText, testId: 'redrive-purged' }) }}
      {%- endif -%}
      {{ gpa.Form({ id: 'redrive-form', action: d.action, label: 'Redrive this event', hidden: [{ name: 'back', value: d.back }, { name: 'tab', value: d.tab }] }) }}
    {%- endcall -%}
  {%- endcall -%}
{%- endif -%}

{%- if purgeDialog -%}
  {%- set d = purgeDialog -%}
  {%- set purgeActions -%}
    {{ gpa.Button({ text: 'Cancel', href: d.closeHref, attributes: { 'data-gpa-close': true } }) }}
    {{ gpa.Button({ text: 'Purge', variant: 'danger-solid', type: 'submit', form: 'purge-form', loadingOnSubmit: true, testId: 'purge-submit' }) }}
  {%- endset -%}
  {%- call gpa.Dialog({ id: d.id, title: 'Purge this event?', tone: 'danger', open: d.open, resetOnOpen: true, closeHref: d.closeHref, actions: purgeActions, testId: 'purge-dialog' }) -%}
    {%- call gpa.Stack({ gap: 'lg' }) -%}
      {{ prodNote(d) }}
      {%- set deleted %}It stops being retried and is no longer a dead letter.{% if d.deletionDay %} You can still redrive it until {{ gpa.Time(d.deletionDay) }}, when it’s deleted.{% endif %}{% endset -%}
      {{ gpa.Text({ html: deleted }) }}
      {%- call gpa.Form({ id: 'purge-form', action: d.action, label: 'Purge this event', hidden: [{ name: 'back', value: d.back }, { name: 'tab', value: d.tab }] }) -%}
        {%- call gpa.Stack({ gap: 'lg' }) -%}
          {{ gpa.RadioGroup({ name: 'reasonCode', id: 'purge-reason', label: 'Reason', options: d.reasons, error: d.reasonError, errorTestId: 'purge-reason-error' }) }}
          {%- call gpa.Field({ id: 'purge-note', label: 'Note', optionalUnless: { name: 'reasonCode', value: d.otherReason, current: d.reasonCode }, hint: 'Shown on the event. Don’t include personal data.', error: d.noteError, count: { max: d.noteMax, value: d.note }, countId: 'purge-note-count', errorTestId: 'purge-note-error' }) -%}
            {{ gpa.Textarea({ id: 'purge-note', name: 'note', rows: 3, value: d.note, invalid: d.noteError, maxlength: d.noteMax, describedBy: gpa.describedBy({ id: 'purge-note', hint: true, error: d.noteError, extra: 'purge-note-count' }), testId: 'purge-note' }) }}
          {%- endcall -%}
        {%- endcall -%}
      {%- endcall -%}
    {%- endcall -%}
  {%- endcall -%}
{%- endif -%}
