{% import "design-system/macros.njk" as au %}

{#- A mapped value: where it comes from, then the value as written. A calculated one points to the Calculated fields table when the page has one. -#}
{% macro valueCell(cell, calculatedTable) -%}
  {%- if not cell -%}
    {{ au.NoValue() }}
  {%- else -%}
    {%- call au.Inline({ gap: 'xs' }) -%}
      {{ au.Text({ text: cell.how, tone: 'subtle' }) }}
      {%- if cell.calculated and calculatedTable -%}
        {{ au.Text({ text: 'see Calculated fields', tone: 'subtle' }) }}
      {%- elif cell.value !== null -%}
        {{ au.Text({ text: cell.value, mono: true }) }}
      {%- else -%}
        {{ au.Text({ text: 'empty', tone: 'subtle' }) }}
      {%- endif -%}
    {%- endcall -%}
  {%- endif -%}
{%- endmacro %}

{#- Field and Value, a row per mapped field. -#}
{% macro valueTable(label, rows, calculatedTable, testId) -%}
  {%- call au.DataTable({ styleNonce: styleNonce, label: label, testId: testId, columns: [
    { key: 'field', label: 'Field', width: 'minmax(180px, 1fr)', mono: true },
    { key: 'value', label: 'Value', width: 'minmax(260px, 3fr)' }
  ] }) -%}
    {%- for row in rows -%}
      {%- call au.TableRow() -%}
        <td role="cell" class="au-cell-mono">{{ row.field }}</td>
        <td role="cell">{{ valueCell(row, calculatedTable) }}</td>
      {%- endcall -%}
    {%- endfor -%}
  {%- endcall -%}
{%- endmacro %}
