{% import "design-system/macros.njk" as au %}

{% macro statusLink(ref) -%}
  {%- if ref.href %}{{ au.Link({ text: ref.name, href: ref.href }) }}{% else %}{{ au.Code({ text: ref.position }) }}{% endif -%}
{%- endmacro %}

{% macro arrowRow(icon, ref) -%}
  {%- call au.Inline({ gap: 'sm', align: 'center' }) -%}
    {{ au.Icon({ name: icon, size: 'sm', classes: 'au-dir-icon' }) }}{{ statusLink(ref) }}
  {%- endcall -%}
{%- endmacro %}

{% macro wayIn(way) -%}
  {%- if way.kind == 'move' -%}
    {{ arrowRow('arrow-left', way.from) }}
  {%- elif way.kind == 'code' -%}
    {%- call au.Inline({ gap: 'sm', align: 'center' }) -%}{{ au.Code({ text: way.code }) }}{{ au.Text({ text: 'matches no status in this version', tone: 'subtle' }) }}{%- endcall -%}
  {%- else -%}
    {%- set any %}Any status: GAS accepts this move from every position (no {{ au.Code({ text: 'validFrom' }) }}).{% endset -%}
    {{ au.Text({ html: any }) }}
  {%- endif -%}
{%- endmacro %}

{% macro trigger(item) -%}
  {%- call au.Inline({ gap: 'sm', align: 'center' }) -%}
    {%- if item.kind == 'external' -%}
      {%- if item.unknown %}{{ au.Badge({ text: item.source, tone: 'warning', size: 'sm' }) }}{% else %}{{ au.Text({ text: item.source }) }}{% endif -%}
      {%- if item.href %}{{ au.Link({ html: au.Code({ text: item.code }), href: item.href }) }}{% else %}{{ au.Code({ text: item.code }) }}{% endif -%}
      {{ au.Text({ text: 'while the application is in ' ~ item.stageName, tone: 'subtle' }) }}
    {%- elif item.kind == 'claim' -%}
      {{ au.Link({ text: 'Last claim submitted', href: item.href }) }}{{ au.Text({ text: 'while the application is at ' ~ item.at.name, tone: 'subtle' }) }}
    {%- else -%}
      {{ au.Text({ text: 'GAS process' }) }}{{ au.Code({ text: item.process }) }}{{ au.Text({ text: 'on entering ' ~ item.onEntering ~ ((', when ' ~ item.onlyWhen) if item.onlyWhen else ''), tone: 'subtle' }) }}
    {%- endif -%}
  {%- endcall -%}
  {%- if item.missingStage -%}
    {%- set missing %}Applies only to applications still in {{ au.Code({ text: item.missingStage }) }} from an earlier version: this version has no such stage.{% endset -%}
    {{ au.Text({ html: missing, tone: 'subtle' }) }}
  {%- endif -%}
{%- endmacro %}

{#- One status's aside: shown while it is the pick, hidden otherwise. -#}
{% macro grantStatusPanel(panel, hidden) -%}
  {%- call au.Card({ padded: true, title: 'Selected status', testId: 'grant-status-panel', attributes: { 'data-state': panel.id, hidden: hidden } }) -%}{%- call au.Stack({ gap: 'lg' }) -%}
    {%- call au.Inline({ gap: 'sm', align: 'center' }) -%}
      {{ au.Heading({ level: 3, text: panel.name }) }}
      {%- for badge in panel.badges %}{{ au.Badge({ text: badge, size: 'sm' }) }}{% endfor -%}
    {%- endcall -%}
    {%- for target in panel.undefinedTargets -%}
      {%- set body %}{% if target.onlyWhen %}When {{ target.onlyWhen }}, GAS{% else %}GAS{% endif %} moves the application to {{ au.Code({ text: target.position }) }}, which this grant doesn’t define.{% endset -%}
      {{ au.Alert({ tone: 'warning', html: body, testId: 'grant-status-undefined-target' }) }}
    {%- endfor -%}
    {%- call au.FactsList({ stacked: true }) -%}
      {{ au.Fact({ label: 'Phase', text: panel.phase }) }}
      {{ au.Fact({ label: 'Stage', text: panel.stage }) }}
      {%- if panel.runs and panel.runs.kind == 'processes' -%}
        {%- set runs %}{% call au.Inline({ gap: 'xs' }) %}{% for process in panel.runs.processes %}{{ au.Code({ text: process }) }}{% endfor %}{% endcall %}{% endset -%}
        {{ au.Fact({ label: 'Runs', html: runs }) }}
      {%- elif panel.runs -%}
        {{ au.Fact({ label: 'Runs', text: 'Nothing: move only' }) }}
      {%- endif -%}
      {%- set waysIn -%}
        {%- if panel.waysIn | length -%}
          {%- call au.Stack({ gap: 'xs' }) %}{% for way in panel.waysIn %}{{ wayIn(way) }}{% endfor %}{% endcall -%}
        {%- else %}{{ au.NoValue() }}{% endif -%}
      {%- endset -%}
      {{ au.Fact({ label: 'Ways in', html: waysIn }) }}
      {%- set waysOut -%}
        {%- if panel.waysOut | length -%}
          {%- call au.Stack({ gap: 'xs' }) %}{% for ref in panel.waysOut %}{{ arrowRow('arrow-right', ref) }}{% endfor %}{% endcall -%}
        {%- else %}{{ au.Text({ text: 'None. Applications stay here.', tone: 'subtle' }) }}{% endif -%}
      {%- endset -%}
      {{ au.Fact({ label: 'Ways out', html: waysOut }) }}
      {%- set triggeredBy -%}
        {%- if panel.triggeredBy | length -%}
          {%- call au.Stack({ gap: 'xs' }) %}{% for item in panel.triggeredBy %}{{ trigger(item) }}{% endfor %}{% endcall -%}
        {%- elif panel.noTrigger == 'initial' -%}
          {{ au.Text({ text: 'Set when the application is submitted.' }) }}
        {%- elif panel.noTrigger == 'nothing' -%}
          {{ au.Text({ text: 'Nothing in this version sets this status.', tone: 'warning' }) }}
        {%- else %}{{ au.NoValue() }}{% endif -%}
      {%- endset -%}
      {{ au.Fact({ label: 'Triggered by', html: triggeredBy }) }}
    {%- endcall -%}
  {%- endcall -%}{%- endcall -%}
{%- endmacro %}
