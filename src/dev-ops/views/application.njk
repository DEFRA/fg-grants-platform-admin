{% extends 'layouts/page.njk' %}
{% set navActive = 'applications' %}

{% from "back/macro.njk" import back %}
{% from "event-row/macro.njk" import eventRow, eventsHead %}
{% from "icon/macro.njk" import icon %}
{% from "json-viewer/macro.njk" import jsonViewer %}

{# Tailwind only sees class names written literally in this file. #}
{% set factLabel = "text-sm font-medium text-base-content/70" %}
{% set monoValue = "font-mono text-sm leading-none break-all" %}
{% set monoMuted = "font-mono text-sm leading-none text-base-content/70" %}
{% set monoTime = "font-mono text-sm leading-none tabular-nums whitespace-nowrap" %}
{% set facts = "grid grid-cols-1 content-start gap-x-6 gap-y-3 sm:grid-cols-[8rem_minmax(0,1fr)]" %}

{% macro fact(label, testId) %}
  <div class="contents" data-testid="{{ testId }}">
    <dt class="{{ factLabel }}">{{ label }}</dt>
    <dd class="min-w-0">{{ caller() }}</dd>
  </div>
{% endmacro %}

{% macro date(value, testId) %}
  {%- if value.instant -%}
    <time class="{{ monoTime }}" datetime="{{ value.instant }}" data-testid="{{ testId }}">{{ value.text }}</time>
  {%- else -%}
    <span class="{{ monoMuted }}" data-testid="{{ testId }}">{{ value.text }}</span>
  {%- endif -%}
{% endmacro %}

{% block pageTitle %}Application {{ clientRef }} | {{ serviceName }}{% endblock %}

{% block content %}
  {{ back({ href: backHref, list: "applications", navLabel: "Applications list", testId: "application" }) }}

  <header class="mt-2 mb-5 flex flex-wrap items-start justify-between gap-x-6 gap-y-2" data-testid="application-header">
    <div class="min-w-0">
      <h1 class="flex flex-wrap items-baseline gap-x-2 text-xl font-semibold break-words" data-testid="application-title"><span>Application</span> <span class="font-mono text-sm font-normal break-all text-base-content/70 select-all" data-testid="application-ref">{{ clientRef }}</span></h1>
      {% if trail | length %}
        <p class="mt-2 flex flex-wrap items-center gap-x-1.5 text-sm" data-testid="application-position">
          {% for step in trail %}
            {% if not loop.first %}<span class="text-base-content/50" aria-hidden="true">›</span>{% endif %}
            <span{% if step.current %} class="font-semibold"{% endif %} data-testid="application-position-step">{{ step.label }}</span>
          {% endfor %}
        </p>
      {% endif %}
    </div>
    {% if caseHref %}
      <nav class="text-sm" aria-label="Related records" data-testid="application-related">
        <a class="link link-hover inline-flex items-center gap-1" href="{{ caseHref }}" data-testid="application-view-case">View case{{ icon({ name: 'arrow-right', class: 'size-4' }) }}</a>
      </nav>
    {% endif %}
  </header>

  {% if unavailable %}
    <div role="alert" class="alert alert-error alert-soft text-sm" data-testid="application-error">
      {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
      <span>{% if timedOut %}This application could not be loaded: GAS timed out waiting for it. Refresh to try again.{% else %}This application could not be loaded from GAS.{% endif %}</span>
    </div>
  {% else %}
    {% if caseUnknown %}
      <div role="alert" class="alert alert-warning alert-soft mb-4 text-sm" data-testid="application-case-unknown">
        {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
        <span>CW unavailable. Case link unknown.</span>
      </div>
    {% endif %}

    <nav class="mb-4" aria-label="Sections" data-testid="application-tabs">
      <div class="tabs tabs-border">
        {% for item in tabs %}
          <a class="tab{% if item.active %} tab-active{% endif %}" href="{{ item.href }}"{% if item.active %} aria-current="page"{% endif %} data-testid="application-tab">{{ item.label }}</a>
        {% endfor %}
      </div>
    </nav>

    {% if sectionError %}
      <div role="alert" class="alert alert-error alert-soft text-sm" data-testid="application-section-error">
        {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
        <span>{{ sectionError }}</span>
      </div>
    {% elif tab == "overview" and overview %}
      <section class="card card-border bg-base-100" aria-label="Overview" data-testid="application-overview">
        <div class="card-body p-5">
          {# Two lists, not one grid: auto-placement never goes backwards, so the right-hand facts would stack below the left. #}
          <div class="grid gap-x-6 gap-y-3 text-sm lg:grid-cols-2" data-testid="application-facts">
            <dl class="{{ facts }}">
              {% call fact("Grant", "application-fact-grant") %}
                <span class="{{ monoValue }}" data-testid="application-grant">{{ overview.grant }}</span>{% if overview.grantFrom %} <span class="{{ monoMuted }}" data-testid="application-grant-from">from {{ overview.grantFrom }}</span>{% endif %}
              {% endcall %}
              {% call fact("Submitted", "application-fact-submitted") %}{{ date(overview.submitted, "application-submitted") }}{% endcall %}
              {% call fact("Created", "application-fact-created") %}{{ date(overview.created, "application-created") }}{% endcall %}
              {% call fact("Updated", "application-fact-updated") %}{{ date(overview.updated, "application-updated") }}{% endcall %}
            </dl>
            <dl class="{{ facts }}">
              {% call fact("SBI", "application-fact-sbi") %}<span class="{{ monoValue }}" data-testid="application-sbi">{{ overview.sbi }}</span>{% endcall %}
              {% call fact("FRN", "application-fact-frn") %}<span class="{{ monoValue }}" data-testid="application-frn">{{ overview.frn }}</span>{% endcall %}
              {% call fact("CRN", "application-fact-crn") %}<span class="{{ monoValue }}" data-testid="application-crn">{{ overview.crn }}</span>{% endcall %}
              {% call fact("Series", "application-fact-series") %}
                {% if overview.series | length %}
                  <span class="flex flex-wrap items-center gap-x-1.5 gap-y-1" data-testid="application-series">
                    {% for item in overview.series %}
                      {% if not loop.first %}<span class="text-base-content/50" aria-hidden="true">→</span>{% endif %}
                      {% if item.href %}
                        <a class="link link-hover {{ monoValue }}" href="{{ item.href }}" data-testid="application-series-ref">{{ item.ref }}</a>
                      {% else %}
                        <span class="{{ monoValue }} font-semibold" aria-current="page" data-testid="application-series-ref">{{ item.ref }}</span>
                      {% endif %}
                      {% if item.latest %}<span class="badge badge-ghost badge-sm" data-testid="application-series-latest">latest</span>{% endif %}
                    {% endfor %}
                  </span>
                {% else %}
                  <span class="{{ monoMuted }}" data-testid="application-series-none">—</span>
                {% endif %}
              {% endcall %}
              {% call fact("Size", "application-fact-size") %}<span data-testid="application-size">{{ overview.size }}</span>{% endcall %}
            </dl>
          </div>
        </div>
      </section>
    {% elif tab == "events" and events %}
      {% if unavailableSources %}
        <div role="alert" class="alert alert-warning alert-soft mb-3 text-sm" data-testid="application-events-partial">
          {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
          <span>Some event sources are unavailable: {{ unavailableSources }}. Showing the rest.</span>
        </div>
      {% endif %}
      <div class="card card-border overflow-clip bg-base-100" data-testid="application-events">
        {% if events.rows | length %}
          <div class="w-full overflow-x-auto">
            <table class="table w-full min-w-[64rem] table-fixed" data-testid="application-events-table">
              {{ eventsHead({}) }}
              <tbody>
                {% for row in events.rows %}{{ eventRow(row) }}{% endfor %}
              </tbody>
            </table>
          </div>
          {% if events.allHref %}
            <p class="border-t border-base-300 px-4 py-3 text-sm" data-testid="application-events-more"><a class="link" href="{{ events.allHref }}" data-testid="application-events-all">All in Events</a></p>
          {% endif %}
        {% else %}
          <p class="px-4 py-10 text-center text-sm text-base-content/60" data-testid="application-events-empty">No events found.</p>
        {% endif %}
      </div>
    {% elif tab == "raw" and raw %}
      {% if raw.tooLarge %}
        <div role="alert" class="alert alert-warning alert-soft text-sm" data-testid="application-raw-too-large">
          {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
          <span>Too large to show</span>
        </div>
      {% elif raw.view %}
        <section class="card card-border bg-base-100" aria-label="Raw" data-testid="application-raw-card">
          <div class="card-body p-5">
            {{ jsonViewer({ view: raw.view, label: "Stored document", testId: "application-raw" }) }}
          </div>
        </section>
      {% endif %}
    {% endif %}
  {% endif %}
{% endblock %}
