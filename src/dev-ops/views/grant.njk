{% extends "record.njk" %}

{% from "filter-menu/macro.njk" import filterMenu %}
{% from "icon/macro.njk" import icon %}
{% from "status-badge/macro.njk" import statusBadge %}

{% block recordHeader %}
  {% if versionHeader %}
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm" data-testid="{{ record.itemId }}-version">
      {{ statusBadge(versionHeader.status) }}
      {{ filterMenu(versionHeader.switcher) }}
    </div>
  {% endif %}
{% endblock %}

{% block beforeTabs %}
  {% if versionHeader.banner %}
    <div role="status" class="alert alert-soft mb-4 flex flex-wrap items-center gap-3 text-sm" data-testid="{{ record.itemId }}-banner">
      {{ icon({ name: 'info', class: 'size-4 shrink-0' }) }}
      <span class="min-w-0 flex-1">{{ versionHeader.banner.text }}</span>
    </div>
  {% endif %}
{% endblock %}

{% block tabBody %}
  {% if sectionError %}
    {{ super() }}
  {% elif notStored %}
    <div class="card card-border bg-base-100" data-testid="{{ record.itemId }}-not-stored">
      <p class="px-4 py-10 text-center text-sm text-base-content/60">{{ notStored | capitalize }} definition not stored.</p>
    </div>
  {% elif tab == "actions" and actions %}
    <section class="card card-border mt-4 bg-base-100 first:mt-0" aria-label="Actions" data-testid="grant-actions">
      {% if actions | length %}
        <div class="card-body gap-3 p-5">
          <div class="w-full overflow-x-auto">
            <table class="table w-full table-fixed" data-testid="grant-actions-table">
              <colgroup><col class="w-[24%]"><col class="w-[12%]"><col class="w-[64%]"></colgroup>
              <thead>
                <tr><th scope="col">Name</th><th scope="col">Method</th><th scope="col">URL</th></tr>
              </thead>
              <tbody>
                {% for action in actions %}
                  <tr class="hover:bg-base-200" data-testid="grant-action">
                    <td><span class="font-mono text-sm leading-none break-words">{{ action.name }}</span></td>
                    <td><span class="font-mono text-sm leading-none break-words">{{ action.method }}</span></td>
                    <td><span class="font-mono text-sm leading-none break-words">{{ action.url }}</span></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      {% else %}
        <p class="px-4 py-10 text-center text-sm text-base-content/60" data-testid="grant-actions-empty">No actions.</p>
      {% endif %}
    </section>
  {% else %}
    {{ super() }}
  {% endif %}
{% endblock %}
