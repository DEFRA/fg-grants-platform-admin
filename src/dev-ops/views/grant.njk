{% extends "record.njk" %}

{% from "filter-menu/macro.njk" import filterMenu %}
{% from "agreement-definition/macro.njk" import agreementDefinition %}
{% from "grant-entitlements/macro.njk" import grantEntitlements %}
{% from "icon/macro.njk" import icon %}
{% from "schema-tree/macro.njk" import schemaTree %}
{% from "state-graph/macro.njk" import stateGraph, statusPanelSection, stageFacts %}
{% from "payment-definition/macro.njk" import paymentDefinition %}
{% from "raw-details/macro.njk" import rawDetails %}
{% from "status-badge/macro.njk" import statusBadge %}

{% macro errorAlert(text, testId) %}
  <div role="alert" class="alert alert-error alert-soft text-sm" data-testid="{{ testId }}">
    {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
    <span>{{ text }}</span>
  </div>
{% endmacro %}

{# Tailwind only sees class names written literally in this file. #}
{% set mono = "font-mono text-sm leading-none break-words" %}
{% set quiet = "text-base-content/60" %}

{% macro noLines() %}<span class="font-mono text-sm leading-none text-base-content/70">—</span>{% endmacro %}

{% macro runs(processes) %}
  {%- if processes | length %} <span class="{{ quiet }}">runs</span> {% for process in processes %}<span class="{{ mono }}">{{ process }}</span>{% if not loop.last %}<span class="text-base-content/40">, </span>{% endif %}{% endfor %}{% endif -%}
{% endmacro %}

{% block recordHeader %}
  {% if versionHeader %}
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm" data-testid="{{ record.itemId }}-version">
      {{ statusBadge(versionHeader.status) }}
      {{ filterMenu(versionHeader.switcher) }}
    </div>
  {% endif %}
{% endblock %}

{% block beforeTabs %}
  {% set noticeAlerts = {
    success: "alert-success alert-soft",
    warning: "alert-soft alert-warning",
    error: "alert-soft alert-error"
  } %}
  {% set noticeIcons = {
    success: "check",
    warning: "exclamation-triangle",
    error: "exclamation-circle"
  } %}
  {% for notice in notices %}
    <div role="{{ 'status' if notice.role == 'success' else 'alert' }}" class="alert {{ noticeAlerts[notice.role] }} mb-3 text-sm" data-testid="{{ record.itemId }}-notice">
      {{ icon({ name: noticeIcons[notice.role], class: 'size-4 shrink-0' }) }}
      <span>{{ notice.text }}{% if notice.reason %}<span class="font-mono">{{ notice.reason }}</span>{% endif %}{{ notice.tail }}</span>
    </div>
  {% endfor %}
  {% if versionHeader.banner %}
    {% set banner = versionHeader.banner %}
    <div role="status" class="alert alert-soft mb-4 flex flex-wrap items-center gap-3 text-sm" data-testid="{{ record.itemId }}-banner">
      {{ icon({ name: 'info', class: 'size-4 shrink-0' }) }}
      <span class="min-w-0 flex-1">{{ banner.text }}</span>
      <form method="post" action="{{ banner.action }}" class="shrink-0">
        <input type="hidden" name="back" value="{{ banner.back }}">
        <input type="hidden" name="tab" value="{{ banner.tab }}">
        <button class="btn btn-sm" type="submit" data-testid="{{ record.itemId }}-fetch">Fetch definitions</button>
      </form>
    </div>
  {% endif %}
{% endblock %}

{% block tabBody %}
  {% if sectionError %}
    {{ super() }}
  {% elif notStored %}
    <div class="card card-border bg-base-100" data-testid="{{ record.itemId }}-not-stored">
      <p class="px-4 py-10 text-center text-sm text-base-content/60">{{ notStored | capitalize }} definition not stored.</p>
    </div>
  {% elif tab == "phases" and phases.kind == "unreadable" %}
    <div role="alert" class="alert alert-error alert-soft text-sm" data-testid="grant-phases-unreadable">
      {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
      <span>The grant definition's phases cannot be read: {{ phases.problem }}.</span>
    </div>
  {% elif tab == "phases" and phases %}
    {% call stateGraph({ graphs: phases.graphs, legend: phases.legend, testId: 'grant-phases' }) %}
      {% set panel = phases.panel %}
      {% if panel %}
        {% if panel.badges | length %}
          <div class="flex flex-wrap items-center gap-2">
            {% for badge in panel.badges %}<span class="badge badge-sm badge-outline" data-testid="grant-phases-badge">{{ badge }}</span>{% endfor %}
          </div>
        {% endif %}
        {{ stageFacts({ phase: panel.phase, stage: panel.stage }) }}
        {% call statusPanelSection({ title: 'Reached from', testId: 'grant-phases-reached-from' }) %}
          {% for way in panel.reachedFrom %}
            <div class="mb-1.5">
              {%- if way.kind == "link" -%}
                <a class="link break-words font-mono text-sm" href="{{ way.href }}">{{ way.text }}</a>
              {%- elif way.kind == "code" -%}
                <span class="{{ mono }}">{{ way.text }}</span>
              {%- else -%}
                <span>Any status</span>
              {%- endif -%}
              {{ runs(way.processes) }}
            </div>
          {% else %}
            {{ noLines() }}
          {% endfor %}
        {% endcall %}
        {% call statusPanelSection({ title: 'Moves to', testId: 'grant-phases-moves-to' }) %}
          {% for move in panel.movesTo %}
            <div class="mb-1.5">→ <a class="link break-words font-mono text-sm" href="{{ move.href }}">{{ move.text }}</a>{{ runs(move.processes) }}</div>
          {% else %}
            {{ noLines() }}
          {% endfor %}
        {% endcall %}
        {% call statusPanelSection({ title: 'Set by', testId: 'grant-phases-set-by' }) %}
          {% for setter in panel.setBy %}
            <div class="mb-1.5">
              {%- if setter.kind == "last-claim" -%}
                <a class="link text-sm" href="{{ setter.href }}">Last claim</a> <span class="{{ quiet }}">while at</span> <span class="{{ mono }}">{{ setter.from }}</span>
              {%- else -%}
                {% if setter.href %}<a class="link font-mono text-sm" href="{{ setter.href }}">{{ setter.label }}</a>{% else %}<span class="font-mono text-sm">{{ setter.label }}</span>{% endif %} <span class="{{ quiet }}">while in</span> <span class="{{ mono }}">{{ setter.whileIn }}</span>
              {%- endif -%}
            </div>
          {% else %}
            {{ noLines() }}
          {% endfor %}
        {% endcall %}
      {% endif %}
    {% endcall %}
  {% elif tab == "questions" and questions.kind == "no-phases" %}
    {{ errorAlert("The grant definition has no phases: every submission throws.", "grant-questions-no-phases") }}
  {% elif tab == "questions" and questions %}
    {% for card in questions.cards %}
      <section class="card card-border mt-4 bg-base-100 first:mt-0" aria-labelledby="grant-questions-{{ loop.index }}" data-testid="grant-questions-phase">
        <div class="card-body gap-3 p-5">
          <h2 class="card-title text-base" id="grant-questions-{{ loop.index }}">{% if card.title.code %}<span class="font-mono">{{ card.title.code }}</span>{% else %}Phase {{ card.title.index }}{% endif %}{% if not card.usedByGas %} <span class="text-sm font-normal">{{ statusBadge({ label: 'Not used by GAS', role: 'neutral' }) }}</span>{% endif %}</h2>
          {% if card.noCode %}
            {{ errorAlert("This phase has no code.", "grant-questions-no-code") }}
          {% endif %}
          {% if card.kind == "not-an-object" %}
            {{ errorAlert("This phase is not an object.", "grant-questions-not-an-object") }}
          {% elif card.kind == "missing" %}
            {{ errorAlert("No questions: every submission throws.", "grant-questions-missing") }}
          {% elif card.kind == "not-a-schema" %}
            {{ errorAlert("Questions are not a JSON Schema object.", "grant-questions-not-a-schema") }}
          {% elif card.kind == "rejects-all" %}
            {{ errorAlert("Every answer is rejected.", "grant-questions-rejects-all") }}
          {% elif card.kind == "accepts-any" %}
            <p class="text-sm text-base-content/60" data-testid="grant-questions-any">Any answers accepted.</p>
          {% elif card.rows | length %}
            {{ schemaTree({ rows: card.rows, testId: "grant-questions-tree" }) }}
          {% else %}
            <p class="text-sm text-base-content/60" data-testid="grant-questions-empty">No properties.</p>
          {% endif %}
          {% if card.rules | length %}
            <h3 class="mt-2 text-sm font-semibold">Rules</h3>
            <div class="w-full overflow-x-auto">
              <table class="table w-full table-fixed" data-testid="grant-questions-rules">
                <colgroup><col class="w-[42%] sm:w-[26%]"><col class="w-[58%] sm:w-[74%]"></colgroup>
                <thead>
                  <tr><th scope="col">Applies to</th><th scope="col">Rule</th></tr>
                </thead>
                <tbody>
                  {% for rule in card.rules %}
                    <tr class="hover:bg-base-200"><td><span class="font-mono text-sm leading-none break-words">{{ rule.appliesTo }}</span></td><td class="text-sm">{{ rule.text }}</td></tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% endif %}
        </div>
      </section>
    {% endfor %}
  {% elif tab == "actions" and actions %}
    <section class="card card-border mt-4 bg-base-100 first:mt-0" aria-label="Actions" data-testid="grant-actions">
      {% if actions | length %}
        <div class="card-body gap-3 p-5">
          <div class="w-full overflow-x-auto">
            <table class="table w-full table-fixed" data-testid="grant-actions-table">
              <colgroup><col class="w-[24%]"><col class="w-[12%]"><col class="w-[64%]"></colgroup>
              <thead>
                <tr><th scope="col">Name</th><th scope="col">Method</th><th scope="col">URL</th></tr>
              </thead>
              <tbody>
                {% for action in actions %}
                  <tr class="hover:bg-base-200" data-testid="grant-action">
                    <td><span class="font-mono text-sm leading-none break-words">{{ action.name }}</span></td>
                    <td><span class="font-mono text-sm leading-none break-words">{{ action.method }}</span></td>
                    <td><span class="font-mono text-sm leading-none break-words">{{ action.url }}</span></td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      {% else %}
        <p class="px-4 py-10 text-center text-sm text-base-content/60" data-testid="grant-actions-empty">No actions.</p>
      {% endif %}
    </section>
  {% elif tab == "entitlements" and entitlements %}
    {{ grantEntitlements({ view: entitlements, testId: "grant-entitlements" }) }}
  {% elif tab == "agreement" and agreement %}
    {{ agreementDefinition({ tab: agreement, testId: "grant-agreement" }) }}
    {{ rawDetails({ view: agreement.raw, label: "Agreement definition", testId: "grant-agreement-raw" }) }}
  {% elif tab == "payment" and payment.view %}
    {{ paymentDefinition({ view: payment.view, testId: "grant-payment" }) }}
    {{ rawDetails({ view: payment.raw.view, label: "Payment definition", testId: "grant-payment-raw" }) }}
  {% else %}
    {{ super() }}
  {% endif %}
{% endblock %}
