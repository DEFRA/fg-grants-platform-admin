{% extends 'layouts/list-page.njk' %}

{% from "no-value/macro.njk" import noValue %}
{% from "muted/macro.njk" import muted %}
{% from "bucket-row/macro.njk" import bucketRow %}
{% from "table-head/macro.njk" import tableHead %}
{% from "filter-menu/macro.njk" import filterMenu %}
{% from "filter-switch/macro.njk" import filterSwitch %}
{% from "icon/macro.njk" import icon %}
{% from "load-more/macro.njk" import loadMore %}
{% from "sticky-top/macro.njk" import stickyTop %}
{% from "time-range-menu/macro.njk" import timeRangeMenu %}

{# Tailwind only sees class names written literally in this file. #}

{% set tile = "stat px-4 py-2 hover:bg-base-200 focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-base-content" %}
{% set tileActive = "stat px-4 py-2 shadow-[inset_0_-3px_0_var(--color-base-content)] focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-base-content" %}
{% set tileTitle = "stat-title" %}
{% set tileTitleActive = "stat-title font-semibold text-base-content" %}
{% set tileValue = "stat-value min-w-[7ch] text-xl tabular-nums" %}
{% set tileValueQuiet = "stat-value min-w-[7ch] text-xl tabular-nums " ~ muted %}
{# Accepted contrast shortfall: 2.86:1 in light. #}
{% set tileValueAlarm = "stat-value min-w-[7ch] text-xl tabular-nums text-error" %}

{% macro hidden(fields) %}
  {% for field in fields %}
    <input type="hidden" name="{{ field.name }}" value="{{ field.value }}" data-testid="bucket-search-filter">
  {% endfor %}
{% endmacro %}

{# A search lives in the session, so clearing it is a post, as setting it was. #}
{% macro clearSearch(bucket, search) %}
  <form class="inline" method="post" action="{{ bucket.path }}">
    {{ hidden(search.hiddenFields) }}
    <input type="hidden" name="ref-value" value="">
    <button class="link {{ muted }}" type="submit" data-testid="bucket-note-search-clear">Clear ×</button>
  </form>
{% endmacro %}

{# Where a bounded read stopped, and the way on from there, or that it reached the end: then it alone says so, not "No more" as well. A later page brings its own. #}
{% macro tail(keepLooking, searchedEverything, said) %}
  <p class="border-t border-base-300 px-4 py-3 text-center text-sm {{ muted }}" id="bucket-tail"{% if said or (not keepLooking and not searchedEverything) %} hidden{% endif %}{% if keepLooking %} data-open{% elif searchedEverything %} data-closed{% endif %} data-testid="bucket-tail">
    {%- if keepLooking -%}
      <span data-testid="bucket-searched-to">Searched back to <span class="font-mono tabular-nums">{{ keepLooking.searchedTo }}</span>.</span> <a class="link" href="{{ keepLooking.href }}" data-testid="bucket-keep-looking">Keep looking</a>
    {%- elif searchedEverything -%}
      <span data-testid="bucket-searched-to">Searched everything.</span>
    {%- endif -%}
  </p>
{% endmacro %}

{% block content %}
  {% if not bucket %}
    <h1 class="sr-only" data-testid="bucket-title">{{ pageTitle }}</h1>
    <div class="card card-border min-h-0 flex-1 bg-base-100" data-testid="bucket-card">
      <div class="p-4">
        <div role="alert" class="alert alert-error alert-soft text-sm" data-testid="bucket-error">
          {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
          <span>{{ pageTitle }} could not be loaded.</span>
        </div>
      </div>
    </div>
  {% else %}
    {% call stickyTop() %}
      {# The navigation already names the page; the h1 stays for screen readers. #}
      <h1 class="sr-only" data-testid="bucket-title">{{ title }}</h1>

      {# The lists that share this page, each a plain link to its own list. #}
      {% if tabs | length %}
        <nav class="mb-3" aria-label="{{ title }}" data-testid="bucket-tabs">
          <div class="tabs tabs-border">
            {% for item in tabs %}
              <a class="tab{% if item.active %} tab-active{% endif %}" href="{{ item.href }}"{% if item.active %} aria-current="page"{% endif %} data-bucket="{{ item.id }}" data-testid="bucket-tab">{{ item.label }}</a>
            {% endfor %}
          </div>
        </nav>
      {% endif %}

      {% if tiles %}
        <div class="stats stats-horizontal mb-3 w-fit max-w-full border border-base-300 bg-base-100" role="group" aria-label="Filter by {{ tiles.name | lower }}" data-testid="bucket-tiles">
          {% for chip in tiles.items %}
            {%- set tileName = chip.label if chip.value else "All " ~ bucket.noun.many -%}
            <a class="{{ tileActive if chip.active else tile }}" href="{{ chip.href }}" aria-label="{{ tileName }}{% if chip.countLabel %}: {{ chip.countLabel }} {{ bucket.noun.one if chip.countLabel == "1" else bucket.noun.many }}{% endif %}"{% if chip.active %} aria-current="page"{% endif %}{% if chip.value %} data-value="{{ chip.value }}"{% endif %} data-testid="bucket-tile">
              <div class="{{ tileTitleActive if chip.active else tileTitle }}" data-testid="bucket-tile-label">{{ chip.label }}</div>
              {% if chip.alarming %}
                <div class="{{ tileValueAlarm }}" data-testid="bucket-tile-count">{{ chip.countLabel }}</div>
              {% elif chip.countLabel and not chip.zero %}
                <div class="{{ tileValue }}" data-testid="bucket-tile-count">{{ chip.countLabel }}</div>
              {% else %}
                <div class="{{ tileValueQuiet }}" data-testid="bucket-tile-count">{% if chip.countLabel %}{{ chip.countLabel }}{% else %}{{ noValue({ testId: "bucket-tile-count" }) }}{% endif %}</div>
              {% endif %}
            </a>
          {% endfor %}
        </div>
      {% endif %}

      {# Top-aligned, so the error a bad search puts under its box moves nothing beside it. #}
      <div class="mb-3 flex flex-wrap items-start gap-2" data-testid="bucket-toolbar">
        {{- timeRangeMenu({ id: "bucket", range: timeRange, name: head.time }) }}

        {% for menu in menus %}
          {{- filterMenu({
            testId: "bucket-filter-" ~ menu.fact,
            panelId: "bucket-filter-" ~ menu.fact ~ "-panel",
            name: menu.name,
            label: menu.label,
            items: menu.items
          }) }}
        {% endfor %}

        {% for toggle in toggles %}
          {{- filterSwitch({
            testId: "bucket-toggle-" ~ toggle.fact,
            label: toggle.label,
            checked: toggle.checked,
            href: toggle.href
          }) }}
        {% endfor %}

        {% if search %}
          <form class="w-full sm:ml-auto sm:w-auto" method="post" action="{{ bucket.path }}" role="search" data-testid="bucket-search">
            {{ hidden(search.hiddenFields) }}
            <div class="join flex">
              {% if search.kinds | length > 1 %}
                {{- filterMenu({
                  testId: "bucket-search-kind",
                  panelId: "bucket-search-kind-panel",
                  field: "ref-kind",
                  label: "Search " ~ bucket.noun.many ~ " by",
                  items: search.kinds
                }) }}
              {% else %}
                <input type="hidden" name="ref-kind" value="{{ search.kinds[0].value }}" data-testid="bucket-search-kind-value">
              {% endif %}
              <label class="input join-item min-w-0 flex-1 sm:w-72 sm:flex-none{% if search.error %} input-error{% endif %}" data-testid="bucket-search-label">
                {{ icon({ name: 'search', class: 'size-4.5 shrink-0 opacity-50' }) }}
                <input type="search" name="ref-value" value="{{ search.value }}" placeholder="{{ search.placeholder }}" aria-label="{{ search.inputLabel }} to search {{ bucket.noun.many }} for" autocomplete="off" spellcheck="false"{% if search.error %} aria-invalid="true" aria-describedby="bucket-search-error"{% endif %} data-testid="bucket-search-input">
              </label>
              <button class="btn join-item" type="submit" data-testid="bucket-search-submit">Search</button>
            </div>
            {% if search.error %}<p class="mt-1 text-sm text-error" id="bucket-search-error" data-testid="bucket-search-error">{{ search.error }}</p>{% endif %}
          </form>
        {% endif %}
      </div>
    {% endcall %}

    {% if (search and search.note) or notes | length %}
      <div class="-mt-1 mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm" data-testid="bucket-filter-notes">
        {% if search and search.note %}
          <span class="{{ muted }}" data-testid="bucket-note-search">Matching {{ search.note.label }} <span class="font-mono text-base-content/80">"{{ search.note.value }}"</span></span>
          {{ clearSearch(bucket, search) }}
        {% endif %}
        {% for note in notes %}
          {% if not loop.first or (search and search.note) %}<span class="text-base-content/30" aria-hidden="true">·</span>{% endif %}
          <span class="{{ muted }}" data-testid="bucket-note-{{ note.fact }}">{{ note.label }}: <span class="font-mono text-base-content/80">"{{ note.value }}"</span></span>
          <a class="link {{ muted }}" href="{{ note.clearHref }}" data-testid="bucket-note-{{ note.fact }}-clear">Clear ×</a>
        {% endfor %}
      </div>
    {% endif %}

    {# `overflow-clip` makes no scroll container, so the header row can still stick. #}
    <div class="card card-border {{ 'flex flex-col overflow-clip' if rows | length else 'min-h-0 flex-1' }} bg-base-100" data-testid="bucket-card">
      {# What a list's summaries found, closed until asked for; a list with nothing to say draws none. #}
      {% for section in summaries %}
        <div class="shrink-0 border-b border-base-300" data-summary="{{ section.id }}" data-testid="bucket-summary">
          {% if section.unavailable %}
            <p class="flex min-h-10 items-center gap-2 px-4 text-sm {{ muted }}" role="status" data-testid="bucket-summary-error">{{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}{{ section.title }} could not be loaded.</p>
          {% elif not section.entries | length %}
            <p class="flex min-h-10 items-center px-4 text-sm {{ muted }}" data-testid="bucket-summary-empty">{{ section.title }}: {{ section.emptyText }}</p>
          {% else %}
            {# The panel is the only scrollport here, so its header pins inside it and `--sticky-top` is untouched. #}
            {# Open, the panel keeps room for its own scrollbar, so a long section's columns do not shift when one appears. #}
            <details class="group collapse max-h-96 overflow-x-auto overflow-y-auto rounded-none open:[scrollbar-gutter:stable]" data-testid="bucket-summary-details">
              <summary class="collapse-title sticky top-0 z-2 flex min-h-10 w-full cursor-pointer items-center bg-base-100 px-4 py-0 text-sm {{ muted }} focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-base-content" data-testid="bucket-summary-title"><span class="flex w-fit items-center gap-1.5">{{ section.title }}{{ icon({ name: 'chevron-down', class: 'size-4 opacity-60 transition-transform group-open:rotate-180' }) }}</span></summary>
              <div class="collapse-content px-0 pb-2" data-testid="bucket-summary-list">
                <table class="table table-pin-rows [&_thead]:top-10" data-testid="bucket-summary-table">
                  <thead>
                    <tr>
                      <th scope="col" class="w-24 text-right">Count</th>
                      {% for label in section.valueLabels %}<th scope="col">{{ label }}</th>{% endfor %}
                      <th scope="col" class="text-right">{{ section.firstLabel }}</th>
                      <th scope="col" class="text-right">{{ section.lastLabel }}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for entry in section.entries %}
                      <tr class="hover:bg-base-200" data-testid="bucket-summary-entry">
                        <td class="w-24 text-right font-mono font-medium tabular-nums" data-testid="bucket-summary-count">{{ entry.countLabel }}</td>
                        {% for cell in entry.cells %}
                          {# The first value is what was counted, and the way to the rows; the others say where they sit. #}
                          {% if loop.first %}
                            <td class="max-w-96 truncate">
                              {%- if entry.href -%}
                                <a class="link link-hover font-mono text-error" href="{{ entry.href }}" title="{{ cell.text }}" data-testid="bucket-summary-link">{{ cell.text }}</a>
                              {%- else -%}
                                {# The list's own word for the rows with no value, muted, so it never reads as a value. #}
                                <span class="font-mono {{ muted if cell.missing else 'text-error' }}" title="{{ cell.text }}" data-testid="bucket-summary-none">{{ cell.text }}</span>
                              {%- endif -%}
                            </td>
                          {% else %}
                            <td class="max-w-64 truncate {{ muted }}" title="{{ cell.text }}" data-testid="bucket-summary-value">{% if cell.missing %}{{ noValue({ testId: "bucket-summary-value" }) }}{% else %}{{ cell.text }}{% endif %}</td>
                          {% endif %}
                        {% endfor %}
                        {% for at in [entry.first, entry.last] %}
                          <td class="text-right font-mono tabular-nums whitespace-nowrap {{ muted }}">
                            {%- if at.instant -%}
                              <time class="block" datetime="{{ at.instant }}" title="{{ at.precise }}" data-testid="bucket-summary-{{ 'first' if loop.first else 'last' }}">{{ at.text }}</time>
                            {%- else -%}
                              <span class="block" data-testid="bucket-summary-{{ 'first' if loop.first else 'last' }}">{{ at.text }}</span>
                            {%- endif -%}
                          </td>
                        {% endfor %}
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
                {% for note in section.notes %}
                  <p class="px-4 pt-2 text-sm {{ muted }}" data-testid="bucket-summary-note">{{ note }}</p>
                {% endfor %}
              </div>
            </details>
          {% endif %}
        </div>
      {% endfor %}

      {% if rows | length %}
        {# Sticky and sideways scrolling cannot share a box: overflow here unpins the header. #}
        <div class="w-full overflow-x-auto [@media(min-width:64rem)_and_(min-height:40rem)]:overflow-visible" data-testid="bucket-scroller">
          <table class="table table-pin-rows w-full {{ 'max-sm:table-xs max-sm:[&_*]:text-xs max-sm:[&_:is(td,th)]:px-1 sm:min-w-[64rem]' if head.layout else 'min-w-[64rem]' }} table-fixed [@media(min-width:64rem)_and_(min-height:40rem)]:min-w-0 [@media(min-width:64rem)_and_(min-height:40rem)]:[&_thead]:top-[var(--sticky-top,11.5rem)]" data-testid="bucket-table">
            {{ tableHead({ testId: "bucket-head", title: head.title, columns: head.columns, time: head.time, even: head.even, layout: head.layout }) }}
            <tbody id="bucket-rows">
              {% for row in rows %}{{ bucketRow(row) }}{% endfor %}
            </tbody>
          </table>
        </div>

        {{ loadMore({
          id: "bucket",
          nextHref: nextHref,
          rowLink: '[data-testid="bucket-row-link"]',
          outage: '[data-testid="bucket-error"], [data-testid="bucket-refused"]',
          tail: "bucket-tail",
          open: keepLooking,
          closed: searchedEverything,
          nounMany: bucket.noun.many,
          nounOne: bucket.noun.one
        }) }}
        {{ tail(keepLooking, searchedEverything) }}
      {% elif refused %}
        <div class="p-4">
          <div role="alert" class="alert alert-warning alert-soft text-sm" data-testid="bucket-refused">
            {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
            <span>{% if refused.by %}{{ refused.by }} refused this request{% if refused.message %}: {{ refused.message }}{% endif %}{% else %}{{ refused.message }}{% endif %}. <a class="link" href="{{ refused.startHref }}" data-testid="bucket-refused-clear">Start again</a></span>
          </div>
        </div>
      {% elif unavailable %}
        <div class="p-4">
          <div role="alert" class="alert alert-error alert-soft text-sm" data-testid="bucket-error">
            {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
            <span>{{ bucket.label }} could not be loaded.</span>
          </div>
        </div>
      {% else %}
        <p class="px-4 py-10 text-center text-sm {{ muted }}" data-testid="bucket-empty">{{ emptyText }}</p>
        {# An empty page that searched everything says so in its empty line; its tail stays for a list that loads it as a later page. #}
        {{ tail(keepLooking, searchedEverything, searchedEverything and not keepLooking) }}
      {% endif %}
    </div>
  {% endif %}
{% endblock %}
