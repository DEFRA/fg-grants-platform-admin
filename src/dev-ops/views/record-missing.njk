{% extends 'layouts/page.njk' %}
{% import "design-system/macros.njk" as au %}

{% block oldPage %}{% endblock %}

{#- A record's page with nothing of the record to show: not found, unavailable or timed out. -#}
{% block content %}
  {%- call au.Page() -%}
    {{ au.PageHeader({ title: missing.title, mono: true, back: { href: backHref, text: backLabel, testId: 'record-missing-back' }, titleTestId: 'record-missing-title' }) }}

    {%- if missing.state == 'not-found' -%}
      {%- set actions -%}
        {{ au.Button({ text: backLabel, href: backHref }) }}
        {%- if missing.inboxSearch %}{{ au.Button({ text: missing.inboxSearch.text, type: 'submit', form: 'record-missing-search', variant: 'primary', testId: 'record-missing-search' }) }}{% endif -%}
      {%- endset -%}
      {%- call au.Card({ testId: 'record-missing-not-found' }) -%}
        {{ au.EmptyState({ icon: 'search-x', title: missing.message.title, text: missing.message.text, actions: actions }) }}
      {%- endcall -%}
      {%- if missing.inboxSearch -%}
        {#- The search's button is in the empty state above, so its form shows nothing of its own. -#}
        {{ au.Form({ id: 'record-missing-search', action: missing.inboxSearch.action, method: 'post', label: missing.inboxSearch.text, attributes: { hidden: true }, hidden: [{ name: 'ref-kind', value: 'ref' }, { name: 'ref-value', value: missing.inboxSearch.code }] }) }}
      {%- endif -%}
    {%- else -%}
      {%- set actions -%}
        {{ au.Button({ text: 'Try again', size: 'sm', iconStart: 'refresh-cw', href: retryHref, testId: 'record-missing-retry' }) }}
        {{ au.Button({ text: backLabel, size: 'sm', variant: 'tertiary', href: backHref }) }}
      {%- endset -%}
      {{ au.Alert({ tone: 'danger', title: missing.message.title, text: missing.message.text, actions: actions, testId: 'record-missing-' ~ missing.state }) }}
    {%- endif -%}
  {%- endcall -%}
{% endblock %}
