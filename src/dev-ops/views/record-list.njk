{% extends 'layouts/list-page.njk' %}
{% set navActive = list.listId %}

{% from "filter-menu/macro.njk" import filterMenu %}
{% from "icon/macro.njk" import icon %}
{% from "load-more/macro.njk" import loadMore %}
{% from "record-row/macro.njk" import recordItem, recordRow %}
{% from "sticky-top/macro.njk" import stickyTop %}
{% from "time-range-menu/macro.njk" import timeRangeMenu %}

{% macro searchFilters(list, fields) %}
  {% for field in fields %}
    <input type="hidden" name="{{ field.name }}" value="{{ field.value }}" data-testid="{{ list.listId }}-search-filter">
  {% endfor %}
{% endmacro %}

{# A search lives in the session, so clearing it is a post, as setting it was. #}
{% macro clearSearch(list, fields, label, testId) %}
  <form class="inline" method="post" action="{{ list.path }}">
    {{ searchFilters(list, fields) }}
    <input type="hidden" name="q" value="">
    <button class="link text-base-content/70" type="submit" data-testid="{{ testId }}">{{ label }}</button>
  </form>
{% endmacro %}

{% block content %}
  {% set codeKey = list.codeName | lower %}
  {% call stickyTop() %}
    <h1 class="sr-only" data-testid="{{ list.listId }}-title">{{ pageTitle }}</h1>

    {# Top-aligned, so the error a bad search puts under its box moves nothing beside it. #}
    <div class="mb-3 flex flex-wrap items-start gap-2" data-testid="{{ list.listId }}-toolbar">
      {{- timeRangeMenu({ id: list.listId, range: timeRange }) }}

      {{- filterMenu({
        testId: list.listId ~ "-filter-" ~ codeKey,
        panelId: list.listId ~ "-" ~ codeKey ~ "-panel",
        name: list.codeName,
        label: "Filter by " ~ codeKey,
        items: codeFilters
      }) }}

      <form class="w-full sm:ml-auto sm:w-auto" method="post" action="{{ list.path }}" role="search" data-testid="{{ list.listId }}-search">
        {{ searchFilters(list, searchFields) }}
        <div class="join flex">
          <label class="input join-item min-w-0 flex-1 sm:w-80 sm:flex-none{% if searchError %} input-error{% endif %}" data-testid="{{ list.listId }}-search-label">
            {{ icon({ name: 'search', class: 'size-4.5 shrink-0 opacity-50' }) }}
            <input type="search" name="q" value="{{ searchValue if searchError else q }}" placeholder="Reference" aria-label="Search {{ list.noun.many }} by reference" autocomplete="off" spellcheck="false"{% if searchError %} aria-invalid="true" aria-describedby="{{ list.listId }}-search-error"{% endif %} data-testid="{{ list.listId }}-search-input">
          </label>
          <button class="btn join-item" type="submit" data-testid="{{ list.listId }}-search-submit">Search</button>
        </div>
        {% if searchError %}<p class="mt-1 text-sm text-error" id="{{ list.listId }}-search-error" data-testid="{{ list.listId }}-search-error">{{ searchError }}</p>{% endif %}
      </form>
    </div>
  {% endcall %}

  {% if q or codeNote %}
    <div class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm" data-testid="{{ list.listId }}-filter-notes">
      {% if q %}
        <span class="text-base-content/60" data-testid="{{ list.listId }}-note-search">Matching <span class="font-mono text-base-content/80">"{{ q }}"</span></span>
        {{ clearSearch(list, searchFields, "Clear ×", list.listId ~ "-note-search-clear") }}
      {% endif %}
      {% if codeNote %}
        {% if q %}<span class="text-base-content/30" aria-hidden="true">·</span>{% endif %}
        <span class="text-base-content/60" data-testid="{{ list.listId }}-note-{{ codeKey }}">{{ list.codeName }}: <span class="font-mono text-base-content/80">"{{ codeNote.code }}"</span></span>
        <a class="link text-base-content/70" href="{{ codeNote.clearHref }}" data-testid="{{ list.listId }}-note-{{ codeKey }}-clear">Clear ×</a>
      {% endif %}
    </div>
  {% endif %}

  {% if rows | length %}
    {# `overflow-clip` makes no scroll container, so the header row can still stick. #}
    <div class="card card-border flex flex-col overflow-clip bg-base-100" data-testid="{{ list.listId }}-card">
      {% if totalLabel %}
        <div class="shrink-0 border-b border-base-300" data-testid="{{ list.listId }}-card-header">
          <div class="flex min-h-10 items-center justify-end bg-base-100 px-4 py-0 text-sm text-base-content/70">
            <span class="tabular-nums" data-testid="{{ list.listId }}-total">{{ totalLabel }}</span>
          </div>
        </div>
      {% endif %}

      {# Sticky and sideways scrolling cannot share a box: overflow here unpins the header. #}
      <div class="hidden w-full overflow-x-auto sm:block [@media(min-width:64rem)_and_(min-height:40rem)]:overflow-visible" data-testid="{{ list.listId }}-scroller">
        <table class="table table-pin-rows w-full table-fixed [@media(min-width:64rem)_and_(min-height:40rem)]:[&_thead]:top-[var(--sticky-top,11.5rem)]" data-testid="{{ list.listId }}-table">
          <thead>
            <tr data-testid="{{ list.listId }}-head">
              <th scope="col">Reference</th>
              <th scope="col">{{ list.codeName }}</th>
              <th scope="col">Status</th>
              {% if list.showClosed %}
                <th scope="col" class="text-right">Closed</th>
              {% endif %}
              <th scope="col" class="text-right">Created</th>
            </tr>
          </thead>
          <tbody id="{{ list.listId }}-rows">
            {% for row in rows %}
              {{ recordRow({ row: row, prefix: list.itemId, codeKey: codeKey, showClosed: list.showClosed }) }}
            {% endfor %}
          </tbody>
        </table>
      </div>

      <ul class="list sm:hidden" id="{{ list.listId }}-list" data-testid="{{ list.listId }}-list">
        {% for row in rows %}
          {{ recordItem({ row: row, prefix: list.itemId, codeKey: codeKey }) }}
        {% endfor %}
      </ul>

      {{ loadMore({
        id: list.listId,
        nextHref: nextHref,
        rows: list.listId ~ "-rows " ~ list.listId ~ "-list",
        rowLink: '[data-testid="' ~ list.itemId ~ '-link"]',
        outage: '[data-testid="' ~ list.listId ~ '-error"], [data-testid="' ~ list.listId ~ '-refused"]',
        nounMany: list.noun.many,
        nounOne: list.noun.one
      }) }}
    </div>
  {% else %}
    <div class="card card-border min-h-0 flex-1 bg-base-100" data-testid="{{ list.listId }}-card">
      {% if refused %}
        <div class="p-4">
          <div role="alert" class="alert alert-warning alert-soft text-sm" data-testid="{{ list.listId }}-refused">
            {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
            <span>GAS refused this link's parameters. <a class="link" href="{{ list.path }}" data-testid="{{ list.listId }}-refused-clear">Start again</a>.</span>
          </div>
        </div>
      {% elif unavailable %}
        <div class="p-4">
          <div role="alert" class="alert alert-error alert-soft text-sm" data-testid="{{ list.listId }}-error">
            {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
            <span>{{ list.noun.many | capitalize }} could not be loaded from {{ list.source }}.</span>
          </div>
        </div>
      {% elif q %}
        <div class="px-4 py-10 text-center text-sm text-base-content/60" data-testid="{{ list.listId }}-empty">No {{ list.noun.many }} match "{{ q }}". {{ clearSearch(list, searchFields, "Clear search", list.listId ~ "-empty-clear") }}</div>
      {% else %}
        <p class="px-4 py-10 text-center text-sm text-base-content/60" data-testid="{{ list.listId }}-empty">No {{ list.noun.many }} found.</p>
      {% endif %}
    </div>
  {% endif %}
{% endblock %}
