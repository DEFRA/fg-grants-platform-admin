{% extends 'layouts/page.njk' %}
{% set navActive = 'applications' %}

{% from "event-row/macro.njk" import createdCell, rowClass %}
{% from "filter-menu/macro.njk" import filterMenu %}
{% from "icon/macro.njk" import icon %}
{% from "load-more/macro.njk" import loadMore %}
{% from "status-badge/macro.njk" import statusBadge %}
{% from "sticky-top/macro.njk" import stickyTop %}
{% from "time-range-menu/macro.njk" import timeRangeMenu %}

{# Tailwind only sees class names written literally in this file. #}
{% set rowLink = "block w-fit font-mono text-sm font-semibold no-underline after:absolute after:inset-0 focus-visible:outline-none" %}

{% macro searchFilters(fields) %}
  {% for field in fields %}
    <input type="hidden" name="{{ field.name }}" value="{{ field.value }}" data-testid="applications-search-filter">
  {% endfor %}
{% endmacro %}

{# A search lives in the session, so clearing it is a post, as setting it was. #}
{% macro clearSearch(fields, label, testId) %}
  <form class="inline" method="post" action="{{ path }}">
    {{ searchFilters(fields) }}
    <input type="hidden" name="q" value="">
    <button class="link text-base-content/70" type="submit" data-testid="{{ testId }}">{{ label }}</button>
  </form>
{% endmacro %}

{% macro status(row) %}
  {%- if row.statusLabel -%}
    {# Lifted over the row's stretched link, so its title is reachable by mouse; the whole position is spoken, the badge is not. #}
    <span class="relative inline-flex"><span aria-hidden="true">{{ statusBadge({ status: row.positionLabel, label: row.statusLabel, role: "neutral" }) }}</span><span class="sr-only">{{ row.positionLabel }}</span></span>
  {%- else -%}
    <span class="text-base-content/70">—</span>
  {%- endif -%}
{% endmacro %}

{% block htmlAttributes %} class="[@media(min-width:64rem)_and_(min-height:40rem)]:scroll-pt-[calc(var(--sticky-top,15rem)+3rem)]"{% endblock %}
{% block navbarClass %} top-0 [@media(min-width:64rem)_and_(min-height:40rem)]:sticky [@media(min-width:64rem)_and_(min-height:40rem)]:z-30{% endblock %}

{% block content %}
  {% call stickyTop() %}
    <h1 class="sr-only" data-testid="applications-title">{{ pageTitle }}</h1>

    {# Top-aligned, so the error a bad search puts under its box moves nothing beside it. #}
    <div class="mb-3 flex flex-wrap items-start gap-2" data-testid="applications-toolbar">
      {{- timeRangeMenu({ id: "applications", range: timeRange }) }}

      {{- filterMenu({
        testId: "applications-filter-grant",
        panelId: "applications-grant-panel",
        name: "Grant",
        label: "Filter by grant",
        items: grantFilters
      }) }}

      <form class="w-full sm:ml-auto sm:w-auto" method="post" action="{{ path }}" role="search" data-testid="applications-search">
        {{ searchFilters(searchFields) }}
        <div class="join flex">
          <label class="input join-item min-w-0 flex-1 sm:w-80 sm:flex-none{% if searchError %} input-error{% endif %}" data-testid="applications-search-label">
            {{ icon({ name: 'search', class: 'size-4.5 shrink-0 opacity-50' }) }}
            <input type="search" name="q" value="{{ searchValue if searchError else q }}" placeholder="Reference" aria-label="Search applications by reference" autocomplete="off" spellcheck="false"{% if searchError %} aria-invalid="true" aria-describedby="applications-search-error"{% endif %} data-testid="applications-search-input">
          </label>
          <button class="btn join-item" type="submit" data-testid="applications-search-submit">Search</button>
        </div>
        {% if searchError %}<p class="mt-1 text-sm text-error" id="applications-search-error" data-testid="applications-search-error">{{ searchError }}</p>{% endif %}
      </form>
    </div>
  {% endcall %}

  {% if q or grantNote %}
    <div class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm" data-testid="applications-filter-notes">
      {% if q %}
        <span class="text-base-content/60" data-testid="applications-note-search">Matching <span class="font-mono text-base-content/80">"{{ q }}"</span></span>
        {{ clearSearch(searchFields, "Clear ×", "applications-note-search-clear") }}
      {% endif %}
      {% if grantNote %}
        {% if q %}<span class="text-base-content/30" aria-hidden="true">·</span>{% endif %}
        <span class="text-base-content/60" data-testid="applications-note-grant">Grant: <span class="font-mono text-base-content/80">"{{ grantNote.code }}"</span></span>
        <a class="link text-base-content/70" href="{{ grantNote.clearHref }}" data-testid="applications-note-grant-clear">Clear ×</a>
      {% endif %}
    </div>
  {% endif %}

  {% if rows | length %}
    {# `overflow-clip` makes no scroll container, so the header row can still stick. #}
    <div class="card card-border flex flex-col overflow-clip bg-base-100" data-testid="applications-card">
      {% if totalLabel %}
        <div class="shrink-0 border-b border-base-300" data-testid="applications-card-header">
          <div class="flex min-h-10 items-center justify-end bg-base-100 px-4 py-0 text-sm text-base-content/70">
            <span class="tabular-nums" data-testid="applications-total">{{ totalLabel }}</span>
          </div>
        </div>
      {% endif %}

      {# Sticky and sideways scrolling cannot share a box: overflow here unpins the header. #}
      <div class="hidden w-full overflow-x-auto sm:block [@media(min-width:64rem)_and_(min-height:40rem)]:overflow-visible" data-testid="applications-scroller">
        <table class="table table-pin-rows w-full table-fixed [@media(min-width:64rem)_and_(min-height:40rem)]:[&_thead]:top-[var(--sticky-top,15rem)]" data-testid="applications-table">
          <thead>
            <tr data-testid="applications-head">
              <th scope="col" class="w-[30%]">Reference</th>
              <th scope="col" class="w-[25%]">Grant</th>
              <th scope="col" class="w-[30%]">Status</th>
              <th scope="col" class="w-[15%] text-right">Created</th>
            </tr>
          </thead>
          <tbody id="applications-rows">
            {% for row in rows %}
              <tr class="{{ rowClass }}" data-testid="application-row">
                <td>
                  <div class="flex flex-wrap items-center gap-2">
                    <a href="{{ row.href }}" class="{{ rowLink }}" data-testid="application-link">{{ row.clientRef }}<span class="sr-only">, {{ row.code }}</span></a>
                    {% if row.replaced %}<span class="badge badge-ghost badge-sm" data-testid="application-replaced">replaced</span>{% endif %}
                  </div>
                </td>
                <td><div class="truncate font-mono text-sm" data-testid="application-grant">{{ row.code }}</div></td>
                <td class="overflow-hidden" data-testid="application-status">{{ status(row) }}</td>
                {{ createdCell({ text: row.createdAt, instant: row.createdAtInstant, precise: row.createdAtPrecise, clock: row.createdAtClock, testId: "application-created" }) }}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <ul class="list sm:hidden" id="applications-list" data-testid="applications-list">
        {% for row in rows %}
          <li class="list-row relative hover:bg-base-200 has-[:focus-visible]:bg-base-200" data-testid="application-item">
            <div class="list-col-grow flex min-w-0 flex-col gap-1">
              <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                <a href="{{ row.href }}" class="{{ rowLink }}" data-testid="application-link">{{ row.clientRef }}<span class="sr-only">, {{ row.code }}</span></a>
                <span class="font-mono text-xs text-base-content/70">{{ row.code }}</span>
              </div>
              <div class="flex flex-wrap items-center justify-between gap-2">
                <span class="flex items-center gap-2">{{ status(row) }}{% if row.replaced %}<span class="badge badge-ghost badge-sm">replaced</span>{% endif %}</span>
                {% if row.createdAtInstant %}<time class="font-mono text-sm tabular-nums" datetime="{{ row.createdAtInstant }}" title="{{ row.createdAtPrecise }}" data-testid="application-item-created">{{ row.createdAt }}<span class="sr-only"> ({{ row.createdAtPrecise }})</span></time>{% else %}<span class="font-mono text-sm tabular-nums" data-testid="application-item-created">{{ row.createdAt }}</span>{% endif %}
              </div>
            </div>
          </li>
        {% endfor %}
      </ul>

      {{ loadMore({
        id: "applications",
        nextHref: nextHref,
        rows: "applications-rows applications-list",
        rowLink: '[data-testid="application-link"]',
        outage: '[data-testid="applications-error"], [data-testid="applications-refused"]',
        nounMany: "applications",
        nounOne: "application"
      }) }}
    </div>
  {% else %}
    <div class="card card-border min-h-0 flex-1 bg-base-100" data-testid="applications-card">
      {% if refused %}
        <div class="p-4">
          <div role="alert" class="alert alert-warning alert-soft text-sm" data-testid="applications-refused">
            {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
            <span>GAS refused this link's parameters. <a class="link" href="{{ path }}" data-testid="applications-refused-clear">Start again</a>.</span>
          </div>
        </div>
      {% elif unavailable %}
        <div class="p-4">
          <div role="alert" class="alert alert-error alert-soft text-sm" data-testid="applications-error">
            {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
            <span>Applications could not be loaded from GAS.</span>
          </div>
        </div>
      {% elif q %}
        <div class="px-4 py-10 text-center text-sm text-base-content/60" data-testid="applications-empty">No applications match "{{ q }}". {{ clearSearch(searchFields, "Clear search", "applications-empty-clear") }}</div>
      {% else %}
        <p class="px-4 py-10 text-center text-sm text-base-content/60" data-testid="applications-empty">No applications found.</p>
      {% endif %}
    </div>
  {% endif %}
{% endblock %}
