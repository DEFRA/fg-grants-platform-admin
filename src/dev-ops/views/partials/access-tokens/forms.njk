{% import "design-system/macros.njk" as au %}

{#- In production, every dialog that changes something says so first: the sidebar's badge is easy to stop seeing. -#}
{% macro prodNote(prod) -%}
  {%- if prod -%}
    {%- call au.Inline({ gap: 'sm', align: 'center', testId: 'token-prod-note' }) -%}
      {{ au.Badge({ text: 'prod', size: 'sm', tone: 'danger', variant: 'outline' }) }}{{ au.Text({ text: 'This changes production.', variant: 'label-md' }) }}
    {%- endcall -%}
  {%- endif -%}
{%- endmacro %}

{#- A write that didn't happen, at the top of the dialog it came from. -#}
{% macro refusal(r) -%}
  {%- if r %}{{ au.Alert({ tone: 'danger', title: r.title, text: r.text, testId: 'token-refusal' }) }}{% endif -%}
{%- endmacro %}

{#- The expiry choices of New token and Change expiry: each says where it lands, and Custom date shows its date box while picked. -#}
{% macro expiryChoices(group) -%}
  {%- set dateField -%}
    {%- call au.Field({ id: group.dateId, label: 'Expiry date', error: group.dateError }) -%}
      {{ au.DatePicker({ id: group.dateId, name: 'date', value: group.date, min: group.min, max: '9999-12-31', invalid: group.dateError, describedBy: au.describedBy({ id: group.dateId, error: group.dateError }) }) }}
    {%- endcall -%}
  {%- endset -%}
  {%- set options = [] -%}
  {%- for o in group.options -%}
    {%- set options = (options.push({ value: o.value, text: o.text, hint: o.hint, checked: o.checked, conditionalHtml: dateField if o.value == 'custom' }), options) -%}
  {%- endfor -%}
  {{ au.RadioGroup({ id: group.id, name: 'expiry', label: 'Expires', hint: 'The token stops working at the end of that day, UK time.', error: group.error, options: options }) }}
{%- endmacro %}

{#- A dialog's two buttons: the way out, then what it does. -#}
{% macro dialogActions(d, submitText) -%}
  {{ au.Button({ text: 'Cancel', href: d.cancelHref, attributes: { 'data-au-close': true } }) }}{{ au.Button({ text: submitText, variant: 'primary', type: 'submit', form: d.formId, loadingOnSubmit: true, testId: d.id ~ '-submit' }) }}
{%- endmacro %}
