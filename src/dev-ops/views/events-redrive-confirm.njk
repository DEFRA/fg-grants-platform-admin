{% extends 'layouts/page.njk' %}

{% from "icon/macro.njk" import icon %}
{% from "status-badge/macro.njk" import statusBadge %}

{# The same two registers the inspect page reads in, spelled as literals here
   because Tailwind scans this file's text for candidates and never sees a
   class assembled in TypeScript. #}
{% set sectionHeading = "text-[11px] font-semibold tracking-wide uppercase text-base-content/45" %}
{% set card = "overflow-hidden rounded-box border border-base-300 bg-base-100" %}

{# Stage one of the bulk redrive: what is about to happen, and nothing else.

   The whole safety of a batch write is here. An operator ticking boxes down a
   scrolling table of near-identical rows cannot see what they have selected,
   and `8 events selected` is not an answer — a list of types, references and
   routes is. Nothing on this page writes anything; the only control that does
   is the button at the bottom, and it posts to a second address. #}
{% block content %}
  <a class="text-[12px] text-base-content/55 hover:underline" href="{{ backHref }}" data-testid="events-batch-back">← Events</a>

  <header class="mt-3 mb-4">
    <h1 class="text-xl font-semibold" data-testid="events-batch-title">Redrive {{ count }} event{{ "" if count == 1 else "s" }}?</h1>
    <p class="mt-0.5 text-[13px] text-base-content/60" data-testid="events-batch-subtitle">Each will be put back on the queue and retried by the poller. This action is audited.</p>
  </header>

  {% if count %}
    <section class="{{ card }} mb-4" data-testid="events-batch-card">
      <div class="overflow-x-auto">
        <table class="w-full text-[12px]" data-testid="events-batch-table">
          <thead>
            <tr class="border-b border-base-300">
              <th class="{{ sectionHeading }} px-4 py-1.5 text-left">Event</th>
              <th class="{{ sectionHeading }} px-4 py-1.5 text-left">Status</th>
              <th class="{{ sectionHeading }} px-4 py-1.5 text-left">Queue</th>
            </tr>
          </thead>
          <tbody>
            {% for row in rows %}
              <tr class="border-t border-base-300/55" data-testid="events-batch-row">
                <td class="px-4 py-1.5">
                  {# The id leads, as it does on the list: it is the one
                     identifier every row has, and a row we could not read has
                     nothing but it. The type follows underneath when there is
                     one. #}
                  <a class="font-mono text-[13px] font-semibold break-all hover:underline" href="{{ row.href }}" data-testid="events-batch-id">{{ row.eventId }}</a>
                  {% if row.type %}
                    <div class="text-[11px] text-base-content/60" data-testid="events-batch-type">{{ row.type }}</div>
                  {% endif %}
                </td>
                <td class="px-4 py-1.5 whitespace-nowrap">
                  {{ statusBadge({ status: row.status, label: row.statusLabel, role: row.statusRole, retrying: row.statusRetrying }) }}
                  {# A row we could not read is still redriven — the write is by
                     address — so it is listed and says so, rather than being
                     dropped from a page an operator is reading precisely to
                     check what they selected. #}
                  {% if not row.found %}
                    <div class="mt-px text-[10.5px] text-base-content/45" data-testid="events-batch-unknown">could not be read</div>
                  {% endif %}
                </td>
                <td class="px-4 py-1.5 text-[12px] text-base-content/75" data-testid="events-batch-queue">{{ row.source }} <span class="text-base-content/30" aria-hidden="true">·</span> {{ row.queue }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    {# The one control that writes. Every id is restated as a hidden field
       because a form submits its own controls and nothing else, and the page
       that got here carried them in a form of its own. #}
    <div class="flex items-center gap-2">
      <form method="post" action="{{ action }}" data-testid="events-batch-confirm-form">
        <input type="hidden" name="from" value="{{ from }}" data-testid="events-batch-confirm-from">
        {% for row in rows %}
          <input type="hidden" name="id" value="{{ row.value }}" data-testid="events-batch-confirm-id">
        {% endfor %}
        <button class="btn btn-sm btn-error" type="submit" data-testid="events-batch-confirm">Redrive {{ count }} event{{ "" if count == 1 else "s" }}</button>
      </form>
      <a class="btn btn-sm btn-ghost font-normal" href="{{ backHref }}" data-testid="events-batch-cancel">Cancel</a>
    </div>
  {% else %}
    {# Nothing survived the address check, which in practice means a form
       nobody filled in. It is a page, not an error: the way back is the only
       thing worth saying. #}
    <div role="alert" class="alert alert-warning text-[13px]" data-testid="events-batch-empty">
      {{ icon({ name: 'exclamation-triangle', class: 'h-4 w-4 shrink-0' }) }}
      <span>No events were selected. Nothing has been redriven.</span>
    </div>
  {% endif %}
{% endblock %}
