{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">Grant code {{ code }}</h1>

      {% if saved %}
        {{ govukNotificationBanner({
          type: "success",
          text: saved,
          attributes: { "data-testid": "allow-list-saved" }
        }) }}
      {% endif %}

      {% if errorSummary | length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary,
          attributes: { "data-allow-list-errors": "" }
        }) }}
      {% endif %}

      <div class="govuk-tabs" data-module="govuk-tabs" data-active-tab="{{ activeTab }}">
        <h2 class="govuk-tabs__title">Contents</h2>
        <ul class="govuk-tabs__list">
          <li class="govuk-tabs__list-item{% if activeTab == 'grant-setup' %} govuk-tabs__list-item--selected{% endif %}">
            <a class="govuk-tabs__tab" href="#grant-setup">Grant setup</a>
          </li>
          <li class="govuk-tabs__list-item{% if activeTab == 'who-can-apply' %} govuk-tabs__list-item--selected{% endif %}">
            <a class="govuk-tabs__tab" href="#who-can-apply">Who can apply</a>
          </li>
          {% if referenceData | length %}
            <li class="govuk-tabs__list-item{% if activeTab == 'reference-data' %} govuk-tabs__list-item--selected{% endif %}">
              <a class="govuk-tabs__tab" href="#reference-data">Reference data</a>
            </li>
          {% endif %}
        </ul>

        <div class="govuk-tabs__panel" id="grant-setup">
          <form method="post" action="{{ settingsFormAction }}" novalidate>
            {{ govukRadios({
              name: "status",
              idPrefix: "grant-status",
              errorMessage: { text: settingsError } if settingsError else none,
              fieldset: { legend: { text: "Is this grant open or closed?", classes: "govuk-fieldset__legend--m" } },
              hint: { text: "Changes take effect when you save." },
              items: [
                { value: "open", text: "Open", checked: settings.open === true },
                { value: "closed", text: "Closed", checked: settings.open === false }
              ]
            }) }}
            {{ govukButton({ text: "Save changes" }) }}
          </form>
        </div>

        <div class="govuk-tabs__panel" id="who-can-apply">
          <h2 class="govuk-heading-l">Who can apply</h2>
          <p class="govuk-body" data-testid="allow-list-explanation">Leave both boxes empty and anyone can apply. Otherwise, only applicants with an SBI or CRN listed here can apply.</p>

          <form method="post" action="{{ formAction }}" novalidate>
            {% for field in [form.sbi, form.crn] %}
              {{ govukTextarea({
                id: field.key,
                name: field.key,
                value: field.value,
                rows: 10,
                classes: "app-allow-list-input",
                label: { text: field.label, classes: "govuk-label--s" },
                hint: { text: field.hint },
                errorMessage: { text: field.error } if field.error else none,
                attributes: {
                  "data-allow-list-input": "",
                  "data-count-target": field.key + "-hint"
                }
              }) }}
            {% endfor %}

            <div class="govuk-button-group">
              {{ govukButton({ text: "Save allow list" }) }}
              {{ govukButton({
                text: "Reset changes",
                href: resetHref,
                classes: "govuk-button--secondary",
                attributes: { "data-testid": "allow-list-reset" }
              }) }}
            </div>
          </form>
        </div>

        {% if referenceData | length %}
          <div class="govuk-tabs__panel" id="reference-data">
            <h2 class="govuk-heading-l">Reference data</h2>
            <p class="govuk-body">The lists this grant's current version uses. You can change a list held in GAS here.</p>

            {% for set in referenceData %}
              <div class="govuk-!-margin-bottom-8" data-testid="reference-data-set" data-name="{{ set.name }}">
                <h3 class="govuk-heading-m govuk-!-margin-bottom-1">{{ set.name }}</h3>
                <p class="govuk-body-s govuk-!-margin-bottom-3" data-testid="reference-data-source">
                  {{ set.label }}{% if set.note %}. {{ set.note }}{% endif %}
                </p>

                {% if set.viewHref %}
                  <p class="govuk-body">
                    <a class="govuk-link" href="{{ set.viewHref }}" data-testid="reference-data-view">View current items</a>
                  </p>
                {% elif set.rows | length %}
                  <table class="govuk-table" data-testid="reference-data-items">
                    <thead class="govuk-table__head">
                      <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">Code</th>
                        <th scope="col" class="govuk-table__header">Description</th>
                        {% if set.editable %}
                          <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
                        {% endif %}
                      </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                      {% for row in set.rows %}
                        <tr class="govuk-table__row" data-testid="reference-data-item">
                          <td class="govuk-table__cell">{{ row.code }}</td>
                          <td class="govuk-table__cell">{{ row.description }}</td>
                          {% if set.editable %}
                            <td class="govuk-table__cell govuk-table__cell--numeric">
                              <a class="govuk-link" href="{{ row.changeHref }}">Change<span class="govuk-visually-hidden"> {{ row.code }}</span></a>
                              <a class="govuk-link govuk-!-margin-left-3" href="{{ row.removeHref }}">Remove<span class="govuk-visually-hidden"> {{ row.code }}</span></a>
                            </td>
                          {% endif %}
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                {% else %}
                  <p class="govuk-body" data-testid="reference-data-empty">There are no items yet.</p>
                {% endif %}

                {% if set.addHref %}
                  {{ govukButton({
                    text: "Add item",
                    href: set.addHref,
                    classes: "govuk-button--secondary",
                    attributes: { "data-testid": "reference-data-add" }
                  }) }}
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
