{% extends 'layouts/page.njk' %}

{% from "application-header/macro.njk" import appApplicationHeader %}
{% from "available-entitlements/macro.njk" import appAvailableEntitlements %}
{% from "awaiting-claims/macro.njk" import appAwaitingClaims %}
{% from "claimed-claims/macro.njk" import appClaimedClaims %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}
  {{ appApplicationHeader(header) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      {{ govukServiceNavigation({
        navigation: tabs,
        navigationLabel: "Application sections",
        classes: "app-section-navigation govuk-!-margin-top-5 govuk-!-margin-bottom-8"
      }) }}

      {{ appAvailableEntitlements({ entitlements: entitlements }) }}

      {{ appAwaitingClaims({
        awaitingClaims: awaitingClaims,
        changingEntitlementId: changingEntitlementId
      }) }}

      <div class="app-card govuk-!-margin-bottom-6" id="change-entitlement">
        <h2 class="govuk-heading-m" data-testid="claimable-heading">Change claimable item</h2>

        {% if claimableTemplate.description %}
          <p class="govuk-body" data-testid="claimable-template-description">
            {{ claimableTemplate.description }}
          </p>
        {% endif %}

        {% if errorSummary | length %}
          {{ govukErrorSummary({
            titleText: "There is a problem",
            errorList: errorSummary,
            attributes: { "data-testid": "claimable-error-summary" }
          }) }}
        {% endif %}

        <form method="post" novalidate>
          {% for field in formFields %}
            {{ govukInput({
              id: field.key,
              name: field.key,
              value: field.value,
              type: field.type,
              label: { text: field.label, classes: "govuk-label--s" },
              classes: "govuk-input--width-10",
              inputmode: field.inputmode,
              spellcheck: false if field.inputmode else none,
              suffix: { text: field.suffix } if field.suffix else none,
              errorMessage: { text: field.error } if field.error else none,
              attributes: { "data-testid": "claimable-field-" + field.key }
            }) }}
          {% endfor %}

          {% if claimableTemplate.help %}
            {% set helpHtml %}
              {% for block in claimableTemplate.help.content %}
                {% if block.items %}
                  <ul class="govuk-list govuk-list--bullet">
                    {% for item in block.items %}
                      <li>{{ item }}</li>
                    {% endfor %}
                  </ul>
                {% else %}
                  <p class="govuk-body">{{ block.text }}</p>
                {% endif %}
              {% endfor %}
            {% endset %}

            {{ govukDetails({
              summaryText: claimableTemplate.help.summary,
              html: helpHtml,
              attributes: { "data-testid": "claimable-help" }
            }) }}
          {% endif %}

          <div class="govuk-button-group">
            {{ govukButton({
              text: "Save changes",
              attributes: { "data-testid": "claimable-submit" }
            }) }}

            <a class="govuk-link" href="{{ claimsHref }}" data-testid="claimable-cancel">Cancel</a>
          </div>
        </form>
      </div>

      {{ appClaimedClaims({ claimed: claimed }) }}

    </div>
  </div>
{% endblock %}
