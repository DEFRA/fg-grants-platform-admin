{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}

{% block content %}
  {{ govukBackLink({ text: "Back", href: backHref }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errorSummary | length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errorSummary,
          attributes: { "data-testid": "reference-data-errors" }
        }) }}
      {% endif %}

      <span class="govuk-caption-l">Reference data {{ name }}</span>
      <h1 class="govuk-heading-l">{{ heading }}</h1>

      <form method="post" novalidate>
        {% if codeEditable %}
          {{ govukInput({
            id: "code",
            name: "code",
            value: form.code.value,
            classes: "govuk-input--width-20",
            spellcheck: false,
            label: { text: "Code", classes: "govuk-label--s" },
            hint: { text: "Letters, numbers, hyphens and underscores. You cannot change it later." },
            errorMessage: { text: form.code.error } if form.code.error else none
          }) }}
        {% else %}
          {{ govukSummaryList({
            rows: [{ key: { text: "Code" }, value: { text: form.code.value } }]
          }) }}
        {% endif %}

        {{ govukInput({
          id: "description",
          name: "description",
          value: form.description.value,
          label: { text: "Description", classes: "govuk-label--s" },
          errorMessage: { text: form.description.error } if form.description.error else none
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({ text: submitText, attributes: { "data-testid": "reference-data-submit" } }) }}
          <a class="govuk-link" href="{{ backHref }}">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
