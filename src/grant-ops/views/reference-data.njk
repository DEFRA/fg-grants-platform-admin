{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% block content %}
  {{ govukBackLink({ text: "Back to reference data", href: backHref }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">Grant code {{ code }}</span>
      <h1 class="govuk-heading-l" data-testid="reference-data-heading">{{ name }}</h1>

      {% if unavailable %}
        <p class="govuk-body" data-testid="reference-data-unavailable">{{ unavailable }}</p>
      {% else %}
        <p class="govuk-body" data-testid="reference-data-source">{{ label }}{% if note %}. {{ note }}{% endif %}</p>

        {% if rows | length %}
          <table class="govuk-table" data-testid="reference-data-items">
            <thead class="govuk-table__head">
              <tr class="govuk-table__row">
                <th scope="col" class="govuk-table__header">Code</th>
                <th scope="col" class="govuk-table__header">Description</th>
              </tr>
            </thead>
            <tbody class="govuk-table__body">
              {% for row in rows %}
                <tr class="govuk-table__row" data-testid="reference-data-item">
                  <td class="govuk-table__cell">{{ row.code }}</td>
                  <td class="govuk-table__cell">{{ row.description }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="govuk-body" data-testid="reference-data-empty">There are no items.</p>
        {% endif %}
      {% endif %}
    </div>
  </div>
{% endblock %}
