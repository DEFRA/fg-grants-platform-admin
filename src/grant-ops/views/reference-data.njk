{% extends 'layouts/page.njk' %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}
  {{ govukBackLink({ text: "Back to grant code " + code, href: adminHref }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">Grant code {{ code }}</span>
      <h1 class="govuk-heading-l" data-testid="reference-data-heading">Reference data {{ name }}</h1>

      {% if saved %}
        {{ govukNotificationBanner({
          type: "success",
          text: saved,
          attributes: { "data-testid": "reference-data-saved" }
        }) }}
      {% endif %}

      <p class="govuk-body">GAS holds these items, so a change takes effect straight away, without a new grant version.</p>

      {% if rows | length %}
        <table class="govuk-table" data-testid="reference-data-items">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Code</th>
              <th scope="col" class="govuk-table__header">Description</th>
              <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">Actions</span></th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for row in rows %}
              <tr class="govuk-table__row" data-testid="reference-data-item">
                <td class="govuk-table__cell">{{ row.code }}</td>
                <td class="govuk-table__cell">{{ row.description }}</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">
                  <a class="govuk-link" href="{{ row.changeHref }}">Change<span class="govuk-visually-hidden"> {{ row.code }}</span></a>
                  <a class="govuk-link govuk-!-margin-left-3" href="{{ row.removeHref }}">Remove<span class="govuk-visually-hidden"> {{ row.code }}</span></a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% else %}
        <p class="govuk-body" data-testid="reference-data-empty">There are no items yet.</p>
      {% endif %}

      {{ govukButton({
        text: "Add item",
        href: newItemHref,
        attributes: { "data-testid": "reference-data-add" }
      }) }}
    </div>
  </div>
{% endblock %}
